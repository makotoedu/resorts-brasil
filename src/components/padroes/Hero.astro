---
import Imagem from '../primitivos/Imagem.astro';
import Titulo from '../primitivos/Titulo.astro';

/**
 * Hero — a foto de abertura, com zoom lento e legendas em cascata.
 *
 * Substitui o `.inspiro-slider` da home, que so tem UM slide: nao ha carrossel,
 * ha uma foto com legenda. O tema montava isso com um plugin de slider, um
 * plugin de animacao e um bloco de JavaScript que criava a camada de zoom em
 * tempo de execucao.
 *
 *   <Hero
 *     imagem="/images/hero/pexels-775687.jpg"
 *     alt=""
 *     sobretitulo="Em todo o Brasil"
 *     titulo="Viva a experiencia de um Resort"
 *     prioridade
 *   >
 *     <Botao href="/associados" variante="destaque" tamanho="lg">Conheca os resorts</Botao>
 *   </Hero>
 *
 * MEDIDO (scripts/medir-padroes.mjs): altura de 72% da janela nos tres
 * viewports, cantos de 11,48px, legendas centralizadas em branco, sobretitulo
 * de 12px / 500 com 20px de folga, titulo de 40px subindo a 60px no desktop.
 *
 * TRES ARMADILHAS DO TEMA MORREM AQUI, e as tres sao a mesma:
 * plugin removido, CSS que dependia dele silenciosamente inerte.
 *
 *   1. `.kenburns-bg` tinha `z-index: -1` e so aparecia se o `.slide` fosse um
 *      contexto de empilhamento — quem criava isso era o flickity, posicionando
 *      o slide. Sem ele a camada foi para tras do fundo do proprio slide e o
 *      zoom PAROU DE ACONTECER, sem mudar altura e sem quebrar nenhum teste.
 *      Aqui a foto e um filho posicionado por `inset: 0`, na ordem do
 *      documento: nao ha z-index negativo e nao ha nada para empilhar errado.
 *   2. A camada era criada por JavaScript, lendo a URL de um `style=` inline —
 *      o que impedia `srcset` e `lazy` na maior imagem da pagina. Aqui e um
 *      <Imagem> com o pipeline da Etapa 2.
 *   3. As legendas nasciam com `opacity: 0` no CSS e so o JavaScript devolvia
 *      `opacity: 1`. E exatamente a forma da regressao que deixou seis paginas
 *      deste projeto INVISIVEIS. Aqui a cascata e uma animacao de CSS que parte
 *      do quadro transparente com `animation-fill-mode: both`: se a animacao
 *      nao rodar, por qualquer motivo, o texto fica visivel. A falha aponta
 *      para o lado seguro, e isso e a escolha, nao o acaso.
 */
interface Props {
  /** Caminho publico (`/images/...`). */
  imagem: string;
  /** Vazio marca foto decorativa — o caso comum, porque o titulo diz tudo. */
  alt?: string;
  /** A linha curta acima do titulo (`.strong` no tema). */
  sobretitulo?: string;
  titulo: string;
  /** Nivel do heading. O hero costuma ser o h1 da pagina. */
  nivel?: 1 | 2 | 3 | 4 | 5 | 6;
  /** `meia` sao os 72% da janela medidos; `cheia` ocupa a janela inteira. */
  altura?: 'meia' | 'cheia';
  arredondado?: boolean;
  /** Padrao `true`: o hero e a primeira imagem visivel, e nao pode ser lazy. */
  prioridade?: boolean;
  /** O `sizes` da foto. O hero da home fica dentro do container de 1500px. */
  tamanhos?: string;
  class?: string;
}

const {
  imagem,
  alt = '',
  sobretitulo,
  titulo,
  nivel = 1,
  altura = 'meia',
  arredondado = true,
  prioridade = true,
  tamanhos = '(min-width: 96rem) 1500px, 100vw',
  class: classe,
} = Astro.props;
---

<section
  class:list={[
    'hero',
    altura === 'cheia' && 'cheia',
    arredondado && 'arredondado',
    /* A marca que o base.css procura para trocar a cor do contorno de foco:
       sobre foto o azul do foco desaparece. */
    'superficie-inversa',
    classe,
  ]}
>
  <Imagem
    src={imagem}
    alt={alt}
    escala="largura-total"
    tamanhos={tamanhos}
    ajuste="cobrir"
    prioridade={prioridade}
    class="foto"
  />
  <span class="veu" aria-hidden="true"></span>
  <div class="legendas">
    {sobretitulo && <p class="sobretitulo surge">{sobretitulo}</p>}
    <Titulo nivel={nivel} papel="pagina" cor="inverso" alinhamento="centro" class="titulo surge">
      {titulo}
    </Titulo>
    <div class="acao surge">
      <slot />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    /* MEDIDO: 608px em 844, 737px em 1024 e 648px em 900 — 72% da janela nos
       tres. `svh` onde existe, porque em celular a barra do navegador some e
       `vh` deixa o hero saltar durante a rolagem. */
    min-height: 72vh;
    padding: var(--spacing-secao-md) 1.5rem;
    /* A foto e o veu sao filhos posicionados; sem isto eles vazam dos cantos. */
    overflow: hidden;
    color: var(--color-texto-inverso);
  }

  @supports (height: 1svh) {
    .hero {
      min-height: 72svh;
    }

    .cheia {
      min-height: 100svh;
    }
  }

  .cheia {
    min-height: 100vh;
  }

  .arredondado {
    border-radius: var(--radius-md);
  }

  .hero :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    /*
     * O zoom lento, que no tema era uma camada extra criada por JavaScript.
     * 20s e `alternate` para a foto voltar em vez de reiniciar com um corte.
     * O base.css ja neutraliza animacao inteira sob prefers-reduced-motion.
     */
    animation: zoom 20s ease-in-out infinite alternate;
    transform-origin: center;
  }

  @keyframes zoom {
    from {
      transform: scale(1);
    }
    to {
      transform: scale(1.12);
    }
  }

  /*
   * Mesmo gradiente da <ChamadaAcao>, e pelo mesmo motivo — ver a nota de
   * `--color-veu-forte` no tokens.css.
   *
   * Aqui o conteudo e centrado verticalmente, entao a transicao comeca antes:
   * em 30% o sobretitulo, o titulo e o botao ja estao inteiros na parte forte.
   * O topo fica leve, que e onde a foto tem de continuar sendo foto.
   */
  .veu {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      var(--color-veu) 0%,
      var(--color-veu-forte) 30%,
      var(--color-veu-forte) 100%
    );
  }

  .legendas {
    position: relative;
    max-width: var(--container-conteudo);
    text-align: center;
  }

  /* MEDIDO: 12px / 500, 20px ate o titulo. */
  .sobretitulo {
    color: inherit;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    letter-spacing: 1px;
    text-transform: uppercase;
    margin-block: 0 1.25rem;
  }

  /* MEDIDO: 30px entre o titulo e o botao. */
  .hero :global(.titulo) {
    margin-block: 0 1.875rem;
  }

  /*
   * A cascata. O tema fazia isto em JavaScript, com 1s de espera e 350ms entre
   * um elemento e o seguinte; os mesmos numeros estao aqui.
   *
   * `both` e a parte que importa: o quadro inicial vale DURANTE o atraso, e o
   * final permanece depois. Se a animacao nao rodar, o elemento fica com o
   * estilo normal — visivel. O tema fazia o contrario, e foi assim que seis
   * paginas ficaram sem conteudo quando o plugin saiu.
   */
  .surge {
    animation: surgir 600ms ease-out both;
  }

  .sobretitulo.surge {
    animation-delay: 1s;
  }

  .hero :global(.titulo.surge) {
    animation-delay: 1.35s;
  }

  .acao.surge {
    animation-delay: 1.7s;
  }

  @keyframes surgir {
    from {
      opacity: 0;
      transform: translateY(1.25rem);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
