---
import type { HTMLAttributes } from 'astro/types';
import Icone from '../primitivos/Icone.astro';

/**
 * LinkAcao — o `.item-link` do tema: "Saiba mais >".
 *
 * Nao e botao. E o link discreto que fecha um cartao ou uma chamada, e aparece
 * dentro de tres padroes diferentes (chamada de acao, cartao de publicacao,
 * cartao de modalidade). Sem ele, esses tres repetiriam a mesma cadeia de
 * marcacao e o mesmo hover — e o hover foi justamente o que este projeto
 * aprendeu a nao inventar.
 *
 *   <LinkAcao href="/apoie">Saiba mais</LinkAcao>
 *   <LinkAcao href="https://..." externo seta={false}>Leia agora</LinkAcao>
 *
 * MEDIDO em `.item-link` (scripts/medir-padroes.mjs): 14px, cor do texto do
 * site (navy) em repouso e cor de acao no hover. Nao e azul em repouso — quem
 * lesse o CSS suporia que sim, porque `a` nu e azul; aqui o `.item-link` vence.
 *
 * DUAS PROPRIEDADES FALTAVAM DESDE A ETAPA 3, e a causa e instrutiva: o
 * `medir-padroes.mjs` mede as propriedades que a lista do GRUPO pede, e a lista
 * de `chamadaAcao` nao tinha `textTransform` nem `letterSpacing`. O `.item-link`
 * do tema e `text-transform: uppercase !important` com `letter-spacing: 1px` —
 * "SAIBA MAIS", e nao "Saiba mais" —, e nada disso apareceu no resumo porque
 * ninguem perguntou. Medir sem pedir a propriedade certa e nao medir.
 *
 * Apareceu na Etapa 9, comparando o cartao da home com uma captura do tema, e a
 * correcao alcanca as seis paginas ja migradas que usam este componente. Os dois
 * campos entraram na lista do medidor, para a omissao nao se repetir.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'class' | 'href'> {
  href: string;
  /** Abre em outra aba com `rel` seguro. */
  externo?: boolean;
  /** O chevron depois do texto. O tema o punha em 5 dos 6 links da home. */
  seta?: boolean;
  cor?: 'padrao' | 'inverso';
  /**
   * O link cobre o cartao em que esta: o padrao do link esticado. O `::after`
   * que ja estendia o alvo de toque passa a cobrir o ancestral posicionado mais
   * proximo -- o <Cartao interativo> ou a <ChamadaAcao interativo>. Mora aqui,
   * e nao no cartao, porque so quem renderiza o `<a>` alcanca o `::after` dele
   * (armadilha 1 do CLAUDE.md).
   */
  esticado?: boolean;
  class?: string;
}

const {
  href,
  externo = false,
  seta = true,
  cor = 'padrao',
  esticado = false,
  class: classe,
  ...resto
} = Astro.props;
---

<a
  class:list={['link-acao', 'voz-acao', cor === 'inverso' && 'inverso', esticado && 'esticado', classe]}
  href={href}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener noreferrer' : undefined}
  {...resto}
>
  <slot />
  {/* aria-hidden: o chevron repete o que o texto ja diz. */}
  {seta && <Icone nome="chevron-right" tamanho="sm" class="seta" />}
</a>

<style>
  .link-acao {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    color: var(--color-texto);
    /* A caixa alta medida no `.item-link` do tema (ver a nota do cabecalho)
       ficou na revisao de design e saiu no Soft UI: a voz e a `.voz-acao`, a
       mesma do botao, e o "Saiba mais" volta a ser escrito como se le. */
    text-decoration: none;
    transition: color var(--duracao) var(--ease-chegada);
  }

  /* Medido com o mouse em cima. */
  .link-acao:hover {
    color: var(--color-acao-primaria);
  }

  /*
   * Sobre foto e sobre superficie escura. O base.css devolve `color: inherit` e
   * sublinhado a todo `a[href]` dentro de `.superficie-inversa`, porque la o
   * azul do link some; aqui o mesmo problema aparece sobre a foto, onde nem a
   * marca de secao existe. A seta desliza no lugar do sublinhado.
   */
  .inverso {
    color: var(--color-texto-inverso);
  }

  /*
   * O HOVER DESTA VARIANTE NAO EXISTIA. A cor fica branca de proposito -- o
   * azul de acao some sobre a foto --, e a resposta ao mouse era a seta
   * deslizando. So que a seta nunca deslizou: a regra estava escrita `.seta`,
   * com escopo, e o `<svg>` nasce dentro do <Icone>, que nao recebe o atributo
   * de escopo deste arquivo (armadilha 1 do CLAUDE.md). Repouso e hover eram o
   * mesmo pixel nos seis cartoes da home e nos de modalidade. Achado A14 da
   * revisao de design.
   *
   * Agora sao dois sinais: o sublinhado, que e o que o base.css ja da a link
   * sobre superficie escura, e a seta.
   */
  .inverso:hover {
    color: var(--color-texto-inverso);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }

  /* `:global` pelo motivo acima: o `<svg>` e do <Icone>. */
  .link-acao :global(.seta) {
    transition: transform var(--duracao) var(--ease-chegada);
  }

  .link-acao:hover :global(.seta) {
    transform: translateX(0.25rem);
  }

  /*
   * A AREA DE TOQUE. O link mede 20px de altura -- a linha do rotulo --, e no
   * celular eram 23px num controle que se toca com o dedo. O pseudo-elemento
   * estende o alvo a 44px sem mudar um pixel do desenho nem empurrar o
   * vizinho.
   *
   * SO NA VERTICAL, e isso e medido: com 8px para cada lado tambem, o alvo
   * entrava na `scrollWidth` de quem contem o link, e a varredura de geometria
   * o leu como texto vazando da caixa -- na celula do catalogo, 112px de
   * conteudo em 104. Largura o link ja tem; o que faltava era altura.
   */
  .link-acao::after {
    content: '';
    position: absolute;
    inset: -0.75rem 0;
  }

  /*
   * ESTICADO, o mesmo `::after` cobre o cartao. Sem `position` no link, o
   * pseudo-elemento se ancora no ancestral posicionado -- o cartao -- e o
   * `inset: 0` o cobre de borda a borda. Passar o mouse em qualquer ponto do
   * cartao e passar sobre o link, e por isso a seta desliza de onde quer que
   * o mouse esteja.
   */
  .esticado {
    position: static;
  }

  .esticado::after {
    inset: 0;
  }
</style>
