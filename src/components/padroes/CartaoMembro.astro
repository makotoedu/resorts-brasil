---
import Cartao from '../primitivos/Cartao.astro';
import Imagem from '../primitivos/Imagem.astro';
import Titulo from '../primitivos/Titulo.astro';
import Texto from '../primitivos/Texto.astro';
import Icone from '../primitivos/Icone.astro';

/**
 * CartaoMembro — foto, nome, cargo e o perfil no LinkedIn.
 *
 * O PADRAO MAIS REPETIDO DO SITE: 124 usos do `.team-member`, entre diretoria e
 * conselho consultivo nos tres idiomas. Cada um deles e hoje uma cadeia de seis
 * `<div>` copiada a mao, e e por isso que este e o primeiro da Etapa 3.
 *
 *   <CartaoMembro nome="..." cargo="Presidente" foto="/images/diretoria/x.jpg" />
 *
 * OS VALORES SAO MEDIDOS, com `node scripts/medir-padroes.mjs`:
 *
 *   cartao   fundo branco, cantos arredondados, conteudo centralizado
 *   foto     quadrada (1/1 em todos os viewports), 20px ate o nome
 *   nome     16px / 500
 *   cargo    13px / 400
 *   social   circulo de 32px, borda de 1px, glifo de 16px
 *            hover: fundo cinza claro e cor de acao — medido com o mouse em cima
 *
 * TRES DELTAS DELIBERADOS, todos anotados em docs/deltas-visuais.md:
 *
 *   1. O nome sobe de 16 para 18px (`--text-md`). 16px nao esta na escala, e
 *      criar um degrau para um cartao inverteria a relacao entre sistema e
 *      excecao — o mesmo raciocinio que o <Botao> ja aplicou no `sm`.
 *   2. O cargo troca o #1e2022 (quase preto) pelo cinza de paragrafo. Ele e um
 *      rotulo secundario e estava desenhado com mais peso visual que o nome.
 *   3. O cartao usa o raio do sistema no lugar dos 4px do tema, que nao batiam
 *      nem com os 5,88px da propria foto logo abaixo.
 *
 * NO SOFT UI A CAIXA E O <Cartao>: branco com fio e sombra de repouso sobre o
 * `clara` da diretoria, carvao com fio claro no e-book. Ele nao e interativo
 * -- o unico destino e o LinkedIn, e o cartao inteiro levando ao perfil seria
 * prometer mais do que o cartao e. A marca `inversa` mora na `.descricao`, e
 * nao na raiz: a raiz agora e do <Cartao>, e os seletores escopados daqui so
 * alcancam elemento deste template (armadilha 1 do CLAUDE.md).
 */
interface Props {
  nome: string;
  cargo: string;
  /** Caminho publico (`/images/...`) — resolvido por src/imagens.ts. */
  foto: string;
  /** Ausente: o cartao mantem o simbolo, sem link. Ver a nota abaixo. */
  linkedin?: string;
  /**
   * A linha extra entre o nome e o cargo. Na Etapa 10 ela e o CAPITULO que a
   * pessoa assina no e-book, e e o unico lugar do site que a usa — mas o eixo
   * "uma linha de destaque acima do cargo" e do cartao, nao do ebook.
   */
  destaque?: string;
  /**
   * A superficie sob o cartao. `clara` e a diretoria; `inversa` sao os 41
   * autores do e-book, medidos com o carvao do proprio ebook.
   *
   * Repare que isto e uma PROP e nao um componente novo: o `.team-member` do
   * tema e o mesmo nos dois lugares, e sao 124 usos claros mais 41 escuros. Um
   * <CartaoAutor> separado duplicaria a foto quadrada, o circulo do LinkedIn e
   * os dois hovers — que e exatamente o que este componente existe para nao
   * deixar acontecer.
   */
  superficie?: 'clara' | 'inversa';
  /**
   * Nivel do heading do nome. E prop porque depende de onde a grade esta na
   * pagina, e nao do desenho do cartao — que e exatamente a separacao que o
   * <Titulo> existe para manter.
   */
  nivel?: 1 | 2 | 3 | 4 | 5 | 6;
  /**
   * O `sizes` da foto. O padrao serve a grade de 6 colunas da diretoria; uma
   * grade mais larga deve dizer a sua largura, senao o navegador baixa a maior
   * variante para uma caixa pequena.
   */
  tamanhos?: string;
  class?: string;
}

const {
  nome,
  cargo,
  foto,
  linkedin,
  destaque,
  superficie = 'clara',
  nivel = 3,
  tamanhos = '(min-width: 64rem) 15rem, (min-width: 30rem) 33vw, 50vw',
  class: classe,
} = Astro.props;

const inversa = superficie === 'inversa';

/*
 * Sem perfil, o simbolo continua no lugar mas deixa de ser link.
 *
 * O markup original punha `href="#"`: um link visivel, focavel e sem destino —
 * o teclado parava nele e nao acontecia nada. O GradeMembros do tema ja tinha
 * corrigido para um `<a>` sem href; aqui nem isso, porque `<a>` sem href e um
 * elemento sem papel. Some-lo por completo tambem nao serve: mudaria a altura
 * de um cartao no meio da grade.
 */
const Marca = linkedin ? 'a' : 'span';
---

<Cartao superficie={inversa ? 'inversa' : 'base'} recuo="nenhum" class={classe}>
  {/* A caixa em volta da foto existe so para o seletor alcancar o `<img>` do
      <Imagem> a partir de um elemento deste template. */}
  <div class="midia">
    <Imagem
      src={foto}
      alt={nome}
      largura={340}
      altura={340}
      proporcao="quadrada"
      ajuste="cobrir"
      tamanhos={tamanhos}
      class="foto"
    />
  </div>
  <div class:list={['descricao', inversa && 'inversa']}>
    <Titulo
      nivel={nivel}
      papel="cartao"
      cor={inversa ? 'inverso' : 'padrao'}
      class="nome">{nome}</Titulo
    >
    {destaque && <p class="destaque">{destaque}</p>}
    <Texto papel="apoio" cor={inversa ? 'sutil-inverso' : 'paragrafo'} semMargem>{cargo}</Texto>
    <Marca
      class="social"
      href={linkedin || undefined}
      target={linkedin ? '_blank' : undefined}
      rel={linkedin ? 'noopener noreferrer' : undefined}
      aria-label={linkedin ? `${nome} no LinkedIn` : undefined}
    >
      <Icone nome="linkedin" tamanho="sm" />
    </Marca>
  </div>
</Cartao>

<style>
  /* Fundo, raio, fio, sombra e o corte da foto nos cantos sao do <Cartao>. */

  /* A foto e quadrada nos tres viewports — medido, nao arbitrado. O
     <Imagem proporcao="quadrada"> ja da a caixa; aqui so a largura. */
  .midia :global(.foto) {
    width: 100%;
    display: block;
  }

  .descricao {
    /* 20px medidos entre a foto e o nome. */
    padding: 1.25rem 0.5rem 1.5rem;
    text-align: center;
  }

  .descricao :global(.nome) {
    margin-block: 0 0.25rem;
  }

  /*
   * Circulo de 32px, medido. O glifo de 16px vem do <Icone tamanho="sm">, que
   * e o mesmo tamanho medido no rodape.
   *
   * O SOFT UI TROCOU A BORDA PELO FUNDO. O fio de 1px em volta de um glifo de
   * 16px lia como campo de formulario vazio; o fundo tingido le como um
   * controle com corpo, que e a linguagem do resto do cartao. O hover preenche
   * com a cor de acao.
   */
  .social {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    margin-top: 0.75rem;
    background-color: var(--color-estado-hover);
    border-radius: var(--radius-full);
    color: var(--color-texto);
    transition:
      background-color var(--duracao) var(--ease-chegada),
      color var(--duracao) var(--ease-chegada);
  }

  /*
   * O ALVO DE TOQUE, 44px, sem mudar o desenho de 32px: o pseudo-elemento
   * estende a area clicavel 6px para cada lado. A revisao de design mediu 150
   * ocorrencias deste circulo abaixo de 44px no celular, e com os 156 do
   * rodape eram a maior parte do que sobrava do achado A15.
   */
  a.social::after {
    content: '';
    position: absolute;
    inset: -0.375rem;
  }

  /* O tema clareava o fundo e azulava o glifo; o Soft UI preenche: a acao
     primaria com o glifo no par dela (5,80:1). */
  a.social:hover {
    background-color: var(--color-acao-primaria);
    color: var(--color-acao-primaria-texto);
  }

  /* Sem perfil o simbolo fica, mas apagado e sem fundo — assim a ausencia se
     le, em vez de parecer um botao que nao responde. */
  span.social {
    background-color: transparent;
    color: var(--color-texto-sutil);
  }

  /* ---------------- superficie inversa ---------------- */

  /*
   * O cartao dos 41 autores do e-book. MEDIDO (scripts/medir-ebook.mjs): fundo
   * no carvao do proprio ebook (o `inversa` do <Cartao>, mesmo valor), nome
   * branco, cargo no cinza sutil (7,19:1 ali, medido) e o simbolo do LinkedIn
   * em branco.
   *
   * O fundo do circulo troca de origem: o navy translucido sumiria no carvao,
   * e quem serve e o branco translucido do par inverso. O contorno de foco
   * troca pelo mesmo motivo, e quem aciona aquela regra do base.css e a
   * `superficie-inversa` que o <Cartao> poe na raiz.
   */
  .inversa .social {
    background-color: var(--color-estado-hover-inverso);
    color: var(--color-texto-inverso);
  }

  .inversa a.social:hover {
    /* O azul de acao sobre o carvao da 3,0:1 -- ver a nota do cabecalho
       escuro. Aqui quem responde e o branco translucido mais denso, e o glifo
       mantem o branco. */
    background-color: var(--color-estado-atual-inverso);
    color: var(--color-texto-inverso);
  }

  .inversa span.social {
    color: var(--color-texto-sutil-inverso);
  }

  /*
   * A linha de destaque — o capitulo, no e-book. MEDIDA: 13px / 400, entrelinha
   * de 18px, sem margem propria (o cargo abaixo ja traz 10px de folga).
   *
   * A COR NAO E A MEDIDA. O tema usa #0c71c3, que sobre este carvao da 3,77:1
   * em texto de 13px e reprova o criterio 1.4.3 da WCAG. O token aponta para o
   * mesmo azul clareado 12%, que da 4,58:1 — ver a nota do --cor-azul-550 no
   * tokens.css. Sao 123 ocorrencias, a cor mais repetida da pagina.
   */
  .destaque {
    color: var(--color-ebook-capitulo);
    font-size: var(--text-sm);
    line-height: var(--text-sm--line-height);
    /* Os 10px medidos ate o cargo. No tema eles eram `margin-top` do proprio
       cargo, e ele nao pode carrega-los: sem destaque o cargo vem logo apos o
       nome, e ali a folga medida e outra. */
    margin: 0 0 0.75rem;
  }
</style>
