---
import Icone from '../primitivos/Icone.astro';
import Titulo from '../primitivos/Titulo.astro';
import type { NomeIcone } from '../../icones/glifos';

/**
 * CaixaIcone — simbolo, titulo curto e uma frase.
 *
 * 36 usos do `.icon-box.small.clean`: os oito beneficios de ser associado, os
 * canais da pagina de contato, e o mesmo bloco repetido nos tres idiomas.
 *
 *   <CaixaIcone icone="check-circle" titulo="Feiras">
 *     Participacao nas principais feiras do setor em estande cooperado.
 *   </CaixaIcone>
 *
 * DUAS DISPOSICOES, desde a revisao de design (achado A21):
 *
 *   empilhada  o simbolo em cima, em 48px. Para quando o simbolo DIZ algo e
 *              cada caixa tem o seu -- os canais da pagina de contato.
 *   lado       o simbolo de 24px a esquerda, na linha do titulo. Para listas
 *              em que ele se repete: os oito beneficios de /associe-se eram o
 *              mesmo visto de 46px empilhado oito vezes sobre titulo e frase,
 *              o padrao que a skill de revisao chama de "AI slop". Ao lado de
 *              cada item, o mesmo visto e uma lista de verificacao -- que e o
 *              que o conteudo e.
 *
 *   <CaixaIcone icone="check-circle" titulo="Feiras" disposicao="lado">
 *
 * MEDIDO (scripts/medir-padroes.mjs): glifo de 36px numa caixa de 46px, 16px
 * ate o titulo, titulo de 18px com entrelinha de 25px e 4px ate o texto, texto
 * de 14px com entrelinha de 22,4px.
 *
 * DOIS DESVIOS DELIBERADOS:
 *
 *   1. O icone deixa de ser link. No tema ele vinha dentro de `<a href="#">` —
 *      um link visivel, focavel, sem destino e repetido 36 vezes, que so
 *      atrapalhava quem navega por teclado ou leitor de tela.
 *   2. O peso do titulo cai de 700 para 600. E o peso semibold que o base.css
 *      mede em todo heading do site; 700 aqui era a excecao de um bloco so.
 */
interface Props {
  icone: NomeIcone;
  titulo: string;
  /** Nivel do heading. Depende da pagina, nao do desenho — ver <Titulo>. */
  nivel?: 1 | 2 | 3 | 4 | 5 | 6;
  alinhamento?: 'inicio' | 'centro';
  /** Cor do simbolo. `acao` destaca a lista inteira sem tocar no texto. */
  tom?: 'padrao' | 'acao';
  /** Ver a nota do topo: `lado` e para quando o simbolo se repete. */
  disposicao?: 'empilhada' | 'lado';
  class?: string;
}

const {
  icone,
  titulo,
  nivel = 3,
  alinhamento = 'inicio',
  tom = 'padrao',
  disposicao = 'empilhada',
  class: classe,
} = Astro.props;
---

<div
  class:list={[
    'caixa',
    alinhamento === 'centro' && 'centro',
    tom === 'acao' && 'tom-acao',
    disposicao === 'lado' && 'lado',
    classe,
  ]}
>
  {/* aria-hidden por omissao do `rotulo`: o titulo logo abaixo diz a mesma
      coisa, e anunciar os dois faria o leitor de tela repetir cada item. */}
  <Icone nome={icone} tamanho={disposicao === 'lado' ? 'md' : 'lg'} class="simbolo" />
  <div class="conteudo">
    <Titulo nivel={nivel} papel="cartao" class="titulo">{titulo}</Titulo>
    <div class="texto">
      <slot />
    </div>
  </div>
</div>

<style>
  /*
   * A CAIXA NAO TEM MARGEM PROPRIA, e a linha que tinha foi removida na Etapa 5.
   *
   * Ela media 50px, e os 50px sao reais — no tema, a caixa vivia dentro de uma
   * `.row` de colunas coladas, e aquela margem era a UNICA coisa separando uma
   * linha de caixas da seguinte. O valor estava certo e o lugar, errado: numa
   * <Grade>, quem separa e o `gap`, e a margem passa a sobrar embaixo da ultima
   * linha, por dentro do container.
   *
   * Apareceu na pagina de contato: a caixa cinza ficou com 55px de respiro em
   * cima e 95 embaixo. Nenhum portao viu — nao ha caixa zerada, nem transbordo,
   * nem sobreposicao; e assimetria, e assimetria so aparece olhando.
   *
   * A regra que fica: espaco ENTRE irmaos e do container, nao do filho. E a
   * mesma que a <Secao> e a <Grade> ja seguem.
   */

  .centro {
    text-align: center;
  }

  /*
   * O tamanho e o do <Icone tamanho="lg">, 48px. Ate a revisao de design esta
   * regra forcava o `<svg>` a 46px -- e o comentario dela falava em "glifo de
   * 36px numa caixa de 46", mas a caixa ERA o svg, e o glifo desenhava 46.
   */
  .caixa :global(.simbolo) {
    display: block;
    margin-bottom: 1rem;
  }

  .centro :global(.simbolo) {
    margin-inline: auto;
  }

  .tom-acao :global(.simbolo) {
    color: var(--color-acao-primaria);
  }

  /*
   * O simbolo ao lado: uma coluna do tamanho dele, e o titulo e o texto na
   * outra. O recuo de 2px poe o visto de 24px na altura da linha do titulo
   * (19 a 20px de corpo em 1,4 de entrelinha), em vez de no topo da caixa.
   */
  .lado {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    align-items: start;
  }

  .lado :global(.simbolo) {
    margin-block: 0.125rem 0;
  }

  /* A entrelinha e a do degrau `cartao`; a medida do tema (1.39) saiu na
     revisao de design, com as outras entrelinhas soltas. */
  .caixa :global(.titulo) {
    margin-block: 0 0.25rem;
  }

  .texto :global(p:last-child) {
    margin-bottom: 0;
  }
</style>
