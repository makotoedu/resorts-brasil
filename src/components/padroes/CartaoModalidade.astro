---
import Cartao from '../primitivos/Cartao.astro';
import Titulo from '../primitivos/Titulo.astro';
import LinkAcao from './LinkAcao.astro';
import type { Tom } from './FaixaDestaque.astro';

/**
 * CartaoModalidade — a caixa colorida com um titulo curto e um link.
 *
 * As duas modalidades de apoio em /apoie: Parceiro no roxo, Mantenedor no
 * magenta, nos tres idiomas. A Etapa 3 ja o citava sem o construir — o
 * <LinkAcao> nasceu dizendo que vive "dentro de tres dos outros: chamada, cartao
 * de publicacao e cartao de modalidade", e este e o terceiro.
 *
 *   <CartaoModalidade tom="roxo" titulo="Parceiro" href="/fale-conosco">
 *     Fale conosco
 *   </CartaoModalidade>
 *
 * MEDIDO (scripts/medir-padroes.mjs, grupo `cartaoModalidade`): recuo de 21px,
 * raio de 11,48px (`--radius-md`), titulo de 19px com peso 600. O fundo vinha de
 * `style="background-color: #570A57"` — 6 das 24 cores literais que o markup
 * carregava, e as mesmas que a <FaixaDestaque> ja nomeou.
 *
 * O TOM VEM DE LA, e o tipo tambem: `Tom` e importado da <FaixaDestaque> em vez
 * de redeclarado. Nesta pagina o mesmo par de cores pinta o cartao pequeno e a
 * faixa larga logo abaixo — sao a mesma decisao vista duas vezes, e dois enums
 * paralelos garantiriam que um dia divergissem.
 *
 * A cor do texto tambem nao e escolha de quem usa: cada tom traz o proprio par
 * no tokens.css. Ver a nota da <FaixaDestaque> sobre o branco que o tema
 * escrevia sobre os cinco fundos.
 *
 * O SOFT UI FEZ DELE UM CARTAO INTEIRO CLICAVEL. A caixa e o <Cartao tom>, e
 * o link e esticado sobre ela: o alvo deixou de ser a palavra "Fale conosco" e
 * passou a ser a caixa colorida inteira, que e o que o olho ja lia como botao.
 * O recuo, o raio e o vao entre titulo e link sao os do <Cartao>.
 *
 * UM DESVIO DELIBERADO: O CHEVRON. Medido no tema com o mouse em cima, este link
 * NAO responde ao hover — branco sobre o roxo em repouso, branco sobre o roxo em
 * hover, sem sublinhado. O `.item-link:hover` existe e troca a cor para azul,
 * mas aqui o `.text-light` do cartao vence, e o resultado e um link que nao da
 * nenhum sinal de ser um. A seta do <LinkAcao> devolve o sinal deslizando, sem
 * depender de cor — que e o unico eixo que uma superficie de cor cheia nao tem
 * sobrando.
 */
interface Props {
  tom: Tom;
  titulo: string;
  /** Nivel do heading. Depende da pagina, nao do desenho — ver <Titulo>. */
  nivel?: 1 | 2 | 3 | 4 | 5 | 6;
  /** O destino do link. O texto dele vem pelo slot. */
  href: string;
  class?: string;
}

const { tom, titulo, nivel = 3, href, class: classe } = Astro.props;

/* Ambar e verde levam o navy como par de texto; os outros quatro, o branco.
   E o mesmo par que o <Cartao> pinta no fundo -- aqui so se escolhe o lado. */
const cor = tom === 'ambar' || tom === 'verde' ? 'padrao' : 'inverso';
---

{/*
  O tom, o par de texto e a marca `superficie-inversa` (que troca o contorno
  de foco) sao do <Cartao>. O titulo e o link tomam o lado do par que o tom
  pede: o navy do <LinkAcao> em repouso sumiria no roxo e no magenta.
*/}
<Cartao tom={tom} interativo class={classe}>
  <Titulo nivel={nivel} papel="cartao" cor={cor}>{titulo}</Titulo>
  <LinkAcao href={href} cor={cor} esticado><slot /></LinkAcao>
</Cartao>
