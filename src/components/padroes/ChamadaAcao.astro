---
import Imagem from '../primitivos/Imagem.astro';

/**
 * ChamadaAcao — o bloco destacado, em quatro superficies.
 *
 * 51 usos do `.call-to-action`, e nao e um so desenho: o mesmo nome de classe
 * cobre o bloco cinza com titulo e texto, o bloco escuro, e o cartao sobre foto
 * com veu que a home repete seis vezes. Sao a mesma caixa com fundos diferentes,
 * e e assim que entram aqui — `fundo` e a unica prop que muda de verdade.
 *
 *   <ChamadaAcao>...</ChamadaAcao>
 *   <ChamadaAcao fundo="marca">...</ChamadaAcao>
 *   <ChamadaAcao fundo="imagem" imagem="/images/hero/pexels-1072842.jpg" alt="">
 *     <Titulo nivel={3} tamanho="lg" cor="inverso">Apoie o Turismo</Titulo>
 *     <LinkAcao href="/apoie" cor="inverso">Saiba mais</LinkAcao>
 *   </ChamadaAcao>
 *
 * MEDIDO (scripts/medir-padroes.mjs), e o recuo e o unico numero que muda de
 * faixa: 26px em cima / 26px nos lados / 18px embaixo no mobile e no tablet,
 * indo a 46 / 50 / 34 no desktop. No tema isso saltava na media query; aqui
 * interpola por `clamp()`, com as pontas medidas. Raio 11,48px (`--radius-md`).
 *
 * DUAS COISAS MUDAM DE PROPOSITO NA VARIANTE COM FOTO:
 *
 *   1. A foto era `background-image` num `style=` inline com `height: 360px`.
 *      Fundo de CSS nao tem `srcset` nem lazy: os seis cartoes da home baixavam
 *      seis originais inteiros. Aqui e um <Imagem> de verdade, com o pipeline
 *      da Etapa 2, e a altura vem de `proporcao` — a caixa acompanha a largura
 *      em vez de recortar mais justamente onde ha menos tela.
 *   2. O veu era um `.bg-overlay` com `opacity: 0.5` sobre um preto de 0,59.
 *      Opacidade de camada esmaece tambem o que estiver DENTRO dela; aqui a
 *      transparencia esta na propria cor (`--color-veu`), medida no efeito
 *      final. E o mesmo cuidado que o kenburns deste projeto ja custou uma vez.
 */
interface Props {
  fundo?: 'clara' | 'marca' | 'imagem' | 'transparente';
  /** So com `fundo="imagem"`. Caminho publico (`/images/...`). */
  imagem?: string;
  /** Vazio marca foto decorativa — que e o caso quando o texto ja diz tudo. */
  alt?: string;
  /** Sem ela, a caixa tem a altura do conteudo. Substitui o `height: 360px`. */
  proporcao?: 'larga' | 'video' | 'quadrada';
  alinhamento?: 'inicio' | 'centro';
  /** Onde o conteudo encosta. O tema chamava de `text-bottom`. */
  conteudo?: 'centro' | 'fim';
  /** Primeira imagem visivel da pagina: carrega sem lazy. */
  prioridade?: boolean;
  /** O `sizes` da foto. Diga-o sempre que o bloco nao ocupar a janela inteira. */
  tamanhos?: string;
  como?: 'div' | 'section' | 'article' | 'aside';
  /**
   * A chamada inteira responde ao hover, como um <Cartao interativo>: sobe 2px,
   * ganha a `--shadow-2` e a foto aproxima. O link que a cobre e o
   * <LinkAcao esticado> do slot -- o `position: relative` que o `::after` dele
   * procura ja e desta caixa. Os seis destaques da home.
   */
  interativo?: boolean;
  class?: string;
}

const {
  fundo = 'clara',
  imagem,
  alt = '',
  proporcao,
  alinhamento = 'inicio',
  conteudo = 'centro',
  prioridade = false,
  tamanhos = '(min-width: 64rem) 33vw, 100vw',
  como = 'div',
  interativo = false,
  class: classe,
} = Astro.props;

const Tag = como;

if (fundo === 'imagem' && !imagem) {
  throw new Error('ChamadaAcao: fundo="imagem" exige a prop `imagem`.');
}

/* Classes inteiras — ver a nota do Titulo.astro sobre a varredura do Tailwind. */
const PROPORCOES = {
  larga: 'p-larga',
  video: 'p-video',
  quadrada: 'p-quadrada',
} as const;
---

<Tag
  class:list={[
    'chamada',
    `f-${fundo}`,
    alinhamento === 'centro' && 'centro',
    conteudo === 'fim' && 'conteudo-fim',
    interativo && 'interativo',
    proporcao && PROPORCOES[proporcao],
    /* A mesma marca que o base.css procura para trocar a cor do contorno de
       foco: sobre fundo escuro o azul do foco desaparece. */
    (fundo === 'marca' || fundo === 'imagem') && 'superficie-inversa',
    classe,
  ]}
>
  {
    fundo === 'imagem' && (
      <>
        <Imagem
          src={imagem!}
          alt={alt}
          escala="largura-total"
          tamanhos={tamanhos}
          ajuste="cobrir"
          prioridade={prioridade}
          class="foto"
        />
        <span class="veu" aria-hidden="true" />
      </>
    )
  }
  <div class="interior">
    <slot />
  </div>
</Tag>

<style>
  .chamada {
    position: relative;
    /* O mesmo recuo nos quatro lados, o --spacing-chamada. Medido no tema eram
       tres pares: 26-46 em cima, 26-50 nos lados e 18-34 embaixo -- o de
       baixo menor porque o ultimo paragrafo ja trazia margem. */
    padding: var(--spacing-chamada);
    border-radius: var(--radius-md);
    /* A foto e o veu sao filhos posicionados; sem isto eles vazam dos cantos. */
    overflow: hidden;
  }

  .centro {
    text-align: center;
  }

  /* ---------------- superficies ---------------- */

  .f-clara {
    background-color: var(--color-superficie-clara);
  }

  /* MEDIDO em `.call-to-action.background-dark`: o navy do site, e nao o carvao
     do ebook. Ver a nota de `--color-superficie-marca` no tokens.css. */
  .f-marca {
    background-color: var(--color-superficie-marca);
    color: var(--color-texto-inverso);
  }

  .f-imagem {
    color: var(--color-texto-inverso);
  }

  /* ---------------- a foto e o veu ---------------- */

  /*
   * `inset: 0` e nao `z-index` negativo. O kenburns do tema ficava atras do
   * fundo do proprio slide por depender de um contexto de empilhamento que o
   * plugin criava, e o zoom parou de acontecer quando o plugin saiu — sem
   * quebrar nenhum teste. Aqui a ordem e a do documento: foto, veu, interior.
   */
  .chamada :global(.foto) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /*
   * O veu e um GRADIENTE, e a razao esta na nota de `--color-veu-forte`.
   *
   * O 40% e onde a transicao comeca, e ele serve as duas posicoes de conteudo
   * que este componente tem: `centro` cai logo depois dela e `fim` encosta na
   * base, que e o ponto mais escuro. O topo da foto continua no veu leve de
   * sempre — que e o que impede a correcao de virar "escurecer tudo".
   */
  .veu {
    position: absolute;
    inset: 0;
    background-image: linear-gradient(
      to bottom,
      var(--color-veu) 0%,
      var(--color-veu-forte) 40%,
      var(--color-veu-forte) 100%
    );
  }

  .interior {
    position: relative;
  }

  /* A simetria de verdade: o ultimo filho nao traz margem para dentro do
     recuo. `:global` porque ele nasce num <Texto> ou num <Titulo>. */
  .interior > :global(:last-child) {
    margin-bottom: 0;
  }

  /*
   * O PARAGRAFO TEM MEDIDA, mesmo quando a chamada e larga. Sobre a foto de
   * /associe-se a chamada ocupa o container inteiro, e o texto corria em 169
   * caracteres por linha. `:global` porque o `<p>` nasce dentro do <Texto>, e
   * estilo com escopo nao alcanca markup de componente filho (armadilha 1).
   */
  .interior :global(p) {
    max-width: var(--container-linha);
  }

  .centro .interior :global(p) {
    margin-inline: auto;
  }

  /*
   * MIDIA DENTRO DA CHAMADA usa o raio de controle. A chamada ja e uma
   * superficie arredondada, e o raio de dentro igual ao de fora deixa a foto
   * com cantos mais redondos que a caixa que a contem -- era a home nos tres
   * idiomas. Ver a regra de raio no tokens.css. `:global` porque o `<img>` e
   * do <Imagem>, e a regra sem camada vence a utilitaria `rounded-md` dele.
   */
  .interior :global(img) {
    border-radius: var(--radius-sm);
  }

  /* ---------------- proporcao ---------------- */

  /*
   * Substitui o `height: 360px` do `style=` inline.
   *
   * `min-height: fit-content` junto do `aspect-ratio` nao e detalhe: sozinho, o
   * `aspect-ratio` fixa a altura pela largura e o conteudo que nao couber
   * TRANSBORDA. Este site tem tres idiomas, e o titulo alemao de um cartao
   * nunca tem o tamanho do portugues — a caixa precisa poder crescer. Com os
   * dois, a proporcao vale como piso e o texto manda quando e maior.
   */
  .p-larga,
  .p-video,
  .p-quadrada {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: fit-content;
  }

  .p-larga {
    aspect-ratio: var(--aspect-larga);
  }

  .p-video {
    aspect-ratio: 16 / 9;
  }

  .p-quadrada {
    aspect-ratio: 1 / 1;
  }

  .conteudo-fim {
    justify-content: flex-end;
  }

  /* ---------------- interativo ---------------- */

  /*
   * A mesma resposta do <Cartao interativo>, escrita de novo aqui e nao
   * importada: a regra precisa alcancar a `.foto` deste template, e um
   * componente nao estiliza o markup de outro. Sao seis declaracoes; se um dia
   * forem mais, o caminho e a chamada compor o <Cartao>.
   */
  .interativo {
    transition:
      box-shadow var(--duracao) var(--ease-chegada),
      transform var(--duracao) var(--ease-chegada);
    /* Um contexto de empilhamento proprio, para o `z-index: -1` abaixo ficar
       DENTRO da chamada, por cima do fundo dela, e nao atras da pagina. */
    isolation: isolate;
  }

  /*
   * O LINK ESTICADO PROCURA O ANCESTRAL POSICIONADO MAIS PROXIMO, e ate aqui
   * era a `.interior`: o `::after` cobriria so o texto. Na chamada interativa a
   * interior deixa de ser posicionada, e quem a mantinha por cima da foto e do
   * veu passa a ser a ordem de pintura -- os dois descem para `z-index: -1`, e
   * conteudo em fluxo pinta sobre camada negativa.
   */
  .interativo .interior {
    position: static;
  }

  .interativo :global(.foto),
  .interativo .veu {
    z-index: -1;
  }

  .interativo:hover,
  .interativo:focus-within {
    box-shadow: var(--shadow-2);
  }

  .interativo :global(.foto) {
    transition: transform var(--duracao) var(--ease-chegada);
  }

  @media (prefers-reduced-motion: no-preference) {
    .interativo:hover {
      transform: translateY(-2px);
    }

    .interativo:hover :global(.foto) {
      transform: scale(1.03);
    }
  }
</style>
