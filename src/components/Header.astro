---
import SocialIcons from './SocialIcons.astro';
import { ui, url, localeBadge, locales, htmlLang, type Locale, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  /**
   * Rota da pagina atual, para o seletor de idioma levar a traducao DESTA
   * pagina. Ausente so na 404, que nao tem traducao — nesse caso o seletor cai
   * na home, que e o unico destino que existe nos tres idiomas.
   */
  route?: RouteKey;
  /**
   * As tres paginas do ebook nunca tiveram topbar, e o cabecalho delas leva a
   * classe `dark`. As duas coisas andam juntas no original e mudam o
   * deslocamento sob o cabecalho transparente — ver public/css/ajustes.css.
   */
  semTopbar?: boolean;
  escuro?: boolean;
}

const { lang, route, semTopbar = false, escuro = false } = Astro.props;
const t = ui[lang];

// O rotulo e resolvido aqui e nao no template: uma anotacao de tipo com
// generics dentro do markup seria lida como tag JSX pelo parser do Astro.
//
// O destino era `url('home', ...)` fixo: trocar de idioma em /historia jogava o
// visitante na home inglesa, e ele perdia a pagina em que estava. O mapa
// `routes` ja tinha o slug traduzido de cada pagina — faltava usa-lo.
const otherLocales = locales
  .filter((l) => l !== lang)
  .map((l) => ({
    label: (t.langOther as Record<string, string>)[l],
    href: url(route ?? 'home', l),
    // hreflang usa o codigo de idioma, nao a chave do locale.
    hreflang: htmlLang[l],
  }));
---

<!-- Topbar -->
{!semTopbar && (
<div id="topbar" class="topbar-colored topbar-fullwidth dark d-none d-xl-block d-lg-block">
  <div class="container">
    <div class="row">
      <div class="col-md-6">
        <ul class="top-menu">
          <li><a href={url('ebook', lang)}>{t.topbarEbook}</a></li>
          <li>
            <a href={url('joinUs', lang)}><span style="color: rgb(211, 180, 4);">{t.topbarJoin}</span></a>
          </li>
        </ul>
      </div>
      <div class="col-md-6 d-none d-sm-block">
        <SocialIcons lang={lang} class="social-icons social-icons-colored-hover" />
      </div>
    </div>
  </div>
</div>
)}
<!-- end: Topbar -->

<!-- Header -->
<header
  id="header"
  data-transparent="true"
  class={`header-disable-fixed ${escuro ? 'dark ' : ''}submenu-light`}
>
  <div class="header-inner">
    <div class="container">
      <!--Logo-->
      <div id="logo">
        <a href={url('home', lang)}>
          <img src="/images/logo-25anos.png" alt="Resorts Brasil" class="logo-default" />
          <img src="/images/logo-25anos.png" alt="Resorts Brasil" class="logo-dark" />
        </a>
      </div>
      <!--End: Logo-->
      <!--Header Extras-->
      <div class="header-extras">
        <ul>
          <li>
            <div class="p-dropdown">
              <a
                href="#"
                aria-label={t.chooseLanguage}
                aria-haspopup="true"
                aria-expanded="false"><i class="icon-globe" aria-hidden="true"></i><span>{localeBadge[lang]}</span></a>
              <ul class="p-dropdown-content">
                {
                  otherLocales.map((other) => (
                    <li>
                      <a href={other.href} hreflang={other.hreflang}>{other.label}</a>
                    </li>
                  ))
                }
              </ul>
            </div>
          </li>
        </ul>
      </div>
      <!--end: Header Extras-->
      <!--Navigation Responsive Trigger-->
      <!--
        role/tabindex em vez de <button>: o <a> nao tem href (o tema o usa so
        como gatilho), entao nao entrava na ordem de tabulacao. Trocar a tag por
        <button> traria o estilo de UA do botao para dentro de um elemento que o
        tema desenha por CSS. O site.js trata Enter e Espaco.
      -->
      <div id="mainMenu-trigger">
        <a
          class="lines-button x"
          role="button"
          tabindex="0"
          aria-label={t.openMenu}
          aria-controls="mainMenu"
          aria-expanded="false"><span class="lines"></span></a>
      </div>
      <!--end: Navigation Responsive Trigger-->
      <!--Navigation-->
      <div id="mainMenu">
        <div class="container">
          <nav>
            <ul>
              <li><a href={url('home', lang)}>{t.navHome}</a></li>
              <li class="dropdown">
                <a href="#" aria-haspopup="true" aria-expanded="false">{t.navAbout}</a>
                <ul class="dropdown-menu">
                  <li><a href={url('resortsBrasil', lang)}>{t.navResortsBrasil}</a></li>
                  <li><a href={url('board', lang)}>{t.navBoard}</a></li>
                  <li><a href={url('history', lang)}>{t.navHistory}</a></li>
                </ul>
              </li>
              <li class="dropdown">
                <a href="#" aria-haspopup="true" aria-expanded="false">{t.navAssociates}</a>
                <ul class="dropdown-menu">
                  <li><a href={url('associates', lang)}>{t.navAssociatesList}</a></li>
                  <li><a href={url('joinUs', lang)}>{t.navJoinUs}</a></li>
                </ul>
              </li>
              <li class="dropdown">
                <a href="#" aria-haspopup="true" aria-expanded="false">{t.navInformation}</a>
                <ul class="dropdown-menu">
                  <li><a href={url('publications', lang)}>{t.navPublications}</a></li>
                  <li><a href={url('statistics', lang)}>{t.navStatistics}</a></li>
                </ul>
              </li>
              <li><a href={url('support', lang)}>{t.navSupport}</a></li>
              <li><a href={url('contact', lang)} style="color: #d39e00;">{t.navContact}</a></li>
            </ul>
          </nav>
        </div>
      </div>
      <!--end: Navigation-->
    </div>
  </div>
</header>
<!-- end: Header -->
