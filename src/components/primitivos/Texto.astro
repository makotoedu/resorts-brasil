---
/**
 * Texto — corpo, abertura, apoio e legenda.
 *
 * O par de <Titulo>: ali a tag e a aparencia se separam, aqui tambem. Um
 * paragrafo, um `<span>` dentro de uma frase e um item de lista compartilham a
 * mesma escala e as mesmas cores sem que ninguem precise repetir a cadeia de
 * utilitarias.
 *
 *   <Texto>Nossos planos sao feitos pelos resorts para os resorts.</Texto>
 *   <Texto papel="abertura">Representamos os grandes resorts do pais.</Texto>
 *   <Texto como="span" papel="legenda">Atualizado em agosto</Texto>
 *
 * ERA `tamanho`, E O EIXO LIVRE FEZ AQUI O QUE TINHA FEITO NO <Titulo>. Cada
 * pagina escolhia o tamanho e a cor da propria abertura, e a medicao da revisao
 * de design achou o resultado: a frase que abre a pagina em 25px no desktop --
 * o mesmo degrau do titulo de bloco --, em tres cores (cinza de paragrafo em
 * 27 paginas, navy em 7, cinza sutil em 9). `papel` fecha isso com quatro
 * papeis, e cada um traz tamanho, entrelinha e cor de partida:
 *
 *   papel      degrau  px        cor de partida   uso
 *   corpo      base    16        a do `p`         o texto corrido
 *   abertura   md      19 ate 20 a do `p`         a frase que abre a pagina
 *   apoio      sm      14        sutil            cargo, mandato, metadado
 *   legenda    xs      13        sutil            data de atualizacao, nota
 *
 * `cor` continua existindo, e e para SUPERFICIE: sobre fundo escuro ou foto a
 * cor de partida nao serve, e quem sabe disso e quem chama. Escolher uma cor
 * por gosto numa superficie clara e o que o papel existe para evitar.
 */
interface Props {
  como?: 'p' | 'span' | 'div' | 'li' | 'strong' | 'small';
  /** Tamanho, entrelinha e cor de partida. Ver a tabela acima. */
  papel?: 'corpo' | 'abertura' | 'apoio' | 'legenda';
  /**
   * `sutil` e `sutil-inverso` sao o MESMO papel em dois fundos, e sao dois
   * tokens porque um cinza so nao serve aos dois: o claro da 2,64:1 sobre branco
   * e o escuro daria 2,1:1 sobre carvao. Ver a nota de `--color-texto-sutil`.
   */
  cor?: 'padrao' | 'paragrafo' | 'sutil' | 'sutil-inverso' | 'inverso' | 'destaque';
  /**
   * Enfase dentro do corpo, e so isso: os titulos tem o peso deles, e o 700
   * deixou de ser baixado na revisao de design.
   */
  peso?: 'normal' | 'semibold';
  alinhamento?: 'inicio' | 'centro' | 'fim';
  /** Remove a margem inferior — util quando o container ja controla o ritmo. */
  semMargem?: boolean;
  class?: string;
}

const {
  como = 'p',
  papel = 'corpo',
  cor,
  peso,
  alinhamento,
  semMargem = false,
  class: classe,
} = Astro.props;

const Tag = como;

/* Classes inteiras, pelo mesmo motivo explicado no Titulo.astro. */
const PAPEIS = {
  corpo: '',
  abertura: 'text-md',
  apoio: 'text-sm',
  legenda: 'text-xs',
} as const;

/* A cor de partida de cada papel. Vazio e a do proprio elemento: o `p` traz o
   cinza de paragrafo do base.css, e um `span` herda de quem o contem. */
const COR_DE_PARTIDA = {
  corpo: undefined,
  abertura: undefined,
  apoio: 'sutil',
  legenda: 'sutil',
} as const;

const CORES = {
  padrao: 'text-texto',
  paragrafo: 'text-texto-paragrafo',
  sutil: 'text-texto-sutil',
  'sutil-inverso': 'text-texto-sutil-inverso',
  inverso: 'text-texto-inverso',
  destaque: 'text-destaque',
} as const;

const PESOS = {
  normal: 'font-normal',
  semibold: 'font-semibold',
} as const;

const ALINHAMENTOS = {
  inicio: 'text-left',
  centro: 'text-center',
  fim: 'text-right',
} as const;

const corFinal = cor ?? COR_DE_PARTIDA[papel];

/*
 * MEDIDA. A abertura e o texto centralizado ganham a linha do sistema, e o
 * centralizado ainda se centra como bloco. Linha longa e ruim; linha longa
 * centrada e pior, porque cada uma comeca num lugar. Sem isto o convite ao
 * associado corria em 188 caracteres numa linha so, a introducao de /historia
 * em 128 e as aberturas em 95. Ver --container-linha no tokens.css.
 */
const comMedida = (papel === 'abertura' || alinhamento === 'centro') && 'max-w-linha';
const centrado = alinhamento === 'centro' && 'mx-auto';
---

<Tag
  class:list={[
    PAPEIS[papel],
    corFinal && CORES[corFinal],
    peso && PESOS[peso],
    alinhamento && ALINHAMENTOS[alinhamento],
    comMedida,
    centrado,
    semMargem && 'mb-0',
    classe,
  ]}
>
  <slot />
</Tag>
