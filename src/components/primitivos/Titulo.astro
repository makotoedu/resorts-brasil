---
/**
 * Titulo — a tag e o tamanho como eixos separados.
 *
 * ESTE COMPONENTE EXISTE POR CAUSA DE UM NUMERO: 39 das 40 paginas do site tem
 * hierarquia de heading quebrada, e a causa e sempre a mesma — escolher a tag
 * pelo tamanho que ela desenha. `historia.astro:14` tem literalmente
 * `<h1 class="text-md h2">`: um h1 que queria parecer h2.
 *
 * Aqui `nivel` decide a TAG (o que o leitor de tela e o Google enxergam) e
 * `papel` decide a APARENCIA. Um h2 grande e um h1 discreto deixam de exigir
 * uma classe que contradiga a tag, e o erro deixa de ter por onde voltar.
 *
 *   <Titulo nivel={2} papel="secao">Nossos associados</Titulo>
 *   <Titulo nivel={1} papel="pagina">Seja um associado</Titulo>
 *
 * ERA `tamanho`, E O EIXO LIVRE VIROU O DEFEITO SEGUINTE.
 *
 * A separacao acima consertou o sumario — os 39 estao em zero e o
 * verifica-sistema afirma isso a cada build. Mas ela deixou a APARENCIA sem
 * regra nenhuma, e a medicao no navegador mostrou o resultado: `h2` renderiza
 * em CINCO tamanhos (18, 25, 34, 50 e 62px) e `h3` renderiza em UM (18px, nas
 * 45 ocorrencias). Onde os dois se encontram em 18px, nivel 2 e nivel 3 sao o
 * mesmo objeto visual, e o tamanho parou de dizer qualquer coisa sobre a
 * profundidade.
 *
 * Tres colisoes medidas, e cada uma nasceu de uma pagina escolhendo sozinha:
 *
 *   home         h1 de 62px seguido de h2 de 62px — os dois primeiros titulos
 *                do site, indistinguiveis por tamanho;
 *   apoie        "Parceiro" como h3 de 18px no cartao e como h2 de 50px na
 *                faixa, a mesma palavra na mesma tela, 2,8x de diferenca;
 *   publicacoes  os h2 de conteudo em 18px sob o h2 do CTA em 25px — o convite
 *                tipograficamente maior que as publicacoes que nomeiam a pagina.
 *
 * `papel` fecha isso com quatro degraus, um por profundidade. Nao e uma
 * renomeacao de `tamanho`: e a lista de valores que UMA pagina pode usar, e ela
 * nao inclui o 2xl justamente porque o 2xl so existia nas faixas de apoie e
 * historia, que eram a colisao.
 *
 *   papel    token      390 ate 1440px   peso   uso
 *   pagina   text-3xl   40 ate 61px      500    o titulo da pagina, um por pagina
 *   secao    text-xl    28 ate 34px      500    titulo de secao, e o das faixas
 *   bloco    text-lg    23 ate 25px      600    sub-bloco, cartao sobre foto
 *   cartao   text-md    19 ate 20px      600    cartao, rotulo de grupo
 *
 * O PESO NAO E MAIS UM PROP, e pelo mesmo motivo que o `tamanho` deixou de ser.
 * Ate a revisao de design havia um `peso` livre, e ele repetiu a doenca: o
 * titulo de pagina saia em 500, 600 ou 800 conforme a pagina, e o h1 em 500
 * ficava ABAIXO dos titulos de secao e de bloco em 600 -- medido em 33
 * paginas, a hierarquia de cabeca para baixo. Agora o peso vem com o degrau:
 * os grandes (xl, 2xl, 3xl) carregam 500 e um tracking negativo no proprio
 * token do tokens.css, os pequenos herdam os 600 do base.css. O peso diminui
 * conforme o tamanho cresce, e o escape `tamanho` obedece a mesma regra --
 * e assim que o ebook entra nela.
 *
 * `tamanho` SOBREVIVE COMO ESCAPE, e nao por comodidade: a pagina do e-book tem
 * escala propria (hero em 3xl, secoes em 2xl e xl) pelo mesmo motivo que tem
 * paleta propria, e o catalogo do design system precisa exibir a escala crua
 * inteira. Sao os dois unicos arquivos onde ele e permitido, e quem afirma isso
 * e a allowlist do `scripts/verifica-sistema.mjs` — que guarda o NUMERO
 * esperado por arquivo, como ja faz com `style=`, para que um uso novo num
 * arquivo ja excepcionado continue reprovando.
 */
interface Props {
  /** A tag. E o unico eixo que muda a semantica do documento. */
  nivel: 1 | 2 | 3 | 4 | 5 | 6;
  /** A aparencia, por profundidade. Ver a tabela acima. */
  papel?: 'pagina' | 'secao' | 'bloco' | 'cartao';
  /** O ESCAPE. So no PaginaEbook.astro e no design.astro. */
  tamanho?: 'md' | 'lg' | 'xl' | '2xl' | '3xl';
  cor?: 'padrao' | 'inverso' | 'sutil' | 'sutil-inverso' | 'paragrafo';
  alinhamento?: 'inicio' | 'centro' | 'fim';
  class?: string;
}

const { nivel, papel, tamanho, cor = 'padrao', alinhamento, class: classe } = Astro.props;

/* Os dois eixos sao exclusivos: `papel` e a lista curta que uma pagina pode
   usar, `tamanho` e o escape. Aceitar os dois juntos deixaria a precedencia
   como detalhe de implementacao. */
if (papel && tamanho) {
  throw new Error(
    'Titulo: use `papel` OU `tamanho`, nunca os dois. Recebeu papel="' +
      papel +
      '" e tamanho="' +
      tamanho +
      '".'
  );
}

const Tag = `h${nivel}` as const;

/*
 * Os mapas guardam a classe INTEIRA, escrita a mao. O Tailwind varre o codigo
 * como texto: `text-${tamanho}` montado em tempo de execucao nao existe para
 * ele, a utilitaria nao e gerada e o estilo some sem erro nenhum. Vale para
 * todo componente deste diretorio.
 */
const TAMANHOS = {
  md: 'text-md',
  lg: 'text-lg',
  xl: 'text-xl',
  '2xl': 'text-2xl',
  '3xl': 'text-3xl',
} as const;

/* Os quatro degraus de profundidade. Ver a tabela no topo do arquivo. */
const PAPEIS = {
  pagina: 'text-3xl',
  secao: 'text-xl',
  bloco: 'text-lg',
  cartao: 'text-md',
} as const;

const CORES = {
  padrao: '',
  inverso: 'text-texto-inverso',
  sutil: 'text-texto-sutil',
  'sutil-inverso': 'text-texto-sutil-inverso',
  paragrafo: 'text-texto-paragrafo',
} as const;

const ALINHAMENTOS = {
  inicio: 'text-left',
  centro: 'text-center',
  fim: 'text-right',
} as const;
---

<Tag
  class:list={[
    papel ? PAPEIS[papel] : tamanho && TAMANHOS[tamanho],
    CORES[cor],
    alinhamento && ALINHAMENTOS[alinhamento],
    classe,
  ]}
>
  <slot />
</Tag>
