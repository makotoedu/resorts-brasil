---
import SocialIcons from './SocialIcons.astro';
import { ui, url, type Locale } from '../i18n/ui';

interface Props {
  lang: Locale;
  /** Só a faixa de copyright, sem os widgets. É o rodapé que a 404 sempre teve. */
  minimo?: boolean;
  /** Rodapé escuro das três páginas do ebook (`class="inverted"` no original). */
  invertido?: boolean;
}

const { lang, minimo = false, invertido = false } = Astro.props;
const t = ui[lang];

// Resolvido no build. Antes o ano vinha de document.write() nas home e estava
// fixo em "2022" nas 12 paginas internas em PT.
const year = new Date().getFullYear();
---

<!-- Footer -->
<footer id="footer" class={invertido ? 'inverted' : undefined}>
  {!minimo && (
  <div class="footer-content">
    <div class="container">
      <div class="row gap-y">
        <div class="col-md-6 col-xl-4">
          <p>
            <a href={url('home', lang)}>
              <img src="/images/logo-25anos.png" alt="Resorts Brasil" style="height:130px;" />
            </a>
          </p>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="widget">
            <h4>{t.footerNavigation}</h4>
            <ul class="list">
              <li><a href={url('home', lang)}>{t.navHome}</a></li>
              <li><a href={url('resortsBrasil', lang)}>{t.footerAbout}</a></li>
              <li><a href={url('associates', lang)}>{t.navAssociates}</a></li>
              <li><a href={url('support', lang)}>{t.navSupport}</a></li>
              <li><a href={url('contact', lang)}>{t.navContact}</a></li>
              <li><a href={url('privacy', lang)}>{t.footerPrivacy}</a></li>
              <li><a href={url('terms', lang)}>{t.footerTerms}</a></li>
            </ul>
          </div>
        </div>
        <div class="col-6 col-md-3 col-xl-2">
          <div class="widget">
            <h4>{t.footerInstitutional}</h4>
            <ul class="list">
              <li><a href={url('resortsBrasil', lang)}>{t.navResortsBrasil}</a></li>
              <li><a href={url('board', lang)}>{t.navBoard}</a></li>
              <li><a href={url('history', lang)}>{t.navHistory}</a></li>
            </ul>
          </div>
        </div>
        <div class="col-6 col-md-6 col-xl-2">
          <div class="widget">
            <h4>{t.footerInformation}</h4>
            <ul class="list">
              <li><a href={url('publications', lang)}>{t.navPublications}</a></li>
              <li><a href={url('statistics', lang)}>{t.footerStatistics}</a></li>
            </ul>
          </div>
        </div>
        <div class="col-6 col-md-6 col-xl-2">
          <div class="widget">
            <h4>{t.footerSocial}</h4>
            <SocialIcons
              lang={lang}
              class="social-icons social-icons-colored social-icons-rounded float-left"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
  )}
  <div class="copyright-content">
    <div class="container">
      <div class="copyright-text text-center">
        &copy; {year} {t.copyright}
        <a href="https://www.cloudbe.com.br" target="_blank" rel="noopener">Cloudbe</a>
        <!--
          Revogar tem de ser tao facil quanto consentir, e estar em toda pagina
          — inclusive na 404, que usa `minimo`. Fica na faixa de copyright, que
          o diff visual ja esconde, e nao na lista "Navegacao", onde um <li> a
          mais mudaria a altura do rodape em 39 paginas. Nasce `hidden`: sem
          JavaScript o botao nao faria nada.
        -->
        <span class="cookie-manage" hidden>
          &middot; <button type="button" class="cookie-manage-btn">{t.cookieManage}</button>
        </span>
      </div>
    </div>
  </div>
</footer>
<!-- end: Footer -->
