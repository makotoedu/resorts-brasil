---
import type { LogoParceiro } from '../data/parceiros';

interface Props {
  itens: LogoParceiro[];
  /** Colunas da grade: 5 nas paginas institucionais, 6 em associe-se. */
  colunas: 5 | 6;
}

const { itens, colunas } = Astro.props;

/**
 * Uma faixa de logos (mantenedores, parceiros, descontos).
 *
 * Renderiza so o <ul>: o cabecalho com o rotulo e as colunas do Bootstrap ao
 * redor mudam de pagina para pagina e ficam onde estao. Isso mantem a
 * substituicao contida num bloco balanceado, sem mexer em wrapper.
 */
---

<ul class={`grid grid-${colunas}-columns text-center`}>
  {
    itens.map((item) => (
      <li>
        {item.url ? (
          <a href={item.url} target="_blank" rel="noopener noreferrer">
            <img alt={item.nome} src={item.logo} />
          </a>
        ) : (
          <a>
            <img alt={item.nome} src={item.logo} />
          </a>
        )}
      </li>
    ))
  }
</ul>
