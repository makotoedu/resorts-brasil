---
import Container from '../layout/Container.astro';
import Botao from '../primitivos/Botao.astro';
import Imagem from '../primitivos/Imagem.astro';
import Icone from '../primitivos/Icone.astro';
import IconesSociais from './IconesSociais.astro';
import { ui, url, localeBadge, locales, htmlLang, type Locale, type RouteKey } from '../../i18n/ui';

/**
 * Cabecalho — topbar, logotipo, navegacao e seletor de idioma.
 *
 * POR QUE ELE EXISTE, e por que so na Etapa 5: o catalogo /design monta o
 * proprio documento justamente porque o unico layout de entao trazia cabecalho e
 * rodape do tema. Qualquer
 * pagina de conteudo usa. A primeira delas a receber `legado={false}` ficaria
 * sem estilo nenhum de cabecalho e rodape — nao havia etapa de pagina possivel
 * antes desta. Ver docs/decisoes.md, "Etapa 5".
 *
 * OS NOMES DE ESTADO SAO OS DO TEMA, DE PROPOSITO. `#mainMenu`,
 * `#mainMenu-trigger`, `.p-dropdown`, `.dropdown-active`, `.toggle-active`,
 * `.mainMenu-open` — o src/scripts/site.js e um so e serve as duas camadas
 * durante a migracao. Trocar um nome aqui quebraria o menu das 40 paginas do
 * tema, ou obrigaria a manter dois scripts. E a convencao que o CLAUDE.md ja
 * registrava; aqui ela passa a valer nos dois sentidos.
 *
 * MEDIDO (scripts/medir-cromo.mjs):
 *
 *   topbar     41px de altura (40 + 1px de borda), fundo azul-500, link 12px/500
 *   cabecalho  80px, FUNDO TRANSPARENTE, sem borda e sem sombra
 *   logotipo   240x80 no desktop, 222x74 no mobile — 3:1, e o arquivo e 300x100
 *   menu       13px/600, 0.6px de espacamento, caixa alta, recuo 10px/12px
 *   submenu    branco, 230px, sombra 0 33px 32px rgba(0,0,0,.1), link 12px/500
 *   mobile     link de 14px/600 com 45px de altura, menu de altura de janela
 *
 * TRES DESVIOS DELIBERADOS, todos em docs/deltas-visuais.md:
 *
 *   1. Os floats viram flexbox. O tema empilhava `float: left` no logotipo e
 *      dois `float: right` cuja ordem visual depende da ordem do DOM ao
 *      contrario — nada disso sobrevive a uma leitura.
 *   2. O item destacado deixa de ser dourado sobre azul. `rgb(211,180,4)` sobre
 *      o azul-500 da 2,84:1; branco da 5,80:1. No menu, sobre branco, o ouro
 *      escureceu de #d39e00 (2,42:1) para o ambar-800 (4,96:1) -- e no Soft UI
 *      o "Fale conosco" do menu deixou de ser texto dourado e virou <Botao>,
 *      que em 27/10/2026 voltou ao ambar como fundo, com o navy por cima.
 *   3. O distintivo de idioma (BR/EN/ES) era um `<span>` de 9px posicionado a
 *      `top: -10px` — um expoente. Aqui ele fica na linha do simbolo.
 */
interface Props {
  lang: Locale;
  /**
   * Rota da pagina atual, para o seletor de idioma levar a traducao DESTA
   * pagina. Ausente so na 404, que nao tem traducao — nesse caso cai na home.
   */
  route?: RouteKey;
  /** As tres paginas do ebook nunca tiveram topbar. */
  semTopbar?: boolean;
  /**
   * O cabecalho sobre fundo escuro — o `.dark` das tres paginas do e-book.
   *
   * MEDIDO na Etapa 10 (scripts/medir-ebook.mjs), e ate ali nunca tinha sido: o
   * medir-cromo.mjs da Etapa 5 mede em /historia.html, que e clara. O que muda e
   * so a cor — link de menu e gatilho passam a branco, e o hover deixa de ser o
   * azul de acao (que sumiria sobre o fundo). O tema o fazia virar um cinza
   * claro, medido em rgb(193,195,206); desde o Soft UI o texto fica branco e
   * quem responde e o fundo de estado inverso.
   *
   * O SUBMENU CONTINUA BRANCO. No tema a classe vinha sempre com `submenu-light`
   * ao lado, e medido ele e o mesmo painel claro das outras paginas — o escuro
   * vale para a barra, nao para o que ela abre.
   */
  escuro?: boolean;
}

const { lang, route, semTopbar = false, escuro = false } = Astro.props;
const t = ui[lang];

// Resolvido aqui e nao no template: uma anotacao de tipo com generics dentro do
// markup seria lida como tag JSX pelo parser do Astro.
const outrosIdiomas = locales
  .filter((l) => l !== lang)
  .map((l) => ({
    label: (t.langOther as Record<string, string>)[l],
    href: url(route ?? 'home', l),
    hreflang: htmlLang[l],
  }));

/**
 * O menu, como dado. No tema eram 14 linhas de markup com tres `<li class=
 * "dropdown">` escritos a mao — e cada submenu repetia a mesma estrutura de
 * `<ul class="dropdown-menu">`. Aqui a forma sai do dado.
 */
const menu: { rotulo: string; href?: string; destaque?: boolean; filhos?: { rotulo: string; href: string }[] }[] = [
  { rotulo: t.navHome, href: url('home', lang) },
  {
    rotulo: t.navAbout,
    filhos: [
      { rotulo: t.navResortsBrasil, href: url('resortsBrasil', lang) },
      { rotulo: t.navBoard, href: url('board', lang) },
      { rotulo: t.navHistory, href: url('history', lang) },
    ],
  },
  {
    rotulo: t.navAssociates,
    filhos: [
      { rotulo: t.navAssociatesList, href: url('associates', lang) },
      { rotulo: t.navJoinUs, href: url('joinUs', lang) },
    ],
  },
  {
    rotulo: t.navInformation,
    filhos: [
      { rotulo: t.navPublications, href: url('publications', lang) },
      { rotulo: t.navStatistics, href: url('statistics', lang) },
    ],
  },
  { rotulo: t.navSupport, href: url('support', lang) },
  { rotulo: t.navContact, href: url('contact', lang), destaque: true },
];

/*
 * A PAGINA ATUAL, que o menu nao marcava (achado A18 da revisao de design: o
 * "onde estou?" do Trunk Test). O link dela recebe `aria-current="page"`; o
 * item de primeiro nivel que a contem num submenu recebe a marca visual,
 * porque o filho fica escondido no painel. A 404 nao tem rota, e nada marca.
 */
const atual = route ? url(route, lang) : undefined;
---

{
  !semTopbar && (
    <div id="topbar" class="topbar">
      <Container>
        <div class="topbar-barra">
          <ul class="topbar-menu">
            <li>
              <a href={url('ebook', lang)}>{t.topbarEbook}</a>
            </li>
            <li>
              {/* Branco e semibold no lugar do dourado — ver o desvio 2 acima. */}
              <a class="destaque" href={url('joinUs', lang)}>
                {t.topbarJoin}
              </a>
            </li>
          </ul>
          <IconesSociais lang={lang} superficie="topbar" />
        </div>
      </Container>
    </div>
  )
}

<header id="header" class:list={['cabecalho', escuro && 'escuro']}>
  <Container>
    <div class="barra">
      <div id="logo" class="logo">
        <a href={url('home', lang)}>
          <Imagem
            src="/images/logo-25anos.png"
            alt="Resorts Brasil"
            largura={240}
            altura={80}
            prioridade
            ajuste="conter"
          />
        </a>
      </div>

      <!--
        `#mainMenu` e o gancho que o site.js anima abrindo o menu mobile: ele
        escreve `min-height` inline aqui. Por isso o elemento existe nas duas
        faixas e e o CSS que decide se ele e uma barra ou um painel.
      -->
      <div id="mainMenu" class="menu">
        <nav aria-label={t.navLabel}>
          <ul class="menu-nivel1">
            {
              menu.map((item) =>
                item.filhos ? (
                  <li class:list={['dropdown', item.filhos.some((f) => f.href === atual) && 'contem-atual']}>
                    {/*
                      `<button>` e nao `<a href="#">`: o item so abre um submenu,
                      nao navega. O `href="#"` do tema sujava o historico e
                      punha um destino falso na barra de status.
                    */}
                    <button type="button" class="voz-acao" aria-haspopup="true" aria-expanded="false">
                      {item.rotulo}
                      <Icone nome="chevron-right" tamanho="xs" class="seta" />
                    </button>
                    <ul class="dropdown-menu">
                      {item.filhos.map((filho) => (
                        <li>
                          <a href={filho.href} aria-current={filho.href === atual ? 'page' : undefined}>
                            {filho.rotulo}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ) : (
                  <li class:list={[item.destaque && 'cta']}>
                    {/*
                      O "Fale conosco" e o CTA do menu, e desde o Soft UI ele e
                      um <Botao>: era um link dourado, distinguido so pela cor,
                      e a cor dele tinha de ser escolhida de novo em cada fundo.
                      O ambar voltou em 27/10/2026, agora como superficie: a
                      variante `destaque` traz o fundo e o navy por cima (9,10:1),
                      e um botao cheio nao depende do fundo de quem o contem.
                    */}
                    {item.destaque ? (
                      <Botao
                        href={item.href!}
                        variante="destaque"
                        aria-current={item.href === atual ? 'page' : undefined}
                      >
                        {item.rotulo}
                      </Botao>
                    ) : (
                      <a
                        href={item.href}
                        class="voz-acao"
                        aria-current={item.href === atual ? 'page' : undefined}
                      >
                        {item.rotulo}
                      </a>
                    )}
                  </li>
                )
              )
            }
          </ul>
        </nav>
      </div>

      <div class="extras">
        <div class="p-dropdown">
          <!--
            `<button>` pelo mesmo motivo do submenu. O clique vem do
            `languageDropdown()` do site.js, que se remonta a cada troca de
            corpo; um <script> neste arquivo rodaria uma vez so e morreria na
            primeira navegacao — foi o que aconteceu ate a revisao mobile.
          -->
          <button type="button" aria-label={t.chooseLanguage} aria-haspopup="true" aria-expanded="false">
            <Icone nome="globe" tamanho="sm" />
            <span class="distintivo rotulo">{localeBadge[lang]}</span>
          </button>
          <ul class="p-dropdown-content">
            {
              outrosIdiomas.map((outro) => (
                <li>
                  <a href={outro.href} hreflang={outro.hreflang}>
                    {outro.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>

      <!--
        O gatilho do menu mobile. Continua sendo `<a role="button" tabindex="0">`
        porque e assim que o site.js o encontra e trata Enter/Espaco — a mesma
        decisao registrada no Header do tema. Trocar por <button> aqui exigiria
        um segundo caminho no script durante a migracao.
      -->
      <div id="mainMenu-trigger" class="gatilho">
        <a
          class="lines-button x"
          role="button"
          tabindex="0"
          aria-label={t.openMenu}
          aria-controls="mainMenu"
          aria-expanded="false"><span class="lines"></span></a>
      </div>
    </div>
  </Container>
</header>

<style>
  /*
   * A FAIXA DO MENU E 1200px (75rem), e ela e escrita a mao aqui.
   *
   * Ate a revisao de design ela era 992px, a faixa do BOOTSTRAP que o tema usava
   * para trocar o menu de barra por painel. E 992 era pouco. Medido com uma
   * sonda que procura a menor largura em que logotipo, menu e seletor de
   * idioma cabem numa linha: 1088px em portugues, 1072 em ingles, 1152 em
   * espanhol. Entre 992 e esses numeros o seletor de idioma caia para baixo do
   * logotipo (pt, en) ou o menu inteiro descia (es) -- e 1024px e o iPad na
   * horizontal. Nenhum portao via: nao ha sobreposicao nem transbordo, so
   * quebra de linha (achado A17). 1200 e a faixa `xl` do proprio site, e deixa
   * 48px de folga no pior idioma.
   *
   * A TOPBAR FICA EM 992px. Ela e uma faixa propria, sem disputa de largura, e
   * leva o "Seja um associado" que o painel nao tem; tira-la junto tiraria o
   * link do iPad horizontal sem ganho nenhum.
   *
   * Ela nao pode virar token porque media query nao aceita `var()`. O mesmo
   * 1200 esta no `site.js`, que compara `window.innerWidth >= 1200` ao fechar o
   * menu no redimensionamento; os dois mudam juntos ou o script descasa do CSS
   * -- o erro que este projeto ja pagou com 22 comparacoes de tablet
   * reprovadas.
   */

  /* ---------------- topbar ---------------- */

  .topbar {
    display: none;
    background-color: var(--color-acao-primaria);
    border-bottom: 1px solid var(--color-borda-inversa);
    color: var(--color-texto-inverso);
  }

  @media (min-width: 62rem) {
    .topbar {
      display: block;
    }
  }

  .topbar-barra {
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* MEDIDO: 40px de altura util, mais o 1px da borda = os 41 do tema. */
    min-height: 2.5rem;
  }

  .topbar-menu {
    display: flex;
    align-items: center;
    gap: 1rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .topbar-menu a {
    /* MEDIDO: 12px / 500, branco. */
    color: var(--color-texto-inverso);
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    line-height: 2.5rem;
    text-decoration: none;
    transition: opacity var(--duracao) var(--ease-chegada);
    /* O alvo e a faixa: inline, o link media os 17px do texto numa linha de 40,
       e a topbar so existe a partir de 992px — onde ha iPad deitado, com toque. */
    display: inline-block;
    vertical-align: top;
  }

  /* O destaque que era dourado. Ver o desvio 2 no comentario do topo. */
  .topbar-menu .destaque {
    font-weight: var(--font-weight-semibold);
  }

  .topbar-menu a:hover {
    opacity: 0.75;
  }

  /* ---------------- cabecalho ---------------- */

  /*
   * MEDIDO, e vale a pena registrar porque contraria a expectativa: o cabecalho
   * NAO tem fundo, borda nem sombra. Ele e transparente sobre o que vier abaixo,
   * e as paginas com hero contam com isso.
   */
  .cabecalho {
    position: relative;
    background-color: transparent;
    z-index: 199;
    /*
     * OS PARES DE ESTADO DO MENU, num lugar so. A variacao escura troca os
     * VALORES, e nao as regras: na primeira versao do Soft UI cada regra de
     * estado tinha uma copia `.escuro ...`, e como o Astro carimba o atributo
     * de escopo em cada parte de cada seletor, o CSS do cabecalho cresceu 4 KB
     * e reprovou o orcamento nas paginas leves. O painel branco do submenu
     * devolve os valores claros, nas duas variacoes.
     */
    --menu-texto: var(--color-texto);
    --menu-hover: var(--color-estado-hover);
    --menu-atual: var(--color-estado-atual);
    --menu-atual-texto: var(--color-link);
    --menu-subitem: var(--color-texto);
    --menu-fio: var(--color-borda-suave);
  }

  .barra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    /* MEDIDO: 80px. `min-height` e nao `height` porque abaixo de 1200px o menu
       aberto entra como segunda linha desta mesma caixa e ela precisa crescer. */
    min-height: 5rem;
  }

  .logo {
    order: 1;
    flex: none;
    line-height: 0; /* sem isto o `inline` da imagem deixa um vao sob o logotipo */
  }

  .logo :global(img) {
    /* MEDIDO: 240x80 no desktop. O arquivo e 300x100 — a mesma proporcao 3:1. */
    width: auto;
    height: 3.5rem;
  }

  /*
   * ABAIXO DE 22rem, 48px. A barra soma logotipo 168 + vao 8 + idioma 61 +
   * vao 8 + hamburguer 44 = 289px, e a 320 o conteudo tem 280: o hamburguer
   * descia para uma segunda linha, a barra ia de 80 para 116px e, no e-book,
   * onde o cabecalho e `absolute`, ficava em cima do h1. Medido: quebrava a
   * partir de 329px nos tres idiomas. Com 144px de logotipo sobram 17 a 320.
   * 320 CSS px e a largura do reflow do WCAG (1.4.10), nao um celular exotico.
   */
  @media (max-width: 21.9375rem) {
    .logo :global(img) {
      height: 3rem;
    }
  }

  @media (min-width: 75rem) {
    .logo :global(img) {
      height: 5rem;
    }
  }

  .extras {
    order: 2;
    margin-left: auto;
  }

  @media (min-width: 75rem) {
    .extras {
      order: 3;
      margin-left: 0;
    }
  }

  /* ---------------- navegacao ---------------- */

  /*
   * O SOFT UI DEU CORPO AO MENU (docs/decisoes.md, "Soft UI"). Ate ali o item
   * era texto azul no hover e sublinhado na pagina atual: nenhuma superficie.
   * Agora todo controle do cabecalho -- item, item de submenu, seletor de
   * idioma, hamburguer -- responde com um FUNDO no raio `sm`, e a pagina atual
   * e esse fundo no azul da acao. Os paineis que abrem (submenu, idioma) sao
   * superficies `md` com a `--shadow-3`.
   *
   * O MOVIMENTO SEGUE A SKILL: entrada em `--duracao` desacelerando, saida em
   * `--duracao-curta` acelerando ("exit-faster-than-enter"). A transicao vale
   * para o estado de DESTINO, entao a regra de repouso guarda a saida e a de
   * aberto guarda a entrada.
   */

  .menu {
    /*
     * Abaixo de 1200px o menu e um painel que ocupa a segunda linha da barra, e
     * quem o abre e o site.js escrevendo `min-height` inline.
     *
     * `height: 0` E `overflow: hidden` juntos, e o par nao e redundante: o
     * script escreve `min-height`, nunca `height`. Com altura zero declarada
     * aqui, a altura usada e o maior dos dois — 0 fechado, do topo dele ate a
     * dobra aberto —, e a transicao de `min-height` que ele configura tem o que
     * animar. So `overflow: hidden` deixaria o menu aberto o tempo todo, porque
     * altura automatica cresce com o conteudo.
     */
    order: 4;
    flex-basis: 100%;
    height: 0;
    overflow: hidden;
  }

  /*
   * ABERTO, O PAINEL ROLA. O site.js o faz terminar na dobra e trava o `body`,
   * entao o que nao cabe so se alcanca por aqui: em 740x360 o "Fale conosco"
   * ja nao cabia com tudo fechado, e a 320x568 bastava abrir um submenu. A
   * `.menu-animate` entra 300ms depois de abrir, e por isso a barra de rolagem
   * nao pisca durante a animacao da altura.
   */
  @media (max-width: 74.9375rem) {
    .menu.menu-animate {
      overflow-y: auto;
      overscroll-behavior: contain;
    }
  }

  @media (min-width: 75rem) {
    .menu {
      order: 2;
      flex: 1;
      flex-basis: auto;
      height: auto;
      overflow: visible;
    }
  }

  .menu-nivel1 {
    display: flex;
    flex-direction: column;
    /* 2px entre as linhas do painel: o fundo de hover de uma nao encosta no
       da vizinha. */
    gap: 0.125rem;
    list-style: none;
    margin: 0;
    padding: 0.5rem 0 1.5rem;
  }

  @media (min-width: 75rem) {
    .menu-nivel1 {
      flex-direction: row;
      align-items: center;
      justify-content: flex-end;
      gap: 0.25rem;
      padding: 0;
    }
  }

  /*
   * O item de primeiro nivel. `<a>` e `<button>` compartilham tudo: o botao so
   * existe onde o item abre submenu em vez de navegar, e visualmente eles tem de
   * ser indistinguiveis.
   *
   * O CTA E EXCLUIDO A MAO, com `:not(.botao)`, e a razao contraria a
   * armadilha 1 do CLAUDE.md. O `<a>` do <Botao> nasce em outro componente,
   * mas o Astro passa o atributo de escopo DESTE arquivo como prop ao filho, e
   * o <Botao> espalha `{...resto}` na raiz -- entao o `<a>` dele sai com o
   * `data-astro-cid` do cabecalho, e estas regras casariam nele. Sem a
   * exclusao, o "Fale conosco" saia branco com texto navy, o fundo
   * transparente do item vencendo o azul da variante.
   */
  .menu-nivel1 > li > a:not(.botao),
  .menu-nivel1 > li > button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.375rem;
    width: 100%;
    /* No painel, linhas de 48px: 20 de linha e 14 de cada lado. Era 45px no
       tema, e o alvo de toque pede 44. */
    padding: 0.875rem 0.75rem;
    background-color: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--menu-texto);
    /* A voz e a `.voz-acao`, a mesma nas duas faixas e a mesma do botao. O
       tema usava 14px no celular e 13px no desktop, com 0,6px de espacamento;
       a revisao de design unificou no `.rotulo`, e o Soft UI tirou a caixa
       alta. A largura que isso muda e vigiada pelo verify-behaviors, em 1200px
       e nos tres idiomas. */
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition:
      background-color var(--duracao) var(--ease-chegada),
      color var(--duracao) var(--ease-chegada);
  }

  @media (min-width: 75rem) {
    .menu-nivel1 > li > a:not(.botao),
    .menu-nivel1 > li > button {
      justify-content: flex-start;
      width: auto;
      /* Na barra, 44px: 20 de linha e 12 de cada lado -- a altura do <Botao>
         `md` do CTA ao lado, entao a fileira inteira tem uma altura so. */
      padding: 0.75rem;
    }
  }

  .menu-nivel1 > li > a:not(.botao):hover,
  .menu-nivel1 > li > button:hover,
  .dropdown.submenu-aberto > button {
    background-color: var(--menu-hover);
  }

  @media (min-width: 75rem) {
    /* O item continua aceso enquanto o painel dele esta aberto: o mouse saiu
       do botao para o submenu, mas a origem do painel tem de seguir legivel. */
    .dropdown:hover > button,
    .dropdown:focus-within > button {
      background-color: var(--menu-hover);
    }
  }

  /*
   * A PAGINA ATUAL E UM FUNDO NO AZUL DA ACAO, e deixou de ser o sublinhado de
   * 2px. O sublinhado foi escolhido na revisao de design justamente para nao
   * criar um par de cor novo em cada fundo onde o menu aparece (a sexta
   * armadilha do CLAUDE.md). O Soft UI cria o par, e por isso ele foi medido em
   * cada fundo -- ver o decisoes.md, secao "Soft UI": o azul-500 sobre o fundo
   * de estado, por cima do branco do body e do painel, da 4,99:1.
   */
  .menu-nivel1 > li > a:not(.botao)[aria-current='page'],
  .menu-nivel1 > li.contem-atual > button {
    background-color: var(--menu-atual);
    color: var(--menu-atual-texto);
  }

  /*
   * A seta do submenu aponta para baixo — o glifo do sistema e o chevron para a
   * direita, girado, que e como o proprio tema desenhava o dele. Aberto, ela
   * aponta para cima.
   *
   * `:global` porque o `<svg>` nasce dentro do <Icone>, e estilo com escopo so
   * alcanca elemento do proprio template. Mesmo motivo do `.foto` no
   * CartaoMembro.
   */
  .menu-nivel1 :global(.seta) {
    /* O tamanho e o `xs` do <Icone>, 12px; ate a revisao de design esta regra
       forcava 10px por cima do primitivo. */
    transform: rotate(90deg);
    transition: transform var(--duracao) var(--ease-chegada);
  }

  .dropdown.submenu-aberto > button :global(.seta) {
    transform: rotate(-90deg);
  }

  @media (min-width: 75rem) {
    .dropdown:hover > button :global(.seta),
    .dropdown:focus-within > button :global(.seta) {
      transform: rotate(-90deg);
    }
  }

  /*
   * O CTA. No painel ele fecha a lista separado dos itens, em largura total so
   * no celular; na barra ele fica na fileira, com um respiro a mais que o vao
   * entre itens. `:global` no `.botao` porque o `<a>` e do <Botao>.
   */
  .cta {
    margin-top: 0.75rem;
  }

  /* Largura total so no celular: no painel do tablet, um botao de 960px pesava
     mais que a lista inteira acima dele. */
  @media (max-width: 47.9375rem) {
    .cta > :global(.botao) {
      display: block;
      width: 100%;
    }
  }

  @media (min-width: 75rem) {
    .cta {
      margin: 0 0 0 0.5rem;
    }
  }

  /* ---------------- submenu ---------------- */

  /*
   * Abaixo de 1200px o submenu abre no toque, como uma sanfona: recuado, com um
   * fio a esquerda que o amarra ao item de onde saiu. Fechado ele nao existe --
   * o tema deixava os 11 itens visiveis de uma vez.
   */
  .dropdown-menu {
    display: none;
    list-style: none;
    margin: 0.125rem 0 0.375rem 1.25rem;
    padding: 0 0 0 0.5rem;
    border-left: 2px solid var(--menu-fio);
  }

  .dropdown.submenu-aberto > .dropdown-menu {
    display: block;
  }

  @media (min-width: 75rem) {
    .dropdown {
      position: relative;
    }

    .dropdown-menu {
      position: absolute;
      /* 8px abaixo do item: o painel flutua, nao encosta. A ponte do `::before`
         cobre o vao, senao o mouse que desce do item para o painel atravessaria
         8px de nada e o `:hover` cairia no caminho. */
      top: calc(100% + 0.5rem);
      left: 0;
      /* MEDIDO: 230px de largura, a do tema. */
      min-width: 14.375rem;
      margin: 0;
      padding: 0.5rem;
      background-color: var(--color-superficie);
      border: 1px solid var(--color-borda-suave);
      border-radius: var(--radius-md);
      box-shadow: var(--shadow-3);
      /* O painel e branco nas duas variacoes: os pares claros de volta. */
      --menu-texto: var(--color-texto);
      --menu-hover: var(--color-estado-hover);
      --menu-atual: var(--color-estado-atual);
      --menu-atual-texto: var(--color-link);
      --menu-subitem: var(--color-texto);
      /*
       * `visibility` junto de `opacity`, e nao `display`: so assim a abertura
       * pode ser animada, e so assim o submenu fechado sai da ordem de
       * tabulacao. `display: none` faria as duas coisas de uma vez e sem
       * transicao.
       */
      display: block;
      opacity: 0;
      visibility: hidden;
      transform: translateY(-0.25rem);
      transition:
        opacity var(--duracao-curta) var(--ease-partida),
        transform var(--duracao-curta) var(--ease-partida),
        visibility var(--duracao-curta);
    }

    .dropdown-menu::before {
      content: '';
      position: absolute;
      inset-inline: 0;
      bottom: 100%;
      height: 0.5rem;
    }

    /*
     * `:focus-within` ao lado de `:hover` desde a primeira linha. No tema o
     * submenu abria so no hover, e quem navega por teclado ficava sem os seis
     * destinos que so existem la dentro — a correcao que o ajustes.css teve de
     * fazer depois, aqui ja nasce feita.
     */
    .dropdown:hover > .dropdown-menu,
    .dropdown:focus-within > .dropdown-menu {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      transition-duration: var(--duracao);
      transition-timing-function: var(--ease-chegada);
    }
  }

  /*
   * O link do submenu, nas duas faixas: 44px de alvo (20 de linha e 12 de cada
   * lado), 14px em 500. MEDIDO no tema em 12px/500 e #444, consolidado no cinza
   * de paragrafo na Etapa 5; o Soft UI o leva ao navy do texto, porque agora ha
   * um fundo de hover para distinguir o item, e o cinza so apagava o painel.
   */
  .dropdown-menu a {
    display: block;
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--menu-subitem);
    font-size: var(--text-sm);
    line-height: 1.25rem;
    font-weight: var(--font-weight-medium);
    text-decoration: none;
    text-transform: none;
    transition:
      background-color var(--duracao) var(--ease-chegada),
      color var(--duracao) var(--ease-chegada);
  }

  .dropdown-menu a:hover {
    background-color: var(--menu-hover);
    color: var(--menu-texto);
  }

  .dropdown-menu a[aria-current='page'] {
    background-color: var(--menu-atual);
    color: var(--menu-atual-texto);
  }

  /* ---------------- seletor de idioma ---------------- */

  .p-dropdown {
    position: relative;
  }

  .p-dropdown > button {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    /* 44px de altura, o alvo de toque; media 36. */
    min-height: 2.75rem;
    padding: 0.5rem 0.625rem;
    background-color: transparent;
    border: 0;
    border-radius: var(--radius-sm);
    color: var(--menu-texto);
    font-family: inherit;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-medium);
    cursor: pointer;
    transition: background-color var(--duracao) var(--ease-chegada);
  }

  .p-dropdown > button:hover,
  .p-dropdown.dropdown-active > button {
    background-color: var(--menu-hover);
  }

  /* O painel do idioma e o mesmo do submenu: superficie `md`, fio, sombra 3,
     a mesma entrada e a mesma saida. */
  .p-dropdown-content {
    position: absolute;
    top: calc(100% + 0.5rem);
    /* Ancorado a direita: no tema ele era centralizado por um `left` negativo
       calculado, e transbordava a janela no mobile. */
    right: 0;
    z-index: 5;
    /* MEDIDO: 147px, a largura do tema. */
    min-width: 9.1875rem;
    padding: 0.5rem;
    background-color: var(--color-superficie);
    border: 1px solid var(--color-borda-suave);
    border-radius: var(--radius-md);
    box-shadow: var(--shadow-3);
    list-style: none;
    margin: 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(-0.25rem);
    transition:
      opacity var(--duracao-curta) var(--ease-partida),
      transform var(--duracao-curta) var(--ease-partida),
      visibility var(--duracao-curta);
  }

  /* So a classe abre, e nao `:focus-within`: no toque o foco fica no botao, e o
     segundo toque tirava a classe com o painel ainda aberto. O teclado continua
     servido — Enter e Espaco no `<button>` sao clique, e o site.js fecha quando
     o foco sai do painel. */
  .p-dropdown.dropdown-active > .p-dropdown-content {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-duration: var(--duracao);
    transition-timing-function: var(--ease-chegada);
  }

  .p-dropdown-content a {
    display: block;
    /* 44px, como o item do submenu. Era 26px de entrelinha no tema. */
    padding: 0.75rem;
    border-radius: var(--radius-sm);
    color: var(--color-texto);
    font-size: var(--text-sm);
    line-height: 1.25rem;
    text-decoration: none;
    transition: background-color var(--duracao) var(--ease-chegada);
  }

  .p-dropdown-content a:hover {
    background-color: var(--color-estado-hover);
  }

  /* ---------------- gatilho do menu mobile ---------------- */

  .gatilho {
    order: 3;
    display: flex;
    align-items: center;
  }

  @media (min-width: 75rem) {
    .gatilho {
      display: none;
    }
  }

  /* MEDIDO: area de 20x80 com tres barras de 20x2. A area de toque util ficava
     abaixo dos 44px recomendados no tema; o recuo lateral daqui a completa sem
     mover a barra. O fundo de estado e o mesmo dos itens. */
  .lines-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: var(--radius-sm);
    cursor: pointer;
    transition: background-color var(--duracao) var(--ease-chegada);
  }

  .lines-button:hover,
  .lines-button.toggle-active {
    background-color: var(--menu-hover);
  }

  .lines,
  .lines::before,
  .lines::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background-color: var(--menu-texto);
    border-radius: var(--radius-full);
    transition:
      transform var(--duracao) var(--ease-chegada),
      opacity var(--duracao) var(--ease-chegada);
  }

  .lines {
    position: relative;
  }

  .lines::before,
  .lines::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .lines::before {
    top: -0.375rem;
  }

  .lines::after {
    top: 0.375rem;
  }

  /*
   * `.toggle-active` e escrita pelo site.js — e o mesmo nome de estado do tema,
   * e e por isso que um script serve as duas camadas. As tres barras viram X.
   */
  .lines-button.toggle-active .lines {
    background-color: transparent;
  }

  .lines-button.toggle-active .lines::before {
    top: 0;
    transform: rotate(45deg);
  }

  .lines-button.toggle-active .lines::after {
    top: 0;
    transform: rotate(-45deg);
  }

  /* ---------------- cabecalho escuro ---------------- */

  /*
   * ELE FLUTUA SOBRE O CONTEUDO, e essa e a metade da variacao que quase passou.
   *
   * O cabecalho e transparente — medido, e vale para as 41 paginas. Nas 38
   * claras isso nao aparece, porque o fundo do <body> tambem e claro e o texto
   * do menu e escuro. Aqui o texto e BRANCO: sem a foto do e-book atras dele, o
   * menu inteiro fica branco sobre branco. Foi exatamente o que aconteceu na
   * primeira versao desta etapa, e nenhum dos quatro portoes viu — as caixas
   * estao certas, o contraste medido pelo verifica-sistema compara pares de
   * TOKEN e nao token contra a superficie que calhou de estar embaixo.
   *
   * O tema resolvia com `margin-top: -80px` no <main> (public/css/ajustes.css),
   * puxando a pagina para tras do cabecalho — e com -120px quando havia topbar,
   * um segundo numero para manter sincronizado. Aqui quem sai do fluxo e o
   * cabecalho, que e o elemento que de fato flutua. Um numero em vez de dois, e
   * ele nao depende de quem vem depois.
   */
  .escuro {
    position: absolute;
    inset-inline: 0;
    top: 0;
  }

  /*
   * E FLUTUAR TEM UM PRECO NO MOBILE, que so aparece com o menu ABERTO.
   *
   * Abaixo de 1200px o menu e um painel que ocupa a segunda linha da barra, e o
   * site.js lhe da a altura da janela. No cromo claro o cabecalho esta no fluxo:
   * o painel EMPURRA a pagina para baixo e se le sobre o branco do <body>. Aqui
   * o cabecalho e absoluto, entao o painel se sobrepoe ao hero — os seis itens
   * do menu ficam impressos por cima do titulo, e nenhum dos dois se le.
   *
   * O fundo so existe enquanto `.mainMenu-open` esta no <body>, que e o mesmo
   * nome de estado que o site.js ja escreve nas duas camadas. Em repouso o
   * cabecalho continua transparente sobre a foto, que e o desenho da pagina.
   *
   * Isto nao aparece em captura de pagina parada nem em nenhum dos quatro
   * portoes: a geometria mede caixas, e as caixas estao certas. Apareceu abrindo
   * o menu.
   */
  :global(body.mainMenu-open) .escuro {
    background-color: var(--color-ebook-superficie);
  }

  /*
   * A variacao de COR das tres paginas do e-book, MEDIDA na Etapa 10. Caixa,
   * recuo e faixa continuam sendo os mesmos de cima; o que muda sao os pares
   * de estado declarados no `.cabecalho`, e por isso ela e um bloco de valores
   * em vez de um segundo jogo de regras.
   *
   * O HOVER NUNCA FOI O AZUL DE ACAO aqui: sobre o carvao o azul-500 da 3,0:1.
   * O tema clareava o texto para um cinza (rgb(193,195,206)); o Soft UI mantem
   * o texto branco e acende o FUNDO, com os pares inversos dos tokens de
   * estado -- branco translucido, que sobre o carvao e sobre a foto com veu so
   * clareia o que ja estava atras do texto branco. Medido sobre a foto, o pior
   * item da 13,5:1 (docs/decisoes.md, "Soft UI").
   *
   * O SUBITEM DO PAINEL MOBILE e o cinza sutil, e nao o navy: abaixo de 1200px
   * o submenu nao tem fundo proprio e herda o carvao, e ali o navy sumiria. O
   * cinza de paragrafo que ele usava ate o Soft UI dava 2,86:1; o sutil, 7,19.
   * Acima de 1200px o painel e branco e devolve os pares claros (ver a regra
   * do submenu), entao a troca so vale onde o fundo e o carvao.
   */
  .escuro {
    --menu-texto: var(--color-texto-inverso);
    --menu-hover: var(--color-estado-hover-inverso);
    --menu-atual: var(--color-estado-atual-inverso);
    --menu-atual-texto: var(--color-texto-inverso);
    --menu-subitem: var(--color-texto-sutil-inverso);
    --menu-fio: var(--color-borda-inversa);
  }

  /*
   * O painel do menu mobile abre SOBRE a pagina, e abaixo de 1200px ele nao tem
   * fundo proprio — no cromo claro isso funciona porque a pagina tambem e clara.
   * Aqui o fundo do e-book ja e escuro e o texto branco continua legivel, entao
   * nao ha nada a acrescentar. A nota fica porque foi verificado, e nao suposto.
   */

  /* O fundo nao rola atras do painel aberto. `:global` porque o <body> nao e
     deste componente. */
  :global(body.mainMenu-open) {
    overflow: hidden;
  }
</style>
