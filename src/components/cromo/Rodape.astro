---
import Container from '../layout/Container.astro';
import Grade from '../layout/Grade.astro';
import Imagem from '../primitivos/Imagem.astro';
import Titulo from '../primitivos/Titulo.astro';
import IconesSociais from './IconesSociais.astro';
import { contato } from '../../data/contato';
import { ui, url, type Locale } from '../../i18n/ui';

/**
 * Rodape — a marca, tres listas de navegacao, o contato e a faixa de baixo.
 *
 * MEDIDO (scripts/medir-cromo.mjs):
 *
 *   fundo        rgb(249,249,250) — consolidado na nevoa-50 do sistema, que e
 *                rgb(247,249,252): dois pontos de distancia e portanto ruido
 *   conteudo     60px de recuo em cima, 40px embaixo
 *   titulo       14px / 600 / 1px de espacamento / caixa alta / 20px ate a lista
 *   item         entrelinha de 32px, link 14px no cinza de paragrafo
 *   hover        cor de acao — medido com o mouse em cima
 *   copyright    faixa propria em rgb(241,241,243), 30px de recuo, texto de 13px
 *
 * DOIS DESVIOS DELIBERADOS, em docs/deltas-visuais.md:
 *
 *   1. O logotipo deixa de ser ampliado. O tema o exibia a 390x130 a partir de
 *      um arquivo de 300x100 — 1,3x de ampliacao, e um logotipo borrado e a
 *      unica imagem do site que ninguem pode consertar depois.
 *   2. Os titulos das listas viram `<h2>`. Eram `<h4>` sem nenhum `<h3>` acima,
 *      em todas as paginas — parte dos 39 sumarios quebrados que a migracao
 *      existe para consertar.
 *
 * REORGANIZADO EM 22/10/2026, e o que mudou e o CONTEUDO, nao a voz. As listas
 * vinham do tema e tinham divergido do menu: "Sobre nos" e "Resorts Brasil"
 * apontavam para a mesma pagina, uma ao lado da outra; Associe-se e o e-book,
 * que o cabecalho oferece em toda pagina, nao estavam aqui; e o rodape nao
 * tinha um unico dado de contato, embora src/data/contato.ts exista para isso.
 *
 *   - as tres listas espelham os grupos do menu e usam os rotulos dele;
 *   - a coluna de contato le src/data/contato.ts, a mesma fonte da pagina de
 *     contato e do JSON-LD;
 *   - a marca ganha a frase da associacao, e as redes saem da coluna propria
 *     para debaixo dela;
 *   - privacidade e termos descem para a faixa de baixo, que e onde se procura
 *     documento juridico, e por isso chegam tambem a 404 (`minimo`);
 *   - a faixa deixa de dizer "...reservados. by Cloudbe": o credito da agencia
 *     estava em ingles nos tres idiomas, depois de um ponto final.
 *
 * ENXUGADO EM 27/10/2026, a pedido: a frase da associacao saiu de baixo da
 * marca, o nome por extenso saiu da linha de copyright, o endereco ficou sem
 * sala e sem CEP (`linhasCurtas`) e o WhatsApp ficou so com o numero.
 *
 * Ver docs/decisoes.md, "Fale conosco por assunto, e o rodape reorganizado".
 */
interface Props {
  lang: Locale;
  /** Só a faixa de baixo, sem as listas. É o rodapé que a 404 sempre teve. */
  minimo?: boolean;
  /**
   * O rodape escuro das tres paginas do e-book — o `.inverted` do tema.
   *
   * MEDIDO na Etapa 10, e ate ali nunca tinha sido: o medir-cromo.mjs mede em
   * /historia.html, que usa o rodape claro. A medicao encontrou o pior conjunto
   * de contraste do site inteiro, e ele esta em producao ha anos — ver a nota
   * das cores no <style> abaixo.
   */
  invertido?: boolean;
}

const { lang, minimo = false, invertido = false } = Astro.props;
const t = ui[lang];

// Resolvido no build. Antes o ano vinha de document.write() nas home e estava
// fixo em "2022" nas 12 paginas internas em PT.
const ano = new Date().getFullYear();

/** As tres listas, como dado, nos grupos e com os rotulos do menu. */
const colunas: { titulo: string; itens: { rotulo: string; href: string }[] }[] = [
  {
    titulo: t.navAbout,
    itens: [
      { rotulo: t.navResortsBrasil, href: url('resortsBrasil', lang) },
      { rotulo: t.navBoard, href: url('board', lang) },
      { rotulo: t.navHistory, href: url('history', lang) },
    ],
  },
  {
    titulo: t.navAssociates,
    itens: [
      { rotulo: t.navAssociatesList, href: url('associates', lang) },
      { rotulo: t.navJoinUs, href: url('joinUs', lang) },
      { rotulo: t.navSupport, href: url('support', lang) },
    ],
  },
  {
    titulo: t.navInformation,
    itens: [
      { rotulo: t.navPublications, href: url('publications', lang) },
      { rotulo: t.footerStatistics, href: url('statistics', lang) },
      { rotulo: t.footerEbook, href: url('ebook', lang) },
    ],
  },
];

/* O e-mail quebra depois da arroba, e so se precisar: a coluna mede 165px no
   celular. Ver a nota do <PaginaContato>. A 320 ela mede 115, menos que o
   dominio inteiro, e o `wrap-anywhere` partia "resortsbrasil.co|m.br"; o
   segundo ponto de quebra fica antes do primeiro ponto do dominio. */
const [usuario, dominio] = contato.email.split('@');
const [marcaDominio, ...restoDominio] = dominio.split('.');
const sufixoDominio = restoDominio.length ? `.${restoDominio.join('.')}` : '';

/*
 * O telefone pode quebrar entre "+55 11" e o resto, que e onde se agrupa um
 * numero falado, e nunca no hifen: a 900px ele saia "95058-" numa linha e
 * "0313" na outra. A primeira versao protegia o numero inteiro, e a geometria
 * reprovou -- no rodape de demonstracao do catalogo, no celular, "+55 11
 * 95058-0313" mede 123px num item de 110, o mesmo que uma tela de 320px faria.
 *
 * O e-mail e o telefone levam tambem o `wrap-anywhere`, a rede de baixo para
 * quando nem o dominio cabe. Foi um e-mail vazando da coluna que fez a
 * varredura de geometria aprender a ver texto.
 *
 * O numero aparece sozinho, sem "WhatsApp" na frente. O nome do canal fica no
 * nome acessivel, num `.sr-only` DEPOIS do numero: quem ouve o link precisa
 * saber que ele abre o WhatsApp e nao uma chamada, e o texto visivel continua
 * sendo o comeco do nome (o criterio 2.5.3, de quem navega por voz).
 */
const partesWhatsapp = contato.whatsapp.telefone.split(' ');
const fimWhatsapp = partesWhatsapp.pop();
const inicioWhatsapp = partesWhatsapp.join(' ');
---

<footer id="footer" class:list={['rodape', invertido && 'invertido superficie-inversa']}>
  {
    !minimo && (
      <div class="conteudo">
        <Container>
          <!--
            Dois niveis: a marca e, ao lado dela a partir de 1200px, as quatro
            listas numa <Grade> propria, que desce para duas colunas sozinha.

            Eram seis colunas numa grade so, com a marca em duas (os 4+2+2+2+2 de
            doze do tema). Com tres listas aquilo bastava; com a coluna de
            contato, a grade de seis valia a partir de 826px de janela, e ali cada
            coluna media uns 100px -- o e-mail quebrava em tres pedacos e o
            telefone em dois. A proporcao larga continua a mesma, um terco para a
            marca.
          -->
          <div class="colunas-rodape">
            <div class="celula-marca">
              <a href={url('home', lang)} class="marca">
                <Imagem src="/images/logo-25anos.png" alt="Resorts Brasil" largura={240} altura={80} ajuste="conter" />
              </a>
              <IconesSociais lang={lang} superficie="rodape" />
            </div>

            <Grade colunas={4} espaco="md" alinhamento="inicio">
              {colunas.map((coluna) => (
                <div>
                  <Titulo nivel={2} class="titulo-lista rotulo">
                    {coluna.titulo}
                  </Titulo>
                  <ul class="lista">
                    {coluna.itens.map((item) => (
                      <li>
                        <a href={item.href}>{item.rotulo}</a>
                      </li>
                    ))}
                  </ul>
                </div>
              ))}

              <div>
                <Titulo nivel={2} class="titulo-lista rotulo">
                  {t.footerContact}
                </Titulo>
                <ul class="lista contato">
                  <li>
                    <a href={`mailto:${contato.email}`} class="wrap-anywhere">
                      {usuario}@<wbr />{marcaDominio}<wbr />{sufixoDominio}
                    </a>
                  </li>
                  <li>
                    <a href={contato.whatsapp.link} target="_blank" rel="noopener noreferrer" class="wrap-anywhere">
                      {inicioWhatsapp}{' '}
                      <span class="whitespace-nowrap">{fimWhatsapp}</span>
                      <span class="sr-only">{` (${t.contactWhatsappTitle})`}</span>
                    </a>
                  </li>
                  <li>
                    <address>
                      {contato.endereco.linhasCurtas.map((linha, i) => (
                        <>
                          {i > 0 && <br />}
                          {linha}
                        </>
                      ))}
                    </address>
                  </li>
                  <li>
                    <a href={url('contact', lang)}>{t.navContact}</a>
                  </li>
                </ul>
              </div>
            </Grade>
          </div>
        </Container>
      </div>
    )
  }

  <div class="copyright">
    <Container>
      <div class="faixa">
        <p class="copyright-texto">&copy; {ano} {t.copyright}</p>
        <ul class="legal">
          <li>
            <a href={url('privacy', lang)}>{t.footerPrivacy}</a>
          </li>
          <li>
            <a href={url('terms', lang)}>{t.footerTerms}</a>
          </li>
          <!--
            Revogar tem de ser tao facil quanto consentir, e estar em toda pagina
            — inclusive na 404, que usa `minimo`. Por isso mora nesta faixa, e
            nao nas listas. Nasce `hidden`: sem JavaScript o botao nao faria
            nada, e quem o revela e o site.js, pela classe `.cookie-manage`.
          -->
          <li class="cookie-manage" hidden>
            <button type="button" class="cookie-manage-btn">{t.cookieManage}</button>
          </li>
          <li class="credito">
            {t.footerCredit}{' '}
            <a href="https://www.cloudbe.com.br" target="_blank" rel="noopener">Cloudbe</a>
          </li>
        </ul>
      </div>
    </Container>
  </div>
</footer>

<style>
  /*
   * AS CORES DO RODAPE SAO PROPRIEDADES, e a variacao invertida troca os
   * valores, nao as regras. A primeira versao da reorganizacao escrevia cada
   * cor duas vezes, a segunda com `.invertido` na frente -- e o Astro carimba o
   * atributo de escopo em cada parte de cada seletor. O CSS do rodape foi de
   * 2.881 para 4.506 bytes, numa folha que as 41 paginas baixam, e as tres
   * mais leves passaram dos 5% do orcamento. E a mesma licao que o menu
   * escuro do Soft UI ja tinha deixado no decisoes.md.
   */
  .rodape {
    --rodape-fundo: var(--color-superficie-clara);
    --rodape-faixa: var(--color-superficie-clara-alt);
    --rodape-titulo: var(--color-texto);
    --rodape-texto: var(--color-texto);
    --rodape-link: var(--color-texto-paragrafo);
    --rodape-hover: var(--color-acao-primaria);
    background-color: var(--rodape-fundo);
  }

  /*
   * O rodape das tres paginas do e-book. MEDIDO na Etapa 10, e o que a medicao
   * encontrou e o PIOR CONJUNTO DE CONTRASTE DO SITE — pior que os dois que as
   * Etapas 3 e 5 corrigiram, e em producao ha anos:
   *
   *   elemento                     tema        aqui
   *   ---------------------------  ----------  ----------------------------
   *   fundo                        #0e121d     o mesmo (superficie-inversa-alt)
   *   titulo das listas            3,69:1      branco, 18,7:1
   *   os 12 links de navegacao     2,86:1      texto-sutil, 7,1:1
   *   hover do link                3,22:1      branco, 18,7:1
   *   faixa de copyright (fundo)   #10141e     carvao-750, dois pontos, consolidado
   *   a LINHA DE COPYRIGHT         1,23:1      texto-sutil, 7,0:1
   *   "Preferencias de cookies"    1,23:1      texto-sutil, 7,0:1
   *
   * As duas ultimas linhas sao a parte grave, e nao e so contraste ruim: o tema
   * nunca declarou cor de texto ali, entao a faixa herdou o navy do <body> e
   * ficou navy sobre quase-preto. A frase de copyright e o botao que REVOGA O
   * CONSENTIMENTO de cookies estao invisiveis nas tres paginas.
   *
   * O hover dos links tambem invertia de sentido: o azul de acao da 3,22:1 sobre
   * este fundo, ou seja, apontar o link o deixava MENOS legivel. Aqui ele vai
   * para o branco, que e o que "mais destacado" significa sobre fundo escuro.
   *
   * O que a reorganizacao acrescentou -- o endereco, os documentos e o credito
   * na faixa -- le as mesmas propriedades, e por isso entra no mesmo par sem
   * regra nenhuma aqui. A frase da marca e um <Texto>, e recebe a cor pela prop.
   */
  .invertido {
    --rodape-fundo: var(--color-superficie-inversa-alt);
    --rodape-faixa: var(--color-superficie-inversa-faixa);
    --rodape-titulo: var(--color-texto-inverso);
    --rodape-texto: var(--color-texto-sutil-inverso);
    --rodape-link: var(--color-texto-sutil-inverso);
    --rodape-hover: var(--color-texto-inverso);
  }

  /* MEDIDO: 60px em cima, 40px embaixo; o 60 foi a 64, na grade. */
  .conteudo {
    padding-block: 4rem 2.5rem;
  }

  /*
   * A marca em cima das listas, e ao lado delas a partir de 1200px -- a mesma
   * faixa em que o menu vira barra. Ao lado, um terco para a marca e dois para
   * as listas, que e a proporcao do tema; e a <Grade> das listas so chega a
   * quatro colunas com 48rem, entao entre 1200 e uns 1280px elas ficam em
   * duas, ao lado da marca.
   */
  .colunas-rodape {
    display: grid;
    gap: 3rem;
  }

  @media (min-width: 75rem) {
    .colunas-rodape {
      grid-template-columns: minmax(0, 1fr) minmax(0, 2fr);
      gap: 2rem;
    }
  }

  /*
   * A marca e as redes, empilhadas com 20px entre elas -- o mesmo vao medido do
   * titulo de coluna ate a lista. As redes tem margem lateral negativa, que
   * devolve o primeiro circulo ao alinhamento (ver o <IconesSociais>), e por
   * isso nao se zera a margem delas.
   */
  .celula-marca {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1.25rem;
  }

  .marca {
    display: inline-block;
    line-height: 0;
  }

  /*
   * O logotipo no seu tamanho, sem ampliar. Ver o desvio 1 no comentario do
   * topo: o tema pedia 130px de altura a um arquivo de 100px.
   */
  .marca :global(img) {
    width: auto;
    height: 5rem;
  }

  /* O <Titulo> traz a tag, o `.rotulo` traz a voz (era 14px com 1px de
     espacamento, medido); daqui a cor e os 20px medidos ate a lista. */
  .rodape :global(.titulo-lista) {
    margin-block: 0 1.25rem;
    color: var(--rodape-titulo);
  }

  .lista {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* MEDIDO: 32px por item. E altura de linha da lista, nao entrelinha de
     texto, e por isso vai em rem: em fracao ela crescia com o corpo de 16px. */
  .lista li {
    line-height: 2rem;
  }

  /*
   * A COLUNA DE CONTATO E A UNICA CUJOS ITENS QUEBRAM DE LINHA: e-mail,
   * telefone e endereco, numa coluna de 165px no celular e uns 180 no tablet.
   * Com os 32px de entrelinha das outras listas, "contato@" e
   * "resortsbrasil.com.br" pareciam dois itens. Aqui os 32px viram 20 de
   * entrelinha mais 6 de recuo em cima e embaixo: o item de uma linha mede o
   * mesmo das colunas ao lado, e o que quebra continua sendo um item so.
   */
  .contato li {
    padding-block: 0.375rem;
    line-height: 1.25rem;
  }

  /* As duas linhas de um mesmo dado, na voz do link ao lado, e sem o italico
     que o navegador da ao `<address>` e que nenhuma face baixada desenha. */
  .contato address {
    color: var(--rodape-link);
    font-size: var(--text-sm);
    font-style: normal;
  }

  /*
   * TODO LINK DO RODAPE E A MESMA VOZ: o cinza de paragrafo em repouso e a cor
   * de acao com sublinhado no hover. O Soft UI acrescentou o sublinhado: a
   * troca de cinza para azul, sozinha, e o tipo de sinal que depende so de cor.
   * O botao de preferencias entra junto porque tem de parecer o link ao lado
   * dele -- e a mesma acao para quem le.
   */
  .lista a,
  .legal a,
  .cookie-manage-btn {
    color: var(--rodape-link);
    text-decoration: none;
    text-underline-offset: 0.25em;
    text-decoration-thickness: 1px;
    transition: color var(--duracao) var(--ease-chegada);
  }

  .lista a {
    font-size: var(--text-sm);
  }

  /*
   * O ALVO E A LINHA, NAO O TEXTO. Inline, o link media os 18px do proprio
   * texto dentro de uma linha de 32: passava no 2.5.8 so pelo espacamento, e o
   * medidor o isentava como "link inline em `li`", que e regra para link no
   * meio de uma frase. Em `inline-block` ele herda os 32px da linha sem mover
   * nada; o `vertical-align: top` impede a linha de crescer pelo alinhamento
   * de base entre o corpo de 16px do `li` e o de 14px do link.
   */
  .lista a,
  .legal a {
    display: inline-block;
    vertical-align: top;
  }

  /* No contato a linha e 20px mais 6 de recuo de cada lado: o link estende o
     alvo pelo recuo e o devolve na margem, e mede os mesmos 32. */
  .contato a {
    padding-block: 0.375rem;
    margin-block: -0.375rem;
  }

  .lista a:hover,
  .legal a:hover,
  .cookie-manage-btn:hover {
    color: var(--rodape-hover);
    text-decoration-line: underline;
  }

  /* ---------------- faixa de baixo ---------------- */

  .copyright {
    /* MEDIDO: fundo proprio, um degrau adiante do rodape, e 30px de recuo. */
    background-color: var(--rodape-faixa);
    padding-block: 2rem;
  }

  /*
   * ABAIXO DE 86rem A RESERVA DO VOLTAR-AO-TOPO E EMBAIXO. A nota da `.faixa`
   * dizia que, centrada, a ponta direita nunca chegava ao botao -- e chegava:
   * no celular a faixa quebra em tres ou quatro linhas, e a ultima ia ate a
   * borda. Medido de 320 a 1400px, de 20 em 20: de 340 a 760 o botao cobria o
   * "Cloudbe" ou o "Preferencias de cookies", nos tres idiomas.
   *
   * 80px = 26 do pe ate o botao, 44 do botao e 10 de folga, que cobrem tambem
   * os 6px que o `::after` do botao de cookies estende o alvo. Rolando ate o
   * fim, a ultima linha fica inteira acima do botao.
   */
  @media (max-width: 85.9375rem) {
    .copyright {
      padding-block-end: 5rem;
    }
  }

  /*
   * Duas pontas: a autoria a esquerda, os documentos e o credito a direita.
   * Abaixo disso, empilhadas e centradas, que e como a faixa sempre foi.
   *
   * 86rem e MEDIDO, nao escolhido: as duas pontas somam 1239px de conteudo em
   * espanhol, o idioma mais longo, com o botao de cookies visivel (1230 em
   * portugues, 1031 em ingles); mais os 48px reservados abaixo e os 40px de
   * recuo de cada lado, cabem a partir de 1367px de janela. A primeira versao
   * usava 62rem, e a 1200px as duas pontas quebravam, cada uma em duas linhas.
   *
   * OS 48px SAO DO VOLTAR-AO-TOPO. Ele flutua a 24px da borda e 26px do pe,
   * com 44px de lado, e rolando ate o fim cobria os ultimos 28px da faixa --
   * o "Cloudbe". Abaixo de 86rem a reserva e outra, embaixo da faixa: ver a
   * regra da `.copyright`.
   */
  .faixa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--text-sm);
    text-align: center;
  }

  @media (min-width: 86rem) {
    .faixa {
      flex-direction: row;
      justify-content: space-between;
      gap: 2rem;
      padding-inline-end: 3rem;
      text-align: start;
    }
  }

  /* A autoria no navy, como sempre foi. Os 32px medidos eram a altura de UMA
     linha; no celular ela quebra em duas, e ali 32px de entrelinha separam a
     frase dela mesma. Quem segura a altura da faixa e a lista ao lado. */
  .copyright-texto {
    margin: 0;
    color: var(--rodape-texto);
    line-height: 1.5;
  }

  /*
   * Os documentos e o credito no cinza de paragrafo, inclusive o "Desenvolvido
   * por": no navy ele pesava mais que os links ao lado. Sem separador
   * desenhado: com o `compressHTML: 'jsx'` nao ha espaco entre as tags, e um
   * ponto no inicio de cada linha quebrada seria pior que o vao.
   */
  .legal {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 1.5rem;
    margin: 0;
    padding: 0;
    color: var(--rodape-link);
    line-height: 2rem; /* os 32px medidos, em rem pelo mesmo motivo da lista */
    list-style: none;
  }

  /* O nome da agencia e o unico link da faixa que divide a linha com texto, e
     no mesmo cinza dele so a cor o distinguiria. O sublinhado e o do botao de
     cookies ao lado. */
  .credito a {
    text-decoration-line: underline;
  }

  /* O alvo de toque do botao de preferencias: ele mede a linha do copyright,
     32px, e o pseudo-elemento leva o alvo a 44 so na vertical -- largura ele
     ja tem. Mesma tecnica do <LinkAcao>. Os links ao lado medem os 32px da
     linha, pelo `inline-block` da regra das listas. */
  .cookie-manage-btn::after {
    content: '';
    position: absolute;
    inset: -0.375rem 0;
  }

  .cookie-manage-btn {
    position: relative;
    background: none;
    border: 0;
    padding: 0;
    font: inherit;
    cursor: pointer;
    text-decoration-line: underline;
  }
</style>
