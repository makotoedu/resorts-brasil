---
import Icone from '../primitivos/Icone.astro';
import { ui, social, type Locale } from '../../i18n/ui';
import type { NomeIcone } from '../../icones/glifos';

/**
 * IconesSociais — os quatro perfis, em duas superficies.
 *
 * Substitui o SocialIcons.astro do tema, que emitia `<i class="fab fa-...">` e
 * dependia da webfont. Aparece duas vezes por pagina — topbar e rodape —, e as
 * duas nao sao a mesma coisa:
 *
 *   topbar   simbolo branco sem fundo, sobre o azul; o circulo aparece no hover
 *   rodape   circulo permanente na COR DE MARCA de cada rede
 *
 * MEDIDO (scripts/medir-cromo.mjs):
 *
 *   topbar   caixa 35x40, glifo 15px branco; hover: fundo #5d82d1
 *   rodape   circulo 32px, glifo 16px branco, 4px de vao
 *            facebook #5d82d1  instagram #e53d00  linkedin #238cc8  youtube #ef4e41
 *
 * As quatro cores sao de marca de terceiros e por isso viraram primitivas
 * proprias no tokens.css, sem consolidar com nada do site — sao as unicas cores
 * do sistema que nao respondem a uma decisao nossa.
 *
 * O `aria-label` de cada link vem do tema ja corrigido: antes o conteudo do `<a>`
 * era so um `<i>`, e o leitor de tela anunciava "link" quatro vezes seguidas.
 */
interface Props {
  lang: Locale;
  superficie?: 'topbar' | 'rodape';
  class?: string;
}

const { lang, superficie = 'rodape', class: classe } = Astro.props;
const t = ui[lang];

const redes: { key: string; rede: string; href: string; icone: NomeIcone }[] = [
  { key: 'facebook', rede: 'Facebook', href: social.facebook, icone: 'facebook-f' },
  { key: 'instagram', rede: 'Instagram', href: social.instagram, icone: 'instagram' },
  { key: 'linkedin', rede: 'LinkedIn', href: social.linkedin, icone: 'linkedin' },
  { key: 'youtube', rede: 'YouTube', href: social.youtube, icone: 'youtube' },
];
---

<ul class:list={['redes', `s-${superficie}`, classe]}>
  {
    redes.map((r) => (
      <li class={`r-${r.key}`}>
        <a href={r.href} target="_blank" rel="noopener noreferrer" aria-label={`${t.socialOn} ${r.rede}`}>
          {/* Sem `rotulo` no <Icone>: o nome acessivel ja esta no <a>, e
              anunciar os dois faria o leitor de tela repetir cada rede. */}
          <Icone nome={r.icone} tamanho="sm" />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .redes {
    display: flex;
    align-items: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .redes a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--color-texto-inverso);
    transition:
      background-color var(--duracao) var(--ease-chegada),
      opacity var(--duracao) var(--ease-chegada),
      transform var(--duracao) var(--ease-chegada);
  }

  /* ---------------- topbar ---------------- */

  /* MEDIDO: 35x40 por item, sem fundo em repouso. */
  .s-topbar a {
    width: 2.5rem; /* era 35px; quadrado com os 40 de altura */
    height: 2.5rem;
  }

  /* MEDIDO com o mouse em cima: o circulo aparece no azul do Facebook, que o
     tema usa como cor unica de hover na topbar — nao por rede.

     E O CIRCULO NAO APARECIA: o comentario do topo o descreve, o rodape o
     desenha, e aqui o hover pintava um quadrado de canto vivo. Com o raio, a
     topbar e o rodape passam a ter a mesma forma. */
  .s-topbar a:hover {
    background-color: var(--color-rede-facebook);
    border-radius: var(--radius-full);
  }

  /* ---------------- rodape ---------------- */

  /*
   * O ALVO DE TOQUE, 44px, sem mudar o desenho de 32px. A revisao de design
   * mediu 156 ocorrencias destes circulos abaixo de 44px no celular -- com os
   * 150 do LinkedIn do <CartaoMembro>, a maior parte do que sobrava do achado
   * A15.
   *
   * O LINK TEM OS 44px DE VERDADE, e o circulo continua com 32: 6px de recuo
   * e o fundo recortado na caixa de conteudo, com o raio cheio acompanhando.
   * Um pseudo-elemento estendendo o alvo (a tecnica do <LinkAcao>) entrava na
   * `scrollWidth` do item da lista, e a geometria o lia como texto vazando.
   * Os recuos de dois vizinhos somam os 12px de vao entre os circulos, e a
   * margem negativa da lista devolve o primeiro ao alinhamento do titulo da
   * coluna.
   */
  .s-rodape {
    flex-wrap: wrap;
    margin-inline: -0.375rem;
  }

  .s-rodape a {
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.375rem;
    background-clip: content-box;
    border-radius: var(--radius-full);
  }

  .s-rodape .r-facebook a {
    background-color: var(--color-rede-facebook);
  }

  .s-rodape .r-instagram a {
    background-color: var(--color-rede-instagram);
  }

  .s-rodape .r-linkedin a {
    background-color: var(--color-rede-linkedin);
  }

  .s-rodape .r-youtube a {
    background-color: var(--color-rede-youtube);
  }

  /*
   * O tema nao tinha hover aqui — medido, o circulo do rodape nao muda nada com
   * o mouse em cima. Um alvo clicavel que nao responde e o unico desvio
   * deliberado deste componente, e ele custa uma linha.
   */
  .s-rodape a:hover {
    opacity: 0.85;
  }

  /* No Soft UI o circulo tambem sobe 2px, como o cartao interativo. Sombra
     nao: com o `background-clip: content-box`, a sombra seguiria a caixa de
     44px do alvo de toque, e nao o circulo de 32px que se ve. */
  @media (prefers-reduced-motion: no-preference) {
    .s-rodape a:hover {
      transform: translateY(-2px);
    }
  }
</style>
