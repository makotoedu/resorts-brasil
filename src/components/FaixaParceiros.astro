---
import Secao from './layout/Secao.astro';
import Container from './layout/Container.astro';
import Titulo from './primitivos/Titulo.astro';
import Texto from './primitivos/Texto.astro';
import TituloSecao from './padroes/TituloSecao.astro';
import ParedeLogos from './padroes/ParedeLogos.astro';
import { descontos, mantenedores, parceiros } from '../data/parceiros';
import { ui, type Locale } from '../i18n/ui';

/**
 * As faixas de mantenedores, parceiros e descontos — o bloco inteiro.
 *
 * EXISTE PORQUE SAO DOZE COPIAS, como o <ConviteAssociese>: o mesmo titulo, os
 * mesmos rotulos e as mesmas listas estavam escritos a mao em QUATRO paginas por
 * idioma — associe-se, apoie, resorts-brasil e a home. A Etapa 8 migrou as tres
 * primeiras e a Etapa 9 fechou com a home, onde a divergencia era maior: so a
 * versao portuguesa trazia o TITULO da faixa e o hashtag do fim.
 *
 * Fica em `src/components/` e nao em `padroes/` pelo mesmo criterio da
 * <SecaoCookies> e do <ConviteAssociese>: e montagem de CONTEUDO a partir do
 * `ui.ts` e do `src/data/`, nao uma decisao de desenho. O desenho e a <Secao>, o
 * <TituloSecao> e a <ParedeLogos>, que estao no catalogo.
 *
 * TRES DIVERGENCIAS ENTRE IDIOMAS MORREM AQUI, e as tres so aparecem lendo os
 * tres lado a lado:
 *
 *   1. O rotulo espanhol de parceiros era "Socios / Partners:" — o unico dos
 *      nove que traz duas linguas na mesma linha. Passa a ser "Socios", que e
 *      o que o portugues e o ingles fazem;
 *   2. O titulo tinha um `<br>` manual em portugues e em espanhol, e nao em
 *      ingles. A quebra a mao so acerta numa largura; o `text-wrap: balance` do
 *      base.css acerta em todas;
 *   3. O espanhol terminava o titulo com ponto final e os outros dois nao.
 *
 * O HASHTAG que fecha a faixa em /apoie e /resorts-brasil e traduzido de
 * verdade nos tres idiomas (#ApoieOTurismoBrasileiro, #SupportBrazilianTourism,
 * #ApoyarElTurismoBrasileno) — por isso vem do `ui.ts` e nao e literal.
 *
 * OS GRUPOS SAO EMPILHADOS, COM O ROTULO EM CIMA. Ate o Soft UI o rotulo
 * ocupava uma coluna a esquerda e os logotipos as outras tres, a proporcao do
 * `col-lg-3` + `col-lg-9` do tema. Duas coisas quebravam ali: entre 30 e 48rem
 * a grade externa tinha DUAS colunas e a faixa so passava a ocupar tres a partir
 * de 48rem, entao no tablet o rotulo ficava com metade da largura e os
 * logotipos encolhiam para 90px, menores que no celular; e no desktop um quarto
 * da largura existia para uma palavra. Empilhado, o rotulo encosta no grupo que
 * nomeia em qualquer largura, e o bloco inteiro mora na coluna de 960px, como o
 * titulo centrado sobre ele pede.
 */
interface Props {
  lang: Locale;
  /** A terceira faixa, "Descontos: Cursos e Eventos". So em associe-se. */
  comDescontos?: boolean;
  /** O `#ApoieOTurismoBrasileiro` no fim. Em apoie e resorts-brasil. */
  comHashtag?: boolean;
}

const { lang, comDescontos = false, comHashtag = false } = Astro.props;
const t = ui[lang];

/*
 * As faixas como dado, e nao tres blocos repetidos abaixo. O `descontos` traz
 * uma segunda linha de rotulo ("Cursos e Eventos") que os outros dois nao tem.
 * Os mantenedores sao a faixa em `destaque`: sustentam a associacao, e a parede
 * dizia isso so pela ordem.
 */
const faixas = [
  { rotulo: t.partnersMaintainers, itens: mantenedores, escala: 'destaque' as const, nota: undefined as string | undefined },
  { rotulo: t.partnersPartners, itens: parceiros, escala: 'padrao' as const, nota: undefined as string | undefined },
  ...(comDescontos
    ? [{ rotulo: t.partnersDiscounts, itens: descontos, escala: 'padrao' as const, nota: t.partnersDiscountsNote }]
    : []),
];
---

<Secao id="parceiros">
  <Container largura="media">
    <TituloSecao nivel={2}>{t.partnersTitle}</TituloSecao>

    {
      faixas.map((faixa) => (
        <div class="grupo">
          <div class="rotulo-grupo">
            <Titulo nivel={3} papel="cartao" alinhamento="centro">
              {faixa.rotulo}
            </Titulo>
            {faixa.nota && (
              <Texto papel="apoio" alinhamento="centro" semMargem>
                {faixa.nota}
              </Texto>
            )}
          </div>
          <ParedeLogos itens={faixa.itens} escala={faixa.escala} />
        </div>
      ))
    }

    {
      comHashtag && (
        <p class="hashtag">
          <Texto como="span" papel="abertura" cor="sutil">
            {t.partnersHashtag}
          </Texto>
        </p>
      )
    }
  </Container>
</Secao>

<style>
  /* Do rotulo ao primeiro logotipo sobra o recuo da celula, 12px; os 8px daqui
     completam os 20 que separam um titulo de cartao do que ele nomeia. */
  .rotulo-grupo {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    margin-bottom: 0.5rem;
  }

  .rotulo-grupo > :global(*) {
    margin-block: 0;
  }

  /* Entre um grupo e o seguinte, o dobro do que ha entre o rotulo e o grupo: o
     olho tem de ler as fronteiras antes dos logotipos. */
  .grupo + .grupo {
    margin-top: 3rem;
  }

  .hashtag {
    margin-block: 3rem 0;
    text-align: center;
  }
</style>
