---
import { carrosselHome } from '../data/carrossel-home';

/**
 * O carrossel de logos dos associados da home.
 *
 * Os atributos `data-*` sao lidos pelo logoCarousel() do site.js, que reproduz
 * a matematica de celula do flickity — nao mexa neles sem reler a secao "O
 * carrossel de logos e a formula da celula" em docs/decisoes.md.
 *
 * Cada item que tem site vira link; quem nao tem fica so com a imagem, dentro
 * de um <a> sem href. Manter a tag preserva a caixa que o carrossel mede,
 * enquanto a ausencia de href tira o item da ordem de tabulacao — que era o
 * problema dos 71 `<a href="#">` do original.
 */
---

<div
  class="carousel client-logos dots-grey"
  data-items="6"
  data-arrows="false"
  data-dots="false"
  data-autoplay="1000"
  data-loop="true"
>
  {
    carrosselHome.map((resort) => (
      <div>
        {resort.url ? (
          <a href={resort.url} target="_blank" rel="noopener noreferrer">
            <img alt={resort.nome} src={resort.logo} />
          </a>
        ) : (
          <a>
            <img alt={resort.nome} src={resort.logo} />
          </a>
        )}
      </div>
    ))
  }
</div>
