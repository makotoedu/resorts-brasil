---
/*
 * O layout das 41 paginas, e o unico. A folha do design system entra aqui.
 *
 * ELE FOI METADE DE UM PAR DURANTE SEIS ETAPAS, e o motivo importa mais que a
 * historia: o Astro empacota CSS pelo GRAFO DE MODULOS, nao pelo que a pagina
 * renderiza, entao a folha vai para o bundle de quem a importa — e importa-la no
 * layout do tema punha o Preflight do Tailwind nas 40 paginas que rodavam sobre
 * ele. O isolamento era por ausencia: dois layouts, e este importado so pelas
 * paginas migradas.
 *
 * A Etapa 11 apagou o outro. O que fica e o mecanismo, e ele vale para qualquer
 * folha global que alguem venha a importar daqui.
 *
 * `scripts/verifica-sistema.mjs` afirma o resultado no `dist/`: toda pagina tem
 * a folha do sistema, e nenhuma carrega folha de fora do grafo de modulos.
 */
import '../styles/global.css';

import { ClientRouter } from 'astro:transitions';

import Cabeca from './Cabeca.astro';
import Cabecalho from '../components/cromo/Cabecalho.astro';
import Rodape from '../components/cromo/Rodape.astro';
import FaixaCookies from '../components/cromo/FaixaCookies.astro';
import VoltarAoTopo from '../components/cromo/VoltarAoTopo.astro';
import { ui, htmlLang, type Locale, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  /** Sobrepoe o title de `meta`. So a 404 precisa, por nao ter `route`. */
  title?: string;
  /** Sobrepoe a description de `meta`. Idem. */
  description?: string;
  /** Chave da pagina no mapa de rotas. Omitida em paginas sem traducao (404). */
  route?: RouteKey;
  /** Caminho absoluto da imagem de compartilhamento. */
  ogImage?: string;
  /** Rodape so com a faixa de copyright, como a 404 sempre teve. */
  rodapeMinimo?: boolean;
  /**
   * A variacao de cromo das tres paginas do e-book: cabecalho sem topbar e
   * escuro, rodape invertido.
   *
   * E UMA PROP SO PARA OS TRES TRACOS, e nao tres props, porque no site eles
   * nunca apareceram separados. Tres booleanos permitiriam oito combinacoes, das
   * quais uma existe.
   */
  variacaoEbook?: boolean;
}

const {
  lang,
  title,
  description,
  route,
  ogImage,
  rodapeMinimo = false,
  variacaoEbook = false,
} = Astro.props;
const t = ui[lang];
---

<html lang={htmlLang[lang]}>
  <head>
    <Cabeca lang={lang} title={title} description={description} route={route} ogImage={ogImage} />

    <!--
      NAVEGACAO SEM RECARGA, o ultimo refino da lista do plano.

      Ele foi adiado na Etapa 0 e nao por preferencia: o `site.js` de entao tinha
      6 listeners presos a `document`/`window`, um `setInterval` e um
      `IntersectionObserver`, e todos ACUMULARIAM a cada navegacao — o carrossel
      de logos aceleraria progressivamente e nunca pararia. As etapas 7 e 9
      levaram os tres piores embora ao trocar masonry, carrossel e contadores por
      CSS, e sobraram tres listeners e dois timers, todos com ciclo de vida
      explicito no `site.js` (AbortController por pagina, teardown no
      `astro:before-swap`).

      O `<head>` NAO reexecuta na troca, e isso e desejado: o bloco de
      consentimento roda uma vez e `window.rbConsent` atravessa a navegacao. E
      por atravessar que ele e o unico estado que o `site.js` precisa desfazer a
      mao — ver a nota do `cookieNotice`.
    -->
    <ClientRouter />
  </head>

  <!--
    O <body> nasce SEM CLASSE. O tema usava "modern" em 33 paginas e nada em 7 —
    uma inconsistencia do conteudo original que mudava o layout. Aqui a classe
    simplesmente nao existe, e com ela some a divergencia: e a "uniformizacao do
    bodyClass" que o plano previa, resolvida por remocao em vez de padronizacao.
  -->
  <body>
    <a class="skip-link" href="#conteudo">{t.skipToContent}</a>

    <!--
      Logo depois do link de pular, e nao no fim do <body> como no original,
      para o teclado alcancar a escolha cedo. Nao muda pixel: a faixa e
      `position: fixed`.
    -->
    <FaixaCookies lang={lang} />

    <Cabecalho lang={lang} route={route} semTopbar={variacaoEbook} escuro={variacaoEbook} />

    <!--
      SEM CLASSE NO <main>. O layout do tema precisava de `hero-fullscreen` ali
      para o ajustes.css puxar o hero para tras do cabecalho transparente; aqui o
      cabecalho e `position: relative` dentro do fluxo e a secao de topo comeca
      logo abaixo dele, sem deslocamento negativo nenhum. Um numero a menos para
      manter sincronizado com uma media query.
    -->
    <main id="conteudo">
      <slot />
    </main>

    <Rodape lang={lang} minimo={rodapeMinimo} invertido={variacaoEbook} />

    <VoltarAoTopo lang={lang} />

    <!--
      UM SCRIPT SO, e os nomes de estado dele sao os do tema de proposito:
      `#mainMenu`, `#mainMenu-trigger`, `.toggle-active`, `.modal-active`,
      `#scrollTop`. Foi isso que deixou um `site.js` unico servir as duas camadas
      durante a migracao inteira, em vez de dois que divergiriam em comportamento
      enquanto divergiam em aparencia. Sobrou uma camada e os nomes ficam: o CSS
      do cromo os declara, e renomear agora seria uma varredura sem ganho.
    -->
    <script src="../scripts/site.js"></script>
  </body>
</html>
