---
import {
  url,
  alternates,
  htmlLang,
  ogLocale,
  meta,
  social,
  defaultLocale,
  type Locale,
  type RouteKey,
} from '../i18n/ui';
import { contato } from '../data/contato';
import { imagem } from '../imagens';

/**
 * O `<head>` inteiro — meta, canonical, hreflang, Open Graph, dado estruturado,
 * fonte e consentimento.
 *
 * POR QUE ELE E UM ARQUIVO SEPARADO DO LAYOUT. Ate a Etapa 5 havia um layout so,
 * com uma prop `legado` que escolhia entre carregar o CSS do tema ou nao. A prop
 * nunca foi usada por pagina nenhuma — e nao podia ser: o proprio layout trazia
 * Header e Footer do tema, entao `legado={false}` entregaria uma pagina sem
 * cabecalho e sem rodape.
 *
 * Trocar aquilo por um `if` no layout tambem nao servia, e o motivo e o mesmo
 * que derrubou a primeira tentativa da Etapa 0: o Astro empacota CSS pelo GRAFO
 * DE MODULOS, nao pelo que a pagina renderiza. Bastaria o layout do tema
 * IMPORTAR os componentes novos para o `<style>` deles entrar no bundle das 40
 * paginas do tema — e a invariante de isolamento (nenhuma pagina com as duas
 * folhas) reprovaria o build, com razao.
 *
 * Entao a escolha subiu um nivel: em vez de uma prop dentro de um layout, dois
 * layouts, e este arquivo com o que os dois tinham em comum. O do tema morreu na
 * Etapa 11 e sobrou um so, mas a separacao fica: o `<head>` e um assunto
 * proprio, e o mecanismo que a exigiu — CSS empacotado pelo grafo de modulos —
 * continua valendo para qualquer folha que alguem venha a importar.
 *
 * ELE NAO TEM `<style>`, e isso continua sendo requisito: um bloco de estilo
 * aqui alcancaria toda pagina do site por um caminho que ninguem le.
 */
interface Props {
  lang: Locale;
  /** Sobrepoe o title de `meta`. So a 404 precisa, por nao ter `route`. */
  title?: string;
  /** Sobrepoe a description de `meta`. Idem. */
  description?: string;
  /** Chave da pagina no mapa de rotas. Omitida em paginas sem traducao (404). */
  route?: RouteKey;
  /** Caminho absoluto da imagem de compartilhamento. */
  ogImage?: string;
}

const { lang, title: titleProp, description: descricaoProp, route, ogImage = '/images/og-image.png' } = Astro.props;

// Title e description saem de `meta` em src/i18n/ui.ts, onde os 3 idiomas
// ficam lado a lado. A prop so existe para a 404, que nao tem `route`.
const paginaMeta = route ? meta[route][lang] : undefined;
const title = titleProp ?? paginaMeta?.title;
const description = descricaoProp ?? paginaMeta?.description;
if (!title || !description) {
  throw new Error(
    `Cabeca: pagina sem title/description. Acrescente a rota "${route}" em meta (src/i18n/ui.ts) ou passe as props.`
  );
}

const site = Astro.site!;
// Sem `route` (so a 404), o caminho vem da URL do build e traz `.html`, que
// contradiz o cleanUrls usado no resto do site.
const fallbackPath = Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(route ? url(route, lang) : fallbackPath, site);
const ogImageUrl = new URL(ogImage, site);
const alts = route ? alternates(route) : [];

/** Paginas sem traducao e sem valor de busca (a 404) saem do indice. */
const noindex = !route;

/*
 * O LOGOTIPO DO DADO ESTRUTURADO SAI DO PIPELINE, e nao de um caminho escrito a
 * mao.
 *
 * Ele era `/images/logo-25anos.png`, um caminho que so existia em producao
 * porque a PONTE do scripts/imagens.mjs copiava o arquivo do acervo para
 * `dist/images/` — mecanismo que existia para as paginas do tema. Com a Etapa 11
 * a ponte saiu, e esta URL viraria 404: o Google buscaria o logo da associacao e
 * nao acharia, sem quebrar build nem teste nenhum.
 *
 * Resolvendo pelo `src/imagens.ts`, o endereco passa a ser o do arquivo emitido,
 * com hash — que e o que o `/_astro/` serve com `immutable` de um ano. Cabe aqui
 * porque JSON-LD e a UNICA referencia externa que nao precisa de caminho estavel:
 * o favicon e o og-image precisam, e por isso continuam em `public/images/`.
 */
const logoUrl = new URL(imagem('/images/logo-25anos.png').src, site).href;

/**
 * Dado estruturado da associacao. Uma vez por pagina, com os mesmos valores que
 * a pagina de contato exibe — ver src/data/contato.ts.
 */
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Resorts Brasil',
  alternateName: 'Associação Brasileira de Resorts',
  url: site.href,
  logo: logoUrl,
  email: contato.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contato.endereco.logradouro,
    addressLocality: contato.endereco.cidade,
    addressRegion: contato.endereco.uf,
    addressCountry: contato.endereco.pais,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: contato.email,
      telephone: contato.whatsapp.telefoneE164,
      availableLanguage: ['pt-BR', 'en', 'es'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'public relations',
      email: contato.imprensa.email,
      telephone: contato.imprensa.telefoneE164,
    },
  ],
  sameAs: Object.values(social),
};
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="author" content="Cloudbe" />
<meta name="description" content={description} />
<link rel="icon" type="image/png" href="/images/favicon.png" />
<title>{title}</title>
{noindex && <meta name="robots" content="noindex, follow" />}

<link rel="canonical" href={canonical} />
{alts.map((a) => <link rel="alternate" hreflang={htmlLang[a.lang]} href={new URL(a.href, site)} />)}
{
  alts.length > 0 && (
    <link rel="alternate" hreflang="x-default" href={new URL(url(route!, defaultLocale), site)} />
  )
}

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Resorts Brasil" />
<meta property="og:locale" content={ogLocale[lang]} />
{
  alts
    .filter((a) => a.lang !== lang)
    .map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)
}
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Resorts Brasil" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content="Resorts Brasil" />

<script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

<!--
  Poppins, que era um @import na linha 9 do style.css. Os pesos sao os
  medidos (400-800), a Nunito saiu por nao ter uso, e o endpoint css2 traz
  o display=swap. Preload das faces nao da: a URL do gstatic e opaca.
  Motivos e medicoes em docs/decisoes.md, "Google Fonts".
-->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
/>

<!--
  Consentimento e Google Tag Manager.

  Inline e sincrono de proposito, e nao pode virar um modulo do
  src/scripts/: os defaults do Consent Mode precisam estar no dataLayer
  antes de qualquer rede, e a decisao de injetar o gtm.js depende de ler o
  cookie sem esperar o DOMContentLoaded. Antes deste bloco, o GTM disparava
  incondicionalmente e a faixa era decorativa.

  A UI vive no src/scripts/site.js e so conversa com window.rbConsent.
  Ver docs/decisoes.md, "O consentimento que nao consentia".
-->
<script is:inline>
  (function (w, d) {
    var GTM = 'GTM-PK7DG6MD';
    var NOME = 'rb_consent';
    var VERSAO = 'v1';
    var DIAS = 180;

    w.dataLayer = w.dataLayer || [];
    function gtag() {
      w.dataLayer.push(arguments);
    }

    /* Consent Mode v2: tudo negado antes de qualquer rede. */
    gtag('consent', 'default', {
      ad_storage: 'denied',
      ad_user_data: 'denied',
      ad_personalization: 'denied',
      analytics_storage: 'denied',
      functionality_storage: 'denied',
      personalization_storage: 'denied',
      security_storage: 'granted',
    });

    function ler() {
      var m = d.cookie.match(/(?:^|;\s*)rb_consent=([^;]*)/);
      if (!m) return null;
      var v = decodeURIComponent(m[1]);
      /* Versao diferente: a escolha nao vale mais e a faixa volta. */
      if (v.indexOf(VERSAO + '|') !== 0) return null;
      return { analise: v.indexOf('a:1') > -1, publicidade: v.indexOf('p:1') > -1 };
    }

    var carregado = false;
    function carregarGtm() {
      if (carregado) return;
      carregado = true;
      w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
      var s = d.createElement('script');
      s.async = true;
      s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM;
      d.head.appendChild(s);
    }

    function aplicar(escolha) {
      var pub = escolha.publicidade ? 'granted' : 'denied';
      gtag('consent', 'update', {
        ad_storage: pub,
        ad_user_data: pub,
        ad_personalization: pub,
        analytics_storage: escolha.analise ? 'granted' : 'denied',
      });
      w.dataLayer.push({
        event: 'consent_update',
        rb_analise: !!escolha.analise,
        rb_publicidade: !!escolha.publicidade,
      });
      /* Recusa total nao carrega o container: nao ha o que medir. */
      if (escolha.analise || escolha.publicidade) carregarGtm();
    }

    function gravar(escolha) {
      var valor =
        VERSAO +
        '|a:' + (escolha.analise ? 1 : 0) +
        '|p:' + (escolha.publicidade ? 1 : 0) +
        '|t:' + Math.floor(Date.now() / 1000);
      d.cookie =
        NOME + '=' + encodeURIComponent(valor) +
        '; expires=' + new Date(Date.now() + DIAS * 864e5).toUTCString() +
        '; path=/; SameSite=Lax' +
        (w.location.protocol === 'https:' ? '; Secure' : '');
    }

    w.rbConsent = {
      get: ler,
      set: function (escolha) {
        gravar(escolha);
        aplicar(escolha);
      },
      /* O container entrou no documento? Quem pergunta e o pageview das
         navegacoes sem recarga, no site.js: sem GTM carregado nao ha o que
         medir, e empurrar no dataLayer so acumularia eventos que seriam
         reproduzidos de uma vez se a pessoa aceitasse depois. A resposta mora
         aqui, e nao la, para a regra de "quando ha medicao" existir uma vez so. */
      medindo: function () {
        return carregado;
      },
      /* A UI registra aqui como reabrir o painel. */
      aoAbrir: null,
      abrir: function () {
        if (typeof w.rbConsent.aoAbrir === 'function') w.rbConsent.aoAbrir();
      },
    };

    var escolha = ler();
    if (escolha) aplicar(escolha);

    /* O cookiebar21_cbe guardava uma escolha que nao controlava nada: nao e
       herdado, e sai do navegador de quem ja visitou. */
    if (d.cookie.indexOf('cookiebar21_cbe=') > -1) {
      d.cookie = 'cookiebar21_cbe=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
    }
  })(window, document);
</script>
<!-- end: Consentimento e Google Tag Manager -->
