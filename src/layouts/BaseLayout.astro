---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { ui, url, alternates, htmlLang, defaultLocale, type Locale, type RouteKey } from '../i18n/ui';

interface Props {
  lang: Locale;
  title: string;
  description: string;
  /** Chave da pagina no mapa de rotas. Omitida em paginas sem traducao (404). */
  route?: RouteKey;
  /** Caminho absoluto da imagem de compartilhamento. */
  ogImage?: string;
}

const { lang, title, description, route, ogImage = '/images/og-image.png' } = Astro.props;
const t = ui[lang];

const site = Astro.site!;
const canonical = new URL(route ? url(route, lang) : Astro.url.pathname, site);
const ogImageUrl = new URL(ogImage, site);
const alts = route ? alternates(route) : [];
---

<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Cloudbe" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>

    <link rel="canonical" href={canonical} />
    {
      alts.map((a) => (
        <link rel="alternate" hreflang={htmlLang[a.lang]} href={new URL(a.href, site)} />
      ))
    }
    {
      alts.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(url(route!, defaultLocale), site)} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Resorts Brasil" />
    <meta property="og:locale" content={lang.replace('-', '_')} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <link href="/css/plugins.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != 'dataLayer' ? '&l=' + l : '';
        j.async = true;
        j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
        f.parentNode.insertBefore(j, f);
      })(window, document, 'script', 'dataLayer', 'GTM-PK7DG6MD');
    </script>
    <!-- end: Google Tag Manager -->
  </head>

  <body class="modern">
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-PK7DG6MD"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- end: Google Tag Manager (noscript) -->

    <!-- Body Inner -->
    <div class="body-inner">
      <Header lang={lang} />

      <main>
        <slot />
      </main>

      <Footer lang={lang} />
    </div>
    <!-- end: Body Inner -->

    <!-- Modal Cookie-->
    <div
      id="cookieNotify"
      class="modal-strip modal-bottom cookie-notify"
      data-delay="2000"
      data-expire="10000"
      data-cookie-name="cookiebar21_cbe"
      data-cookie-enabled="true"
    >
      <div class="container">
        <div class="row">
          <div class="col-lg-8 text-sm-center sm-center sm-m-b-10 m-t-5">
            {t.cookieText}
            <a href={url('privacy', lang)} class="text-light">
              <span> {t.cookieMore} <i class="fa fa-info-circle"></i></span>
            </a>
          </div>
          <div class="col-lg-4 text-right sm-text-center sm-center">
            <button type="button" class="btn btn-rounded btn-light btn-outline btn-sm m-r-10 modal-close">
              {t.cookieReject}
            </button>
            <button type="button" id="aceitar-cookies" class="btn btn-rounded btn-light btn-sm modal-confirm">
              {t.cookieAccept}
            </button>
          </div>
        </div>
      </div>
    </div>
    <!--End: Modal Cookie-->

    <!-- Scroll top -->
    <a id="scrollTop"><i class="icon-chevron-up"></i><i class="icon-chevron-up"></i></a>

    <!--Plugins-->
    <script is:inline src="/js/jquery.js"></script>
    <script is:inline src="/js/plugins.js"></script>
    <!--Template functions-->
    <script is:inline src="/js/functions.js"></script>
  </body>
</html>
