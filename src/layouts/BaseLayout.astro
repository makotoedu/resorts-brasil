---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import {
  ui,
  url,
  alternates,
  htmlLang,
  ogLocale,
  meta,
  social,
  defaultLocale,
  type Locale,
  type RouteKey,
} from '../i18n/ui';
import { contato } from '../data/contato';

interface Props {
  lang: Locale;
  /** Sobrepoe o title de `meta`. So a 404 precisa, por nao ter `route`. */
  title?: string;
  /** Sobrepoe a description de `meta`. Idem. */
  description?: string;
  /** Chave da pagina no mapa de rotas. Omitida em paginas sem traducao (404). */
  route?: RouteKey;
  /** Caminho absoluto da imagem de compartilhamento. */
  ogImage?: string;
  /** Rodapé só com a faixa de copyright, como a 404 sempre teve. */
  rodapeMinimo?: boolean;
  /**
   * Classe do <body>. O site original usava "modern" em 33 páginas e deixava o
   * <body> sem classe em 7 (as três do ebook, e política/termos em PT e ES).
   * A inconsistência é do conteúdo original e muda o layout — reproduzida aqui
   * de propósito, para não alterar a aparência dessas páginas.
   */
  bodyClass?: string;
  /**
   * Classe do <main>. Use "hero-fullscreen" quando o primeiro filho for uma
   * section.fullscreen, para restaurar o deslocamento sob o cabeçalho
   * transparente (ver public/css/ajustes.css).
   */
  mainClass?: string;
  /**
   * Variacao de cromo das tres paginas do ebook, tres tracos que no original
   * andam sempre juntos: cabecalho sem topbar e com `.dark`, e rodape
   * `.inverted`. A ausencia do topbar nao e so visual — sem ele o tema aplica
   * -80px em vez de -120px ao irmao do cabecalho transparente, ver
   * public/css/ajustes.css.
   */
  variacaoEbook?: boolean;
}

const {
  lang,
  title: titleProp,
  description: descricaoProp,
  route,
  ogImage = '/images/og-image.png',
  rodapeMinimo = false,
  bodyClass = 'modern',
  mainClass,
  variacaoEbook = false,
} = Astro.props;
const t = ui[lang];

// Title e description saem de `meta` em src/i18n/ui.ts, onde os 3 idiomas
// ficam lado a lado. A prop so existe para a 404, que nao tem `route`.
const paginaMeta = route ? meta[route][lang] : undefined;
const title = titleProp ?? paginaMeta?.title;
const description = descricaoProp ?? paginaMeta?.description;
if (!title || !description) {
  throw new Error(
    `BaseLayout: pagina sem title/description. Acrescente a rota "${route}" em meta (src/i18n/ui.ts) ou passe as props.`
  );
}

const site = Astro.site!;
// Sem `route` (so a 404), o caminho vem da URL do build e traz `.html`, que
// contradiz o cleanUrls usado no resto do site.
const fallbackPath = Astro.url.pathname.replace(/\.html$/, '');
const canonical = new URL(route ? url(route, lang) : fallbackPath, site);
const ogImageUrl = new URL(ogImage, site);
const alts = route ? alternates(route) : [];

/** Paginas sem traducao e sem valor de busca (a 404) saem do indice. */
const noindex = !route;

/**
 * Dado estruturado da associacao. Uma vez por pagina, com os mesmos valores que
 * a pagina de contato exibe — ver src/data/contato.ts.
 */
const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'Resorts Brasil',
  alternateName: 'Associação Brasileira de Resorts',
  url: site.href,
  logo: new URL('/images/logo-25anos.png', site).href,
  email: contato.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: contato.endereco.logradouro,
    addressLocality: contato.endereco.cidade,
    addressRegion: contato.endereco.uf,
    addressCountry: contato.endereco.pais,
  },
  contactPoint: [
    {
      '@type': 'ContactPoint',
      contactType: 'customer support',
      email: contato.email,
      telephone: contato.whatsapp.telefoneE164,
      availableLanguage: ['pt-BR', 'en', 'es'],
    },
    {
      '@type': 'ContactPoint',
      contactType: 'public relations',
      email: contato.imprensa.email,
      telephone: contato.imprensa.telefoneE164,
    },
  ],
  sameAs: Object.values(social),
};
---

<html lang={htmlLang[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="author" content="Cloudbe" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <title>{title}</title>
    {noindex && <meta name="robots" content="noindex, follow" />}

    <link rel="canonical" href={canonical} />
    {
      alts.map((a) => (
        <link rel="alternate" hreflang={htmlLang[a.lang]} href={new URL(a.href, site)} />
      ))
    }
    {
      alts.length > 0 && (
        <link rel="alternate" hreflang="x-default" href={new URL(url(route!, defaultLocale), site)} />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Resorts Brasil" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      alts
        .filter((a) => a.lang !== lang)
        .map((a) => <meta property="og:locale:alternate" content={ogLocale[a.lang]} />)
    }
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Resorts Brasil" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content="Resorts Brasil" />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />

    <!--
      Poppins, que era um @import na linha 9 do style.css. Os pesos sao os
      medidos (400-800), a Nunito saiu por nao ter uso, e o endpoint css2 traz
      o display=swap. Preload das faces nao da: a URL do gstatic e opaca.
      Motivos e medicoes em docs/decisoes.md, "Google Fonts".
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    />

    <!--
      Consentimento e Google Tag Manager.

      Inline e sincrono de proposito, e nao pode virar um modulo do
      src/scripts/: os defaults do Consent Mode precisam estar no dataLayer
      antes de qualquer rede, e a decisao de injetar o gtm.js depende de ler o
      cookie sem esperar o DOMContentLoaded. Antes deste bloco, o GTM disparava
      incondicionalmente e a faixa era decorativa.

      A UI vive no src/scripts/site.js e so conversa com window.rbConsent.
      Ver docs/decisoes.md, "O consentimento que nao consentia".
    -->
    <script is:inline>
      (function (w, d) {
        var GTM = 'GTM-PK7DG6MD';
        var NOME = 'rb_consent';
        var VERSAO = 'v1';
        var DIAS = 180;

        w.dataLayer = w.dataLayer || [];
        function gtag() {
          w.dataLayer.push(arguments);
        }

        /* Consent Mode v2: tudo negado antes de qualquer rede. */
        gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          functionality_storage: 'denied',
          personalization_storage: 'denied',
          security_storage: 'granted',
        });

        function ler() {
          var m = d.cookie.match(/(?:^|;\s*)rb_consent=([^;]*)/);
          if (!m) return null;
          var v = decodeURIComponent(m[1]);
          /* Versao diferente: a escolha nao vale mais e a faixa volta. */
          if (v.indexOf(VERSAO + '|') !== 0) return null;
          return { analise: v.indexOf('a:1') > -1, publicidade: v.indexOf('p:1') > -1 };
        }

        var carregado = false;
        function carregarGtm() {
          if (carregado) return;
          carregado = true;
          w.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          var s = d.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtm.js?id=' + GTM;
          d.head.appendChild(s);
        }

        function aplicar(escolha) {
          var pub = escolha.publicidade ? 'granted' : 'denied';
          gtag('consent', 'update', {
            ad_storage: pub,
            ad_user_data: pub,
            ad_personalization: pub,
            analytics_storage: escolha.analise ? 'granted' : 'denied',
          });
          w.dataLayer.push({
            event: 'consent_update',
            rb_analise: !!escolha.analise,
            rb_publicidade: !!escolha.publicidade,
          });
          /* Recusa total nao carrega o container: nao ha o que medir. */
          if (escolha.analise || escolha.publicidade) carregarGtm();
        }

        function gravar(escolha) {
          var valor =
            VERSAO +
            '|a:' + (escolha.analise ? 1 : 0) +
            '|p:' + (escolha.publicidade ? 1 : 0) +
            '|t:' + Math.floor(Date.now() / 1000);
          d.cookie =
            NOME + '=' + encodeURIComponent(valor) +
            '; expires=' + new Date(Date.now() + DIAS * 864e5).toUTCString() +
            '; path=/; SameSite=Lax' +
            (w.location.protocol === 'https:' ? '; Secure' : '');
        }

        w.rbConsent = {
          get: ler,
          set: function (escolha) {
            gravar(escolha);
            aplicar(escolha);
          },
          /* A UI registra aqui como reabrir o painel. */
          aoAbrir: null,
          abrir: function () {
            if (typeof w.rbConsent.aoAbrir === 'function') w.rbConsent.aoAbrir();
          },
        };

        var escolha = ler();
        if (escolha) aplicar(escolha);

        /* O cookiebar21_cbe guardava uma escolha que nao controlava nada: nao e
           herdado, e sai do navegador de quem ja visitou. */
        if (d.cookie.indexOf('cookiebar21_cbe=') > -1) {
          d.cookie = 'cookiebar21_cbe=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/';
        }
      })(window, document);
    </script>
    <!-- end: Consentimento e Google Tag Manager -->

    <link href="/css/plugins.css" rel="stylesheet" />
    <link href="/css/style.css" rel="stylesheet" />
    <!-- Correções ao tema (ver public/css/ajustes.css); precisa vir depois do style.css -->
    <link href="/css/ajustes.css" rel="stylesheet" />
  </head>

  <body class={bodyClass || undefined}>
    <!-- O <noscript> do GTM saiu daqui: sem JavaScript nao ha como pedir nem
         registrar consentimento, e ele era a unica coisa que ainda disparava
         incondicionalmente. Ver docs/decisoes.md. -->
    <a class="skip-link" href="#conteudo">{t.skipToContent}</a>

    <!--
      Fica logo depois do skip link, e nao no fim do <body> como no original,
      para o teclado alcancar a escolha cedo. Nao muda pixel: `.modal-strip` e
      position: fixed. Nasce `hidden` (reforcado no ajustes.css, secao 7) —
      quem ja decidiu, e quem esta sem JavaScript, nao recebe uma faixa que
      nao pode acionar.
    -->
    <div
      id="cookieNotify"
      class="modal-strip modal-bottom cookie-notify"
      role="region"
      aria-label={t.cookieRegion}
      hidden
    >
      <div class="container">
        <div class="row">
          <div class="col-lg-7 text-sm-center sm-center sm-m-b-10 m-t-5">
            {t.cookieText}
            <a href={url('privacy', lang)} class="text-light">
              <span> {t.cookieMore} <i class="fa fa-info-circle"></i></span>
            </a>
          </div>
          <!-- Os tres botoes usam a MESMA classe: recusar precisa ser tao
               facil e tao visivel quanto aceitar. -->
          <div class="col-lg-5 text-right sm-text-center sm-center">
            <button type="button" class="btn btn-rounded btn-light btn-sm m-r-10" data-cookie="rejeitar">
              {t.cookieRejectAll}
            </button>
            <button
              type="button"
              class="btn btn-rounded btn-light btn-sm m-r-10"
              data-cookie="personalizar"
              aria-expanded="false"
              aria-controls="cookiePrefs"
            >
              {t.cookieCustomize}
            </button>
            <button type="button" class="btn btn-rounded btn-light btn-sm" data-cookie="aceitar">
              {t.cookieAcceptAll}
            </button>
          </div>
        </div>

        <div id="cookiePrefs" class="cookie-prefs" role="group" aria-labelledby="cookiePrefsTitle" hidden>
          <!-- <p> e nao <h2>: um cabecalho aqui entraria no sumario das 40 paginas. -->
          <p id="cookiePrefsTitle" class="cookie-prefs-title">{t.cookiePrefsTitle}</p>
          <ul class="cookie-cats">
            <li>
              <label>
                <input type="checkbox" checked disabled />
                <strong>{t.cookieCatNecessary}</strong> <span>({t.cookieAlwaysOn})</span>
              </label>
              <p>{t.cookieCatNecessaryDesc}</p>
            </li>
            <li>
              <label>
                <input type="checkbox" data-cookie-cat="analise" />
                <strong>{t.cookieCatAnalytics}</strong>
              </label>
              <p>{t.cookieCatAnalyticsDesc}</p>
            </li>
            <li>
              <label>
                <input type="checkbox" data-cookie-cat="publicidade" />
                <strong>{t.cookieCatAds}</strong>
              </label>
              <p>{t.cookieCatAdsDesc}</p>
            </li>
          </ul>
          <button type="button" class="btn btn-rounded btn-light btn-sm" data-cookie="salvar">
            {t.cookieSave}
          </button>
        </div>
      </div>
    </div>

    <!-- Body Inner -->
    <div class="body-inner">
      <Header lang={lang} route={route} semTopbar={variacaoEbook} escuro={variacaoEbook} />

      <main id="conteudo" class={mainClass}>
        <slot />
      </main>

      <Footer lang={lang} minimo={rodapeMinimo} invertido={variacaoEbook} />
    </div>
    <!-- end: Body Inner -->

    <!-- Scroll top -->
    <!--
      href="#top" e proposital: sem ele o elemento nao entra na ordem de
      tabulacao e nao responde ao teclado. `#top` e tratado pelo navegador como
      o topo do documento mesmo sem elemento correspondente, entao o botao
      funciona sem JavaScript; com JavaScript o site.js chama preventDefault e a
      URL nao muda. Os dois <i> sao do tema (um e a seta animada).
    -->
    <a id="scrollTop" href="#top" aria-label={t.backToTop}><i class="icon-chevron-up" aria-hidden="true"></i><i class="icon-chevron-up" aria-hidden="true"></i></a>

    <script src="../scripts/site.js"></script>
  </body>
</html>
