---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  title={'Publicações - Resorts Brasil'}
  description={'Associação Brasileira de Resorts'}
  route="publications"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Publicações</h1>
                    <h3>Uma de nossas missões é gerar informação relevante para o mercado.<br>
                        Confira abaixo nossas últimas publicações:</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Publicacoes -->
    <section id="publicacoes" class="no-padding">
        <div class="container">
            <div class="grid-layout post-5-columns" data-item="post-item" data-margin="30">
                <!-- Cartilha ESG -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/cartilha-esg-resorts-brasil.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Cartilha ESG Resorts Brasil</h2>
                            <p>Direcionamentos para implantação de boas práticas no setor</p>
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank" class="item-link">Leia agora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Cartilha ESG -->
                <!-- Ebook -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/a-gestao-da-jornada-do-viajante.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>A Gestão da Jornada do Viajante</h2>
                            <p>Novo contexto, transformações nos negócios e soluções digitais...</p>
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank" class="item-link">Leia agora
                                <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Ebook-->
                <!-- Memórias -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank">
                                <img alt="capa"
                                    src="/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg">
                            </a>
                            <span class="post-meta-category">2021</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Memórias, sustentabilidade e um olhar para o futuro</h2>
                            <p>Vinte anos atrás, iniciou-se um movimento de união...</p>
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank" class="item-link">Leia agora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Memórias -->
                <!-- Guia do viajante -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/guia-do-viajante-responsavel.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Guia do viajante responsável</h2>
                            <p>A viagem segura depende de todos nós. Movimento Supera Turismo Brasil.</p>
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank" class="item-link">Leia agora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Guia do viajante -->
                <!-- Protocolos -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank">
                                <img alt="capa"
                                    src="/images/publicacoes/protocolos-de-higiene-e-seguranca-meios-de-hospedagem.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Protocolos de higiene e segurança em meios de hospedagem</h2>
                            <p>As premissas abaixo apresentadas foram...</p>
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank" class="item-link">Leia agora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Protocolos -->
            </div>
        </div>
    </section>
    <!-- end: Publicacoes -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">Quer fazer parte de um grupo seleto de resorts brasileiros?</h3>
                <p>Faça parte e ajude a transformar o setor. 😍</p>
                <div>
                    <a href="/associe-se" class="btn">Associe-se</a>
                    <a href="/associados" class="btn btn-outline">Conheça os associados</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
