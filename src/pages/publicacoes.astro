---
import LayoutSistema from '../layouts/LayoutSistema.astro';
import Secao from '../components/layout/Secao.astro';
import Container from '../components/layout/Container.astro';
import Grade from '../components/layout/Grade.astro';
import Titulo from '../components/primitivos/Titulo.astro';
import Texto from '../components/primitivos/Texto.astro';
import CartaoPublicacao from '../components/padroes/CartaoPublicacao.astro';
import ConviteAssociese from '../components/ConviteAssociese.astro';
import { publicacoesEm } from '../conteudo';
import { ui, type Locale } from '../i18n/ui';

/*
 * A pagina que o <CartaoPublicacao> existia para servir, e a que fecha o ciclo
 * aberto na Etapa 4: os dados ja eram Content Collection, o markup e que ainda
 * era do tema. O `ListaPublicacoes.astro`, componente de transicao, saiu junto
 * com esta migracao.
 *
 * QUATRO CORRECOES DELIBERADAS, nos tres idiomas:
 *
 *   1. Hierarquia. Era `<h1 class="text-md h2">` seguido de um `<h3>` que nao e
 *      cabecalho de nada — e a frase de abertura. Virou <Texto tamanho="lg">, e
 *      o salto some por deixar de existir. Mesma correcao da /historia.
 *   2. O `<br>` no meio da abertura sai. Em portugues e espanhol havia um; em
 *      ingles nao — a quebra manual so acertava numa largura, e o
 *      `text-wrap: pretty` do base.css acerta em todas.
 *   3. O empacotamento masonry sai do JavaScript. A grade era
 *      `.grid-layout[data-item]` posicionada em absoluto pelo `gridLayout()` do
 *      site.js; agora e grade CSS, e com ela morre a ultima dependencia daquela
 *      funcao.
 *   4. `m-b-30` na grade em ingles e espanhol, e nao em portugues. A divergencia
 *      estava anotada no ListaPublicacoes desde a Etapa 4; some com a <Grade>,
 *      que traz o proprio ritmo.
 *
 * MEDIDO (scripts/medir-primitivos.mjs, grupo `grade`): o tema poe 1 coluna no
 * mobile, 3 no tablet e 5 no desktop. O `colunas={5}` mais `piso={1}` reproduz
 * os tres — e o 5 entrou na <Grade> por causa desta pagina.
 */
const lang: Locale = 'pt-br';
const t = ui[lang];
const publicacoes = await publicacoesEm(lang);

/*
 * A celula do desktop mede 272px com o container de 1500px e o vao de 28px.
 * Sem este `sizes`, o padrao do cartao (20rem) baixaria uma variante maior do
 * que a que cabe — o erro que a Etapa 2 mediu em dobro de peso.
 */
const tamanhosCapa = '(min-width: 64rem) 18rem, (min-width: 30rem) 32vw, 92vw';
---

<LayoutSistema lang={lang} route="publications">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="media">
      <Titulo nivel={1} papel="pagina" peso="medio" alinhamento="centro">{t.publicationsTitle}</Titulo>
      <Texto tamanho="lg" alinhamento="centro">{t.publicationsLead}</Texto>
    </Container>
  </Secao>

  <Secao id="publicacoes">
    <Container>
      <Grade colunas={5} piso={1} espaco="md">
        {
          publicacoes.map((p) => (
            <CartaoPublicacao
              titulo={p.titulo}
              resumo={p.resumo}
              capa={p.capa}
              etiqueta={String(p.ano)}
              href={p.url}
              rotuloLink={t.leiaAgora}
              nivel={2}
              tamanhos={tamanhosCapa}
            />
          ))
        }
      </Grade>
    </Container>
  </Secao>

  <ConviteAssociese lang={lang} origem="publicacoes" />
</LayoutSistema>
