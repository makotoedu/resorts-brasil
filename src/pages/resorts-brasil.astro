---
import LayoutSistema from '../layouts/LayoutSistema.astro';
import Secao from '../components/layout/Secao.astro';
import Container from '../components/layout/Container.astro';
import Grade from '../components/layout/Grade.astro';
import Titulo from '../components/primitivos/Titulo.astro';
import Texto from '../components/primitivos/Texto.astro';
import Imagem from '../components/primitivos/Imagem.astro';
import ChamadaAcao from '../components/padroes/ChamadaAcao.astro';
import FaixaDestaque from '../components/padroes/FaixaDestaque.astro';
import FaixaParceiros from '../components/FaixaParceiros.astro';
import ConviteAssociese from '../components/ConviteAssociese.astro';
import Video from '../components/padroes/Video.astro';
import BlocoEixo from '../components/BlocoEixo.astro';
import { fotoResortsBrasil, videos } from '../data/midia';
import { ui, type Locale } from '../i18n/ui';

/*
 * QUATRO CORRECOES DELIBERADAS, nos tres idiomas:
 *
 *   1. AS TRES CORES DA FAIXA SAIRAM DO MARKUP. `#EFB72C`, `#15184B` e `#28B055`
 *      em `style=` inline, nove ocorrencias somando os idiomas. Viram os tons
 *      `ambar`, `indigo-escuro` e `verde` — e com eles vem a correcao de
 *      contraste da Etapa 3: o tema escrevia BRANCO sobre o ambar (1,6:1) e
 *      sobre o verde (2,9:1), os dois reprovando o criterio 1.4.3 da WCAG. Cada
 *      tom traz agora o proprio par de texto.
 *   2. Hierarquia. `<h1 class="text-md h2">` seguido de um `<h3>` que e a frase
 *      de abertura, e depois `<h4 class="text-muted">` para a frase dos eixos —
 *      nenhum dos dois e cabecalho de coisa nenhuma. Viram <Texto>.
 *   3. Os dois `<br>` manuais, que existiam so em portugues. `text-wrap:
 *      balance` acerta a quebra em qualquer largura, e nao numa so.
 *   4. O CONVITE DO FIM ERA A COPIA DIVERGENTE. As outras tres paginas trazem o
 *      mesmo bloco sobre fundo claro com dois botoes; esta trazia-o sobre uma
 *      foto, com outra quebra de linha e um botao so. Passa a ser o
 *      <ConviteAssociese>, como as outras — e com isso as doze copias daquele
 *      paragrafo viram uma. A foto de fundo se perde; esta em
 *      docs/deltas-visuais.md.
 *
 * A FOTO GRANDE CONTINUA HOSPEDADA NA UNSPLASH, por decisao registrada na
 * Etapa 8. O que muda e a forma: era `background-image` num `style=` inline com
 * `height: 400px`, sem lazy e sem caixa responsiva; agora e um `<img>` com
 * `loading="lazy"` dentro de uma caixa com `aspect-ratio`. Continua fora do
 * pipeline de imagens — nao ha arquivo local para otimizar — e continua sendo
 * uma requisicao a images.unsplash.com. Ver a nota de URL ABSOLUTA no <Imagem> e
 * a de `fotoResortsBrasil` em src/data/midia.ts.
 */
const lang: Locale = 'pt-br';
const t = ui[lang];

const tamanhosFoto = '(min-width: 60rem) 60rem, 92vw';
---

<LayoutSistema lang={lang} route="resortsBrasil">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="media">
      <Titulo nivel={1} papel="pagina" peso="medio" alinhamento="centro">{t.resortsBrasilTitle}</Titulo>
      <Texto tamanho="lg" alinhamento="centro">{t.resortsBrasilLead}</Texto>
    </Container>
  </Secao>

  <Secao id="resorts-brasil" espacoTopo="nenhum">
    <Container largura="media">
      <Imagem
        src={fotoResortsBrasil}
        alt={t.resortsBrasilPhotoAlt}
        proporcao="larga"
        tamanhos={tamanhosFoto}
        arredondada
        class="mb-7.5"
      />
      <Texto tamanho="lg" cor="sutil" alinhamento="centro" semMargem>{t.resortsBrasilAxesIntro}</Texto>
    </Container>
  </Secao>

  {/* Sem <Container>: a faixa vai de borda a borda. Ver a nota da <FaixaDestaque>. */}
  <Secao id="eixos" espaco="nenhum">
    <FaixaDestaque tons={['ambar', 'indigo-escuro', 'verde']}>
      {/*
        Os tres slots sao LITERAIS. Um `slot={String(i + 1)}` dentro de um
        `.map()` compila e quebra na geracao — ver a nota do <BlocoEixo>. O
        numero de blocos e o de `tons` andam juntos: sao tres em cada.
      */}
      <BlocoEixo slot="1" eixo={t.resortsBrasilAxes[0]} />
      <BlocoEixo slot="2" eixo={t.resortsBrasilAxes[1]} />
      <BlocoEixo slot="3" eixo={t.resortsBrasilAxes[2]} />
    </FaixaDestaque>
  </Secao>

  <Secao id="video" espacoBase="nenhum">
    <Container>
      <Grade colunas={2} piso={1} espaco="md" alinhamento="centro">
        <ChamadaAcao fundo="clara">
          <Titulo nivel={2} papel="secao">{t.resortsBrasilMissionTitle}</Titulo>
          <Texto semMargem>{t.resortsBrasilMissionText}</Texto>
        </ChamadaAcao>

        <Video lang={lang} id={videos.institucional} titulo={t.videoInstitucional} />
      </Grade>
    </Container>
  </Secao>

  <FaixaParceiros lang={lang} comHashtag colunas={5} />

  <ConviteAssociese lang={lang} />
</LayoutSistema>

