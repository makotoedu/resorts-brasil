---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  title={'Página não encontrada (404) - Resorts Brasil'}
  description={'A página que você procura não foi encontrada. Volte para a home da Resorts Brasil ou use o menu para chegar ao que precisa.'}
  rodapeMinimo
  mainClass="hero-fullscreen"
>
    <!-- 404 -->
    <section id="404" class="fullscreen">
        <div class="container">
            <div class="row">
                <div class="col-lg-6">
                    <div class="page-error-404">404</div>
                </div>
                <div class="col-lg-6">
                    <div class="text-left">
                        <h1 class="text-medium">Ops, não foi possível encontrar esta página!</h1>
                        <p class="lead">A página que você está procurando pode ter sido removida, teve seu nome
                            alterado ou está temporariamente indisponível.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end:  404 -->
</BaseLayout>
