---
import GradeLogos from '../components/GradeLogos.astro';
import { descontos, mantenedores, parceiros } from '../data/parceiros';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  route="joinUs"
>
    <!-- Associe-se -->
    <section id="associe-se">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Seja um associado</h1>
                </div>
            </div>
            <div class="space"></div>
            <div class="row">
                <div class="col-lg-5">
                    <img src="/images/hero/pexels-1134176.jpg"
                        class="img-fluid rounded" alt="resort">
                </div>
                <div class="col-lg-7">
                    <div class="call-to-action background-grey rounded">
                        <h2>Buscamos ajudar a transformar o setor de turismo no Brasil,
                            lutando em diversas frentes por um setor produtivo mais forte.</h2>
                        <p>Nossos planos e projetos são feitos pelos resorts para os resorts. O crescimento da
                            associação é um dos pilares para nosso desenvolvimento e fortalecimento como segmento.
                        </p>
                        <div class="m-b-20">
                            <a href="/fale-conosco" target="_blank" rel="noopener noreferrer" class="btn">Associe-se</a>
                            <a href="/associados" class="btn btn-outline">Conheça os associados</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Associe-se -->

    <!-- Benefícios -->
    <section id="beneficios" class="p-t-0">
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-40">
                    <h4>Benefícios de ser um associado</h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Feiras</h3>
                        <p>Participação nas principais feiras do setor em estande cooperado.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>B2B</h3>
                        <p>Rodadas de negócio em formatos inovadores com clientes.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>B2C</h3>
                        <p>Participe da campanha Resort Week.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Estudos</h3>
                        <p>Tenha acesso a estudos e estatísticas exclusivos para nossos associados.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Advocacy</h3>
                        <p>Atuamos junto às esferas governamentais, em parceria com o G20+, na defesa dos
                            interesses da categoria.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Benchmarking</h3>
                        <p>Incentivamos a troca de ideias e conhecimento por meio de comitês temáticos,
                            realizando reuniões periódicas.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Descontos</h3>
                        <p>Temos uma série de parcerias no mercado que geram benefícios especiais e
                            descontos para os associados.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Nossa marca</h3>
                        <p>Os associados recebem o direito de utilizar a marca da associação Resorts Brasil.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Benefícios -->

    <!-- Parceiros -->
    <section id="parceiros">
        <div class="container">
            <div class="row m-b-30">
                <div class="heading-text heading-line text-center">
                    <h4>Conheça algumas empresas que apoiam o turismo<br>através da Resorts Brasil</h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Mantenedores:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={mantenedores} colunas={6} />
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Parceiros:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={parceiros} colunas={6} />
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center m-b-0" style="letter-spacing: 1px;">Descontos:</h4>
                    <p class="text-center">Cursos e Eventos</p>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={descontos} colunas={6} />
                </div>
            </div>
        </div>
    </section>
    <!-- end: Parceiros -->

    <!-- CTA -->
    <section id="cta">
        <div class="container">
            <div style="background-image:url('/images/hero/pexels-161212.jpg')"
                class="call-to-action p-t-100 p-b-100 background-image rounded mb-0">
                <div class="bg-overlay" data-style="2"></div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-10">
                            <h3 class="text-light">Conheça os resorts que já fazem parte da Resorts Brasil</h3>
                            <p class="text-light">Faça parte e ajude a transformar o setor. 😍</p>
                        </div>
                        <div class="col-lg-2">
                            <a href="/associados" class="btn btn-light btn-outline">Saiba mais</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
