---
/**
 * Catalogo vivo do design system.
 *
 * MONTA O PROPRIO DOCUMENTO em vez de usar o layout do site, e isso e anterior
 * ao design system ter layout: ate a Etapa 5 o unico que existia trazia Header e
 * Footer do tema, e o catalogo teria nascido com cromo de outra camada. Ele
 * continua assim porque a vitrine e o unico lugar onde os componentes aparecem
 * sem nada em volta — se o base.css estiver errado, aparece aqui primeiro.
 *
 * As cores sao renderizadas com `var(--token)`, nunca com o valor literal: o
 * swatch nao tem como divergir do tokens.css, e um nome de token que deixe de
 * existir aparece como quadro sem cor em vez de passar despercebido.
 *
 * Fora do indice e fora do sitemap (ver o `filter` em astro.config.mjs), mas
 * DENTRO dos portoes: ele entra na varredura de geometria e no orcamento como
 * qualquer pagina, e ja reprovou os dois antes de qualquer conteudo migrar.
 */
import '../styles/global.css';

import Titulo from '../components/primitivos/Titulo.astro';
import Texto from '../components/primitivos/Texto.astro';
import Botao from '../components/primitivos/Botao.astro';
import Icone from '../components/primitivos/Icone.astro';
import Imagem from '../components/primitivos/Imagem.astro';
import Secao from '../components/layout/Secao.astro';
import Container from '../components/layout/Container.astro';
import Grade from '../components/layout/Grade.astro';
import CartaoMembro from '../components/padroes/CartaoMembro.astro';
import ChamadaAcao from '../components/padroes/ChamadaAcao.astro';
import CaixaIcone from '../components/padroes/CaixaIcone.astro';
import CartaoPublicacao from '../components/padroes/CartaoPublicacao.astro';
import LinkAcao from '../components/padroes/LinkAcao.astro';
import ListaIcones from '../components/padroes/ListaIcones.astro';
import Hero from '../components/padroes/Hero.astro';
import FaixaDestaque from '../components/padroes/FaixaDestaque.astro';
import Contador from '../components/padroes/Contador.astro';
import Abas from '../components/padroes/Abas.astro';
import Prosa from '../components/padroes/Prosa.astro';
import Tabela from '../components/padroes/Tabela.astro';
import TituloSecao from '../components/padroes/TituloSecao.astro';
import FaixaLogos from '../components/padroes/FaixaLogos.astro';
import CarrosselLogos from '../components/padroes/CarrosselLogos.astro';
import CartaoModalidade from '../components/padroes/CartaoModalidade.astro';
import Video from '../components/padroes/Video.astro';
import SecaoEbook from '../components/padroes/SecaoEbook.astro';
import Cabecalho from '../components/cromo/Cabecalho.astro';
import Rodape from '../components/cromo/Rodape.astro';
import FaixaCookies from '../components/cromo/FaixaCookies.astro';
import IconesSociais from '../components/cromo/IconesSociais.astro';
import VoltarAoTopo from '../components/cromo/VoltarAoTopo.astro';
import { glifos, nomesDeIcone } from '../icones/glifos';
import { regioesAssociados } from '../data/associados';
import { diretoria, cargoEm } from '../data/diretoria';
import { textoEm } from '../data/ebook';
import { autoresEbook } from '../data/autores-ebook';

/**
 * Quatro logos reais, tirados de `src/data/associados.ts` sem tocar no arquivo.
 * A demonstração de <Imagem> vale mais com o dado que o site já tem: se o
 * pipeline exigisse `import` de cada arquivo, esta linha seria impossível.
 */
const logosDemo = regioesAssociados[0].estados[0].resorts.slice(0, 4);

/**
 * Oito logos para o carrossel, e o número tem um piso: a volta anda metade da
 * trilha, então depois dela restam N células para preencher as `colunas`
 * visíveis. Com menos de seis no desktop sobraria um vão. Oito é o mínimo
 * confortável — e cada célula custa um `<picture>`, que o orçamento cobra. A
 * faixa de verdade tem 70.
 */
const carrosselDemo = regioesAssociados.flatMap((r) => r.estados.flatMap((e) => e.resorts)).slice(0, 8);

const primitivas = [
  '--cor-navy-900',
  '--cor-ardosia-600',
  '--cor-cinza-500',
  '--cor-cinza-600',
  '--cor-azul-600',
  '--cor-azul-500',
  '--cor-azul-700',
  '--cor-carvao-900',
  '--cor-carvao-800',
  '--cor-branco',
  '--cor-nevoa-100',
  '--cor-nevoa-50',
  '--cor-coral-500',
  '--cor-ambar-500',
  '--cor-ambar-400',
  '--cor-ambar-600',
  '--cor-indigo-700',
];

const semanticas = [
  '--color-texto',
  '--color-texto-paragrafo',
  '--color-texto-sutil',
  '--color-texto-sutil-inverso',
  '--color-texto-inverso',
  '--color-acao-primaria',
  '--color-acao-primaria-hover',
  '--color-acao-primaria-texto',
  '--color-acao-destaque',
  '--color-acao-destaque-hover',
  '--color-acao-destaque-texto',
  '--color-link',
  '--color-superficie',
  '--color-superficie-clara',
  '--color-superficie-inversa',
  '--color-superficie-inversa-alt',
  '--color-borda',
  '--color-destaque',
];

/** As quatro variantes do <Botao>, com o que cada uma quer dizer. */
const variantesBotao = [
  { variante: 'primaria' as const, papel: 'a acao principal da tela' },
  { variante: 'contorno' as const, papel: 'acao secundaria, mesmo peso visual menor' },
  { variante: 'clara' as const, papel: 'sobre foto ou fundo escuro (17 usos no site)' },
  { variante: 'destaque' as const, papel: 'chamada de conversao, uma por pagina' },
  { variante: 'ebook' as const, papel: 'so a landing page do e-book, que tem paleta propria' },
];

/**
 * Tres autores reais para a variante escura do cartao, e a escolha nao e
 * aleatoria: o primeiro tem o capitulo mais longo da lista (duas linhas em
 * qualquer largura), e o ultimo nao tem LinkedIn — os dois casos dificeis.
 */
const autoresDemo = [
  autoresEbook.find((a) => a.nome === 'Patricia Azevedo')!,
  autoresEbook.find((a) => a.nome === 'Tricia Neves')!,
  autoresEbook.find((a) => a.nome === 'Eliane Brito')!,
];

/** As sete superficies do ebook, na ordem em que a pagina desce por elas. */
const superficiesEbook = [
  { superficie: 'topo' as const, papel: 'a abertura, sob a foto' },
  { superficie: 'sobre' as const, papel: 'carvao -> noite-700' },
  { superficie: 'faixa' as const, papel: 'iniciativa e creditos, com textura' },
  { superficie: 'video' as const, papel: 'carvao-750, sob a foto' },
  { superficie: 'estrutura' as const, papel: 'petroleo-800 -> carvao' },
  { superficie: 'secoes' as const, papel: 'carvao -> oceano-800' },
  { superficie: 'autores' as const, papel: 'carvao -> noite-750' },
];

/** Os cinco estados. `estado` e a prop que existe so para esta pagina. */
const estadosBotao = [
  { rotulo: 'repouso', props: {} },
  { rotulo: 'hover', props: { estado: 'hover' as const } },
  { rotulo: 'foco', props: { estado: 'foco' as const } },
  { rotulo: 'ativo', props: { estado: 'ativo' as const } },
  { rotulo: 'desabilitado', props: { desabilitado: true } },
];

/** Cada degrau com o par de pixels medido nas pontas da escala. */
const escalaTipo = [
  { token: '--text-xs', rotulo: 'xs', nota: '12px' },
  { token: '--text-sm', rotulo: 'sm', nota: '13px' },
  { token: '--text-base', rotulo: 'base', nota: '14px — corpo' },
  { token: '--text-md', rotulo: 'md', nota: '18px' },
  { token: '--text-lg', rotulo: 'lg', nota: '19 → 25px' },
  { token: '--text-xl', rotulo: 'xl', nota: '24 → 34px' },
  { token: '--text-2xl', rotulo: '2xl', nota: '30 → 50px' },
  { token: '--text-3xl', rotulo: '3xl', nota: '40 → 62px' },
  { token: '--text-4xl', rotulo: '4xl', nota: '48 → 90px' },
];

/**
 * Quatro membros reais da diretoria e as duas primeiras regiões de associados,
 * lidos de `src/data/` sem tocar em nada. Vale o mesmo que valeu para os logos
 * na Etapa 1: um catálogo com dado inventado esconde justamente o caso difícil
 * — o nome comprido, o cargo de duas linhas, o conselheiro sem LinkedIn.
 */
const membrosDemo = diretoria.slice(0, 4);
const regioesDemo = regioesAssociados.slice(0, 3);

/** As três publicações mais recentes, com as capas que o site já tem. */
const publicacoesDemo = [
  {
    titulo: 'Cartilha ESG Resorts Brasil',
    resumo: 'Direcionamentos para implantação de boas práticas no setor',
    capa: '/images/publicacoes/cartilha-esg-resorts-brasil.jpg',
    etiqueta: '2022',
  },
  {
    titulo: 'A Gestão da Jornada do Viajante',
    resumo: 'Novo contexto, transformações nos negócios e soluções digitais…',
    capa: '/images/publicacoes/a-gestao-da-jornada-do-viajante.jpg',
    etiqueta: '2022',
  },
  {
    titulo: 'Memórias, sustentabilidade e um olhar para o futuro',
    resumo: 'Vinte anos atrás, iniciou-se um movimento de união…',
    capa: '/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg',
    etiqueta: '2021',
  },
];

/** Os cinco indicadores da página de associados, com os valores reais. */
const indicadores = [
  { ate: 83, rotulo: 'Resorts Associados' },
  { ate: 21, sufixo: ' mil', rotulo: 'Quartos' },
  { ate: 20, sufixo: ' mil', rotulo: 'Empregos Diretos' },
  { ate: 16, rotulo: 'Estados' },
  { ate: 5, rotulo: 'Regiões do Brasil' },
];

/** Os seis tons de acento, com o par de contraste que cada um carrega. */
const tonsDeFaixa = [
  { tom: 'ambar' as const, nota: 'texto navy — 9,1:1' },
  { tom: 'verde' as const, nota: 'texto navy — 5,2:1' },
  { tom: 'indigo' as const, nota: 'texto branco' },
  { tom: 'indigo-escuro' as const, nota: 'texto branco' },
  { tom: 'roxo' as const, nota: 'texto branco' },
  { tom: 'magenta' as const, nota: 'texto branco' },
];

const faixas = [
  { nome: 'xs', faixa: '0 – 575' },
  { nome: 'sm', faixa: '576 – 767' },
  { nome: 'md', faixa: '768 – 1024' },
  { nome: 'lg', faixa: '1025 – 1199' },
  { nome: 'xl', faixa: '1200+' },
];
---

<html lang="pt-br">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Catálogo — Design System Resorts Brasil</title>
    <!--
      A fonte. Faltava, e o catalogo parecia certo so nas maquinas que ja tem
      Poppins instalada — o `document.fonts.check('14px Poppins')` respondia
      "disponivel" por causa da fonte do sistema, nao do carregamento. Num
      visitante sem ela, o catalogo caia na fallback e mostrava uma escala
      tipografica que nao e a do site.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    />
  </head>
  <body>
    <main class="catalogo">
      <header class="cabecalho">
        <h1>Design system</h1>
        <p>
          Catálogo vivo. Todos os valores vêm de <code>src/styles/tokens.css</code>, medidos com{' '}
          <code>scripts/medir-base.mjs</code> — nenhum foi redesenhado.
        </p>
      </header>

      <section>
        <h2>Cor — primitivas</h2>
        <p class="legenda">O valor cru. Componente nunca consome desta camada.</p>
        <ul class="swatches">
          {
            primitivas.map((t) => (
              <li>
                <span class="amostra" style={`background: var(${t})`} />
                <code>{t}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Cor — semânticas</h2>
        <p class="legenda">
          O papel. É esta a camada que os componentes usam, e é por ela que um tema escuro
          entraria sem tocar em nenhum componente.
        </p>
        <ul class="swatches">
          {
            semanticas.map((t) => (
              <li>
                <span class="amostra" style={`background: var(${t})`} />
                <code>{t}</code>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Tipografia</h2>
        <p class="legenda">
          Escala fluida por <code>clamp()</code>. As âncoras são os valores medidos em 390px e
          1440px — os extremos são os do site atual, o que muda é o meio, que antes saltava na
          media query. Redimensione a janela para ver.
        </p>
        <ul class="tipos">
          {
            escalaTipo.map((e) => (
              <li>
                <span class="rotulo">
                  <code>{e.token}</code> <small>{e.nota}</small>
                </span>{' '}
                <span class="exemplo" style={`font-size: var(${e.token})`}>
                  Resorts Brasil
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section>
        <h2>Elementos base</h2>
        <p class="legenda">
          O que o <code>base.css</code> restaura depois do Preflight do Tailwind. Se algo aqui
          divergir do tema, o erro está no <code>base.css</code> e não na página que o revelou.
        </p>
        <div class="demo">
          <p class="nota-h1">
            O <code>h1</code> é o título desta página, acima — a demonstração não repete a tag
            para a página não ficar com dois.
          </p>
          <h2>Título h2</h2>
          <h3>Título h3</h3>
          <h4>Título h4</h4>
          <p>
            Parágrafo de corpo. A associação reúne os principais resorts do país e representa o
            setor junto ao poder público, à imprensa e ao mercado.
          </p>
          <p>
            Texto com <strong>destaque forte</strong>, um <a href="#">link</a> e um{' '}
            <small>texto reduzido</small>.
          </p>
          <ul>
            <li>Item de lista não ordenada</li>
            <li>Segundo item</li>
          </ul>
          <hr />
        </div>
      </section>

      <section>
        <h2>Faixas</h2>
        <p class="legenda">
          São as do site, não as padrão do Tailwind. O <code>lg</code> em 1025px é proposital —
          ler o array errado já custou 22 comparações de tablet reprovadas neste projeto.
        </p>
        <table>
          <thead>
            <tr><th>classe</th><th>faixa</th></tr>
          </thead>
          <tbody>
            {faixas.map((f) => (<tr><td><code>{f.nome}</code></td><td>{f.faixa}</td></tr>))}
          </tbody>
        </table>
      </section>

      <section>
        <h2>Primitivos</h2>
        <p class="legenda">
          Oito componentes: cinco de conteúdo e três de layout. Todos entram aqui com as
          variantes e os estados no mesmo commit em que nascem —{' '}
          <code>scripts/verifica-sistema.mjs</code> falha o build se um deles ficar de fora desta
          página, porque catálogo escrito depois nunca é escrito.
        </p>
      </section>

      <section>
        <h3>Título</h3>
        <p class="legenda">
          <code>nivel</code> escolhe a tag, <code>tamanho</code> escolhe a aparência. São eixos
          separados de propósito: 39 das 40 páginas do site têm hierarquia quebrada, e sempre pela
          mesma causa — escolher a tag pelo tamanho que ela desenha.
        </p>
        <div class="demo">
          <Titulo nivel={2} tamanho="2xl">h2 no tamanho 2xl</Titulo>
          <Titulo nivel={3} tamanho="xl">h3 no tamanho xl</Titulo>
          <Titulo nivel={4} tamanho="lg">h4 no tamanho lg</Titulo>
          <Titulo nivel={5} tamanho="md">h5 no tamanho md</Titulo>
          <hr />
          <p class="legenda">
            O ponto do componente: aqui vai um <code>h6</code> — o último nível do documento —
            desenhado no maior tamanho da escala. Sem os dois eixos, isso exigiria uma classe
            contradizendo a tag.
          </p>
          <Titulo nivel={6} tamanho="3xl">h6 no tamanho 3xl</Titulo>
          <hr />
          <Titulo nivel={4} tamanho="lg" cor="sutil">cor sutil</Titulo>
          <Titulo nivel={4} tamanho="lg" alinhamento="centro">alinhamento centro</Titulo>
        </div>
      </section>

      <section>
        <h3>Texto</h3>
        <p class="legenda">
          Sem props, é o parágrafo do <code>base.css</code> — <code>14px</code> e{' '}
          <code>#525e75</code>, os valores medidos.
          As props existem para os desvios, não para o caso comum.
        </p>
        <div class="demo">
          <Texto>
            Parágrafo padrão. A associação reúne os principais resorts do país e representa o setor
            junto ao poder público, à imprensa e ao mercado.
          </Texto>
          <Texto tamanho="lg" cor="padrao">Texto lg, cor padrão — abertura de seção.</Texto>
          <Texto tamanho="sm" cor="sutil">Texto sm, cor sutil — legenda e apoio.</Texto>
          <Texto como="span" tamanho="sm">Um <code>span</code>, para uso dentro de frase.</Texto>
        </div>
        {/*
          O `destaque` e o `sutil-inverso` vivem numa demo ESCURA porque e onde
          eles existem de verdade. O coral é o acento das seções do e-book, e
          sobre branco em 12px ele dá 3,15:1 — reprova, e mostrá-lo aqui sobre
          papel branco era oferecer uma combinação que o site não usa e que o
          `tests/verify-contraste.mjs` reprova com razão.
        */}
        <p class="rotulo-demo">Sobre superfície escura</p>
        <div class="demo demo-escura">
          <Texto tamanho="xs" cor="destaque" peso="semibold">Texto xs, destaque, semibold.</Texto>
          <Texto tamanho="sm" cor="sutil-inverso">Texto sm, cor sutil-inverso — o par escuro.</Texto>
          <Texto tamanho="sm" cor="inverso">Texto sm, cor inversa.</Texto>
        </div>
      </section>

      <section>
        <h3>Botão</h3>
        <p class="legenda">
          Cinco variantes × três tamanhos × cinco estados. Os valores são medidos com{' '}
          <code>scripts/medir-primitivos.mjs</code>, <strong>hover incluído</strong> — ele não
          aparece no HTML nem no diff visual, então seria a parte mais fácil de inventar.{' '}
          <code>href</code> decide a tag: com ele sai <code>&lt;a&gt;</code>, sem ele{' '}
          <code>&lt;button&gt;</code>.
        </p>
        <p class="legenda">
          <strong>O rótulo da variante <code>ebook</code> não é branco</strong>, e essa é a
          correção que a Etapa 10 trouxe. O gradiente do tema ia do ciano ao coral com texto
          branco: 1,65:1 numa ponta e 3,74:1 na outra, reprovando nas duas. O carvão do próprio
          e-book dá 11,50:1 e 5,08:1. Ela também é a única variante cujo hover o tema não tinha —
          medido, o botão não mudava nada com o mouse em cima.
        </p>

        {
          variantesBotao.map(({ variante, papel }) => (
            <div
              class:list={[
                'demo',
                'demo-botoes',
                /* `superficie-inversa` nao e decoracao: e a marca que o base.css
                   procura para trocar a cor do contorno de foco. */
                (variante === 'clara' || variante === 'ebook') && 'demo-escura superficie-inversa',
              ]}
            >
              <p class="rotulo-demo">
                <code>variante="{variante}"</code> <small>{papel}</small>
              </p>
              <div class="estados">
                {estadosBotao.map(({ rotulo, props }) => (
                  <span class="estado">
                    <Botao variante={variante} {...props}>
                      Associe-se
                    </Botao>
                    <small>{rotulo}</small>
                  </span>
                ))}
              </div>
            </div>
          ))
        }

        <div class="demo demo-botoes">
          <p class="rotulo-demo"><code>tamanho</code> <small>sm · md · lg</small></p>
          <div class="estados">
            <span class="estado"><Botao tamanho="sm">Salvar</Botao><small>sm</small></span>{' '}
            <span class="estado"><Botao tamanho="md">Associe-se</Botao><small>md (padrão)</small></span>{' '}
            <span class="estado"><Botao tamanho="lg">Conheça os resorts</Botao><small>lg</small></span>
          </div>
          <p class="legenda">
            O <code>lg</code> interpola fonte (13 → 16px) e recuo (24 → 40px) por{' '}
            <code>clamp()</code>, com as pontas medidas — no tema isso saltava na media query.
            Redimensione a janela.
          </p>
        </div>
      </section>

      <section>
        <h3>Ícone</h3>
        <p class="legenda">
          Os 16 símbolos do site, em SVG inline, extraídos das próprias webfonts do tema por{' '}
          <code>python scripts/glifos-para-svg.py</code>.{' '}
          <code>tests/verify-icones.mjs</code> compara cada desenho com a fonte de origem, então
          codepoint trocado ou eixo espelhado reprova — a checagem que faltava quando o subset
          apagou as setas de 6 páginas sem erro de build.
        </p>
        <ul class="icones">
          {
            nomesDeIcone.map((nome) => (
              <li>
                <Icone nome={nome} tamanho="lg" />
                <code>{nome}</code>{' '}
                <small>{glifos[nome].codepoint}</small>
              </li>
            ))
          }
        </ul>
        <div class="demo">
          <p class="rotulo-demo"><code>tamanho</code> <small>sm 16px · md 24px · lg 36px</small></p>
          <p>
            <Icone nome="map-pin" tamanho="sm" />
            <Icone nome="map-pin" tamanho="md" />
            <Icone nome="map-pin" tamanho="lg" />
          </p>
          <p class="legenda">
            Herdam a cor do texto (<code>currentColor</code>) e ficam <code>aria-hidden</code> por
            padrão. Com <code>rotulo</code>, viram imagem com nome acessível:
            <Icone nome="whatsapp" rotulo="WhatsApp" />
          </p>
        </div>
      </section>

      <section>
        <h3>Imagem</h3>
        <p class="legenda">
          AVIF e WebP com <em>fallback</em> no formato original, <code>srcset</code> e{' '}
          <code>sizes</code> derivados da escala, <code>width</code>/<code>height</code> sempre
          presentes e <code>loading="lazy"</code> por padrão — nada disso é decisão de quem usa.
          Hoje 1 dos 193 <code>&lt;img&gt;</code> do site tem <code>loading</code>, e os heros
          são de 2250×1500 exibidos a 360px.
        </p>
        <p class="legenda">
          <code>src</code> aceita o caminho público antigo (<code>/images/…</code>), resolvido por{' '}
          <code>src/imagens.ts</code>. É o que deixa os 183 caminhos de <code>src/data/</code>{' '}
          intactos — dado não vira <code>import</code>. Caminho inexistente aborta o build em vez
          de virar 404.
        </p>
        <div class="demo">
          <p class="rotulo-demo">
            <code>escala="largura-total"</code> <small>hero: ocupa a largura do pai</small>
          </p>
          <Imagem
            src="/images/hero/pexels-1134176.jpg"
            alt=""
            escala="largura-total"
            tamanhos="(min-width: 63.75rem) 57rem, 100vw"
            proporcao="larga"
            ajuste="cobrir"
            arredondada
          />
          <p class="legenda">
            <code>proporcao="larga"</code> (3/2) com <code>ajuste="cobrir"</code>. No tema a altura
            do hero era <code>height: 360px</code> em <code>style=</code> inline, que recorta mais
            justamente onde há menos tela.
          </p>
          <p class="legenda">
            <strong>O <code>tamanhos</code> não é opcional de fato.</strong> Sem ele,{' '}
            <code>largura-total</code> assume <code>100vw</code> — e esta imagem vive dentro de um
            catálogo de 60rem, então o navegador baixava a variante de 1440px para uma caixa de
            862px. A regra: se a imagem não ocupa a largura da janela, diga a largura que ela ocupa.
          </p>
        </div>

        <div class="demo">
          <p class="rotulo-demo">
            <code>escala="fixa"</code> <small>logo: sempre 180px, com a variante 2×</small>
          </p>
          <Grade colunas={4} espaco="sm">
