        <div class="demo demo-sangrada">
          <FaixaDestaque tons={['indigo-escuro', 'roxo', 'magenta']}>
            <Fragment slot="1">
              <Titulo nivel={4} tamanho="xl">Sensibilizar o olhar</Titulo>
