---
import GradeMembros from '../../components/GradeMembros.astro';
import { diretoria, conselhoConsultivo } from '../../data/diretoria';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  route="board"
>
    <!-- Board -->
    <section id="board" class="p-b-0">
        <div class="container">
            <div class="row text-center">
                <h1 class="m-b-10 h2">Management of Resorts Brasil</h1>
                <h4 class="text-muted">Biennium 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={diretoria} lang="en-us" />
        </div>
    </section>
    <!-- end: Board -->

    <!-- Consulting Board -->
    <section id="consulting-board">
        <div class="container">
            <div class="row text-center">
                <h2 class="m-b-10">Consulting Board</h2>
                <h4 class="text-muted">Biennium 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={conselhoConsultivo} lang="en-us" />
        </div>
    </section>
    <!-- end: Consulting Board -->
</BaseLayout>
