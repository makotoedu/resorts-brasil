---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  title={'Contact us - Resorts Brasil'}
  description={'Brazilian Association of Resorts'}
  route="contact"
>
    <!-- Title -->
    <section>
        <div class="container">
            <div class="row">
                <div class="text-center">
                    <h1 class="text-md">How would you like to <br> contact us?</h1>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Title -->

    <!-- Contact us -->
    <section id="contact-us" class="p-t-0">
        <div class="container">
            <div class="call-to-action p-t-100 background-grey rounded">
                <div class="row">
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="mailto:contato@resortsbrasil.com.br"><i class="icon-mail"></i></a>
                            </div>
                            <h3>Email</h3>
                            <p>Questions? We can help you via email.<br>
                                <b>contato@resortsbrasil.com.br</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="https://goo.gl/maps/osRdE2bZhqc1hCk78"><i class="icon-map-pin"></i></a>
                            </div>
                            <h3>Address</h3>
                            <p>Our mailing address:<br>
                                <b>R. Prof. Carlos de Carvalho, 28, sl. 82 - Itaim Bibi, São Paulo - SP</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="mailto:cristiane@hatsur.com"><i class="icon-message-square"></i></a>
                            </div>
                            <h3>Press</h3>
                            <p>Anagrama Comunicação e Eventos.<br><b>reila@anagrama.com.br</b><br><b>+55 11
                                    95038-7232</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="https://wa.me/5511950580313" target="_blank"><i
                                        class="fab fa-whatsapp"></i></a>
                            </div>
                            <h3>WhatsApp</h3>
                            <p>Needing help? Contact our virtual assistant.<br>
                                <b>+55 (11) 95058-0313</b>
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Contact us -->
</BaseLayout>
