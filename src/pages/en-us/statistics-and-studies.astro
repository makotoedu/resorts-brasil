---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Grade from '../../components/layout/Grade.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Texto from '../../components/primitivos/Texto.astro';
import CartaoPublicacao from '../../components/padroes/CartaoPublicacao.astro';
import ConviteAssociese from '../../components/ConviteAssociese.astro';
import { estudosEm } from '../../conteudo';
import { ui, type Locale } from '../../i18n/ui';

/* As correcoes desta pagina estao anotadas em
   src/pages/estatisticas-e-estudos.astro, que e a versao de referencia. */
const lang: Locale = 'en-us';
const t = ui[lang];
const estudos = await estudosEm(lang);

const tamanhosCapa = '(min-width: 64rem) 22rem, (min-width: 30rem) 45vw, 92vw';
---

<LayoutSistema lang={lang} route="statistics">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="media">
      <Titulo nivel={1} papel="pagina" peso="medio" alinhamento="centro">{t.statisticsTitle}</Titulo>
      <Texto tamanho="lg" alinhamento="centro">{t.statisticsLead}</Texto>
    </Container>
  </Secao>

  <Secao id="statistics-and-studies">
    <Container>
      <Grade colunas={4} piso={1} espaco="md">
        {
          estudos.map((e) => (
            <CartaoPublicacao
              titulo={e.titulo}
              capa={e.capa}
              href={e.url}
              rotuloLink={t.leiaAgora}
              nivel={2}
              tamanhos={tamanhosCapa}
            />
          ))
        }
      </Grade>
    </Container>
  </Secao>

  <ConviteAssociese lang={lang} />
</LayoutSistema>
