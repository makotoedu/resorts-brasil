---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Grade from '../../components/layout/Grade.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Texto from '../../components/primitivos/Texto.astro';
import Botao from '../../components/primitivos/Botao.astro';
import Imagem from '../../components/primitivos/Imagem.astro';
import ChamadaAcao from '../../components/padroes/ChamadaAcao.astro';
import CaixaIcone from '../../components/padroes/CaixaIcone.astro';
import TituloSecao from '../../components/padroes/TituloSecao.astro';
import FaixaParceiros from '../../components/FaixaParceiros.astro';
import { ui, routes, type Locale } from '../../i18n/ui';

/* As correcoes desta pagina estao anotadas em src/pages/associe-se.astro, que
   e a versao de referencia. */
const lang: Locale = 'en-us';
const t = ui[lang];

/* A foto ocupa 5 das 12 colunas no desktop e a largura inteira no mobile. */
const tamanhosFoto = '(min-width: 48rem) 42vw, 92vw';
---

<LayoutSistema lang={lang} route="joinUs">
  <Secao id="join-us">
    <Container>
      {/* `mb-15` = 60px, que e o `<div class="space">` vazio do tema — um
          elemento sem conteudo cujo unico papel era abrir um vao. */}
      <Titulo nivel={1} papel="pagina" peso="medio" alinhamento="centro" class="mb-15">
        {t.joinTitle}
      </Titulo>

      <Grade colunas={2} piso={1} espaco="md" alinhamento="centro">
        <Imagem
          src="/images/hero/pexels-1134176.jpg"
          alt={t.joinPhotoAlt}
          escala="largura-total"
          tamanhos={tamanhosFoto}
          arredondada
        />

        <ChamadaAcao fundo="clara">
          <Titulo nivel={2} papel="secao">{t.joinLead}</Titulo>
          <Texto>{t.joinText}</Texto>
          <div class="botoes">
            {/*
              Sem `target="_blank"`. O tema abria o proprio site numa aba nova —
              o link ia para /fale-conosco, que e uma pagina daqui. Aba nova para
              destino interno tira do visitante o controle da navegacao e quebra
              a Voltar do navegador.
            */}
            <Botao href={routes.contact[lang]}>{t.joinInviteAction}</Botao>
            <Botao href={routes.associates[lang]} variante="contorno">{t.joinInviteSecondary}</Botao>
          </div>
        </ChamadaAcao>
      </Grade>
    </Container>
  </Secao>

  {/* `espacoBase="nenhum"` pelo mesmo motivo do <ConviteAssociese>: a
    <FaixaParceiros> logo abaixo ja abre com 80px, e os dois somavam 160. */}
  <Secao id="benefits" espacoTopo="nenhum" espacoBase="nenhum">
    <Container>
      <TituloSecao nivel={2}>{t.benefitsTitle}</TituloSecao>
      <Grade colunas={4} piso={1} espaco="md" alinhamento="inicio">
        {
          t.benefits.map((b) => (
            <CaixaIcone icone="check-circle" titulo={b.titulo} nivel={3} tom="acao">
              <Texto semMargem>{b.texto}</Texto>
            </CaixaIcone>
          ))
        }
      </Grade>
    </Container>
  </Secao>

  <FaixaParceiros lang={lang} comDescontos colunas={6} />

  <Secao id="cta" espacoTopo="nenhum">
    <Container>
      <ChamadaAcao
        fundo="imagem"
        imagem="/images/hero/pexels-161212.jpg"
        alt=""
        alinhamento="centro"
        tamanhos="100vw"
      >
        <Titulo nivel={2} papel="secao" cor="inverso">{t.joinCtaTitle}</Titulo>
        <Texto cor="inverso">{t.joinCtaText}</Texto>
        <div class="botoes">
          <Botao href={routes.associates[lang]} variante="clara">{t.joinCtaAction}</Botao>
        </div>
      </ChamadaAcao>
    </Container>
  </Secao>
</LayoutSistema>

<style>
  /*
   * Os botoes lado a lado, e embaixo um do outro quando nao couberem — a mesma
   * regra do <ConviteAssociese>, e pelo mesmo motivo: no tema eles eram dois
   * `<a>` soltos separados pelo espaco em branco do HTML, o que punha o segundo
   * a meio caminho da linha seguinte em 390px.
   */
  .botoes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }

  /* Dentro da chamada centrada, os botoes acompanham. */
  :global(.centro) .botoes {
    justify-content: center;
  }
</style>
