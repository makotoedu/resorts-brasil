---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  title={'Join Us - Resorts Brasil'}
  description={'Brazilian Association of Resorts'}
  route="joinUs"
>
    <!-- Join Us -->
    <section id="join-us">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Become a member</h1>
                </div>
            </div>
            <div class="space"></div>
            <div class="row">
                <div class="col-lg-5">
                    <img src="/images/hero/pexels-1134176.jpg"
                        class="img-fluid rounded" alt="resort">
                </div>
                <div class="col-lg-7">
                    <div class="call-to-action background-grey rounded">
                        <h2>We seek to help transform the tourism sector in Brazil, fighting on several fronts for a
                            stronger productive sector.</h2>
                        <p>Our plans and projects are designed by resorts for resorts. The growth of the association
                            is one of the pillars for our development and strengthening as a segment.</p>
                        <div class="m-b-20">
                            <a href="/en-us/contact-us" target="_blank" class="btn">Join us</a>
                            <a href="/en-us/associates" class="btn btn-outline">Meet the associates</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Join Us -->

    <!-- Benefits -->
    <section id="benefits" class="p-t-0">
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-40">
                    <h4>Benefits of becoming an associate </h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Fairs</h3>
                        <p>Participation in the main fairs of the industry in a cooperative stand.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>B2B</h3>
                        <p>Business roundtables in innovative formats with clients.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>B2C</h3>
                        <p>Join the Resort Week campaign.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Studies</h3>
                        <p>Get access to exclusive studies and statistics for our associates.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Advocacy</h3>
                        <p>We work with government spheres, in partnership with G20+ to advocate for the interests
                            of the category.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Benchmarking</h3>
                        <p>We encourage the exchange of ideas and knowledge through themed committees, holding
                            periodic meetings.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Discounts</h3>
                        <p>We have a series of partnerships in the market that generate special benefits and
                            discounts for members.</p>
                    </div>
                </div>
                <div class="col-lg-3">
                    <div class="icon-box small clean">
                        <div class="icon"> <a href="#"><i class="icon-check-circle"></i></a> </div>
                        <h3>Our brand</h3>
                        <p>Associates have the right to use the Resorts Brasil association brand.</p>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Benefits -->

    <!-- Maintainers and Partners -->
    <section id="parceiros">
        <div class="container">
            <div class="row m-b-30">
                <div class="heading-text heading-line text-center">
                    <h4>Meet a few of the companies that support tourism through Resorts Brasil</h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Maintainers:</h4>
                </div>
                <div class="col-lg-9">
                    <ul class="grid grid-6-columns text-center">
                        <li><a href="https://www.equipotel.com.br/" target="_blank"><img alt="Equipotel"
                                    src="/images/parceiros/equipotel.png"></a></li>
                        <li><a href="https://harus.ind.br/" target="_blank"><img alt="Harus"
                                    src="/images/parceiros/harus.png"></a></li>
                        <li><a href="https://www.nestleprofessional.com.br/" target="_blank"><img
                                    alt="Nestle Professional" src="/images/parceiros/nestle-professional.png"></a></li>
                        <li><a href="https://rentv.com.br/" target="_blank"><img alt="Rentv"
                                    src="/images/parceiros/rentv.png"></a></li>
                        <li><a href="https://www.r1audiovisual.com.br/" target="_blank"><img alt="R1 Audio Visual"
                                    src="/images/parceiros/r1-grupo.png"></a></li>
                        <li><a href="https://talge.com.br/" target="_blank"><img alt="Talge"
                                    src="/images/parceiros/talge.png"></a></li>
                        <li><a href="https://www.villacamarao.com.br/" target="_blank"><img alt="Villa Camarão"
                                    src="/images/parceiros/villa-camarao.png"></a></li>
                    </ul>
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Partners:</h4>
                </div>
                <div class="col-lg-9">
                    <ul class="grid grid-6-columns text-center">
                        <li><a href="https://www.amigosdobem.org/" target="_blank"><img alt="Amigos do bem"
                                    src="/images/parceiros/amigos-do-bem.png"></a></li>
                        <li><a href="https://www.sp.senac.br/" target="_blank"><img alt="senac"
                                    src="/images/parceiros/senac.png"></a></li>
                        <li><a href="https://eaesp.fgv.br/centros/fgvcemd" target="_blank"><img alt="fgv cemd"
                                    src="/images/parceiros/fgv-cemd.png"></a>
                        <li><a href="https://www.jll.com.br/" target="_blank"><img alt="JLL"
                                    src="/images/parceiros/jll.png"></a></li>
                        <li><a href="https://str.com/pt-br" target="_blank"><img alt="STR"
                                    src="/images/parceiros/str.png"></a></li>
                        <li><a href="#" target="_blank"><img alt="Arbache Consulting"
                                    src="/images/parceiros/arbache-consulting.png"></a></li>
                        <li><a href="https://gks.com.br/" target="_blank"><img alt="GKS"
                                    src="/images/parceiros/gks.png"></a></li>
                        <li><a href="https://esgpulse.com.br/" target="_blank"><img alt="ESG Pulse"
                                    src="/images/parceiros/esg-pulse.png"></a></li>
                        <li><a href="https://talge.com.br/" target="_blank"><img alt="Talge"
                                    src="/images/parceiros/talge.png"></a></li>
                        <li><a href="https://www.villacamarao.com.br/" target="_blank"><img alt="Villa Camarão"
                                    src="/images/parceiros/villa-camarao.png"></a></li>
                    </ul>
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center m-b-0" style="letter-spacing: 1px;">Discounts:</h4>
                    <p class="text-center">Courses and Events</p>
                </div>
                <div class="col-lg-9">
                    <ul class="grid grid-6-columns text-center">
                        <li><a href="https://escolapararesultados.com.br/" target="_blank"><img
                                    alt="Escola Para Resultados"
                                    src="/images/parceiros/escola-para-resultados.png"></a></li>
                        <li><a href="http://hsmaibrasil.org/" target="_blank"><img alt="hsmai brasil"
                                    src="/images/parceiros/hsmai-brasil.png"></a></li>
                        <li><a href="https://www.sp.senac.br/" target="_blank"><img alt="Senac SP"
                                    src="/images/parceiros/senac.png"></a></li>
                        <li><a href="https://www.markupconsult.com.br/" target="_blank"><img
                                    alt="Mark Up Consultoria" src="/images/parceiros/markup-consultoria.png"></a>
                        </li>
                    </ul>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Maintainers and Partners -->

    <!-- CTA -->
    <section id="cta">
        <div class="container">
            <div style="background-image:url('../images/hero/pexels-161212.jpg')"
                class="call-to-action p-t-100 p-b-100 background-image rounded mb-0">
                <div class="bg-overlay" data-style="2"></div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-10">
                            <h3 class="text-light">Meet the resorts that already are Resorts Brasil</h3>
                            <p class="text-light">Take part and help transform the sector. 😍</p>
                        </div>
                        <div class="col-lg-2">
                            <a href="/en-us/associates" class="btn btn-light btn-outline">Learn more</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
