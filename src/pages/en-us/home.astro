---
import GradeLogos from '../../components/GradeLogos.astro';
import { mantenedores, parceiros } from '../../data/parceiros';
import CarrosselAssociados from '../../components/CarrosselAssociados.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  route="home"
>
    <!-- Slider -->
    <section class="p-t-10 p-b-30">
        <div class="container">
            <div id="slider" class="inspiro-slider slider-halfscreen dots-creative rounded">
                <!-- Slide 1 -->
                <div class="slide kenburns rounded"
                    style="background-image:url('/images/hero/pexels-775687.jpg');">
                    <div class="container">
                        <div class="slide-captions text-center text-light">
                            <!-- Captions -->
                            <span class="strong">THROUGHOUT BRAZIL</span>
                            <h2 class="m-b-30">Live a Resort experience</h2>
                            <a class="btn btn-warning btn-lg" href="/en-us/associates">MEET THE RESORTS</a>
                            <!-- end: Captions -->
                        </div>
                    </div>
                </div>
                <!-- end: Slide 1 -->
            </div>
        </div>
    </section>
    <!-- end: Slider -->

    <!-- Association -->
    <section id="associacao" class="p-t-40 p-b-0">
        <div class="container">
            <div class="call-to-action background-grey rounded">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 m-b-30">
                            <h1 class="text-md h2">Helping to transform the resort segment and national tourism </h1>
                            <a href="/en-us/resorts-brasil" class="item-link">About the association &gt;</a>
                        </div>
                        <div class="col-lg-6">
                            <img src="/images/hero/pexels-57021.jpg"
                                alt="Periquito por Claire Thibault" class="img-fluid rounded center">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Association -->

    <!-- Destaques -->
    <section class="p-t-0">
        <div class="container">
            <div class="row">
                <!-- Support Tourism -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-1072842.jpg'); height: 360px;">
                        <div class="bg-overlay"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Support Tourism</h3>
                                <a href="/en-us/support-tourism" class="item-link">Learn more <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Support Tourism -->
                <!-- Become an associate -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-1437264.jpg'); height: 360px;">
                        <div class="bg-overlay"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Become an Associate</h3>
                                <a href="/en-us/join-us" class="item-link">Join us <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Become an associate -->
                <!-- Turistech Hub-->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-450062.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style=""></div>
                        <div class="container">
                            <div class="row">
                                <h3>Turistech Hub</h3>
                                <a href="https://www.turistechhub.com.br/" target="_blank" rel="noopener noreferrer" class="item-link">Learn
                                    more <i class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Turistech Hub -->
                <!-- ESG Booklet  -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-2246950.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style="0"></div>
                        <div class="container">
                            <div class="row">
                                <h3>ESG Resorts Brasil Booklet </h3>
                                <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                    target="_blank" rel="noopener noreferrer" class="item-link">Access the booklet <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: ESG Booklet -->
                <!-- Responsible Traveler Guide -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-161212.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style="10"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Responsible Traveler Guide</h3>
                                <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                    target="_blank" rel="noopener noreferrer" class="item-link">Access the guide <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- Responsible Traveler Guide -->
                <!-- E-book -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/destaques/ebook.png'); height: 360px;">
                        <div class="bg-overlay" data-style="10"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Managing the Traveller's Journey</h3>
                                <a href="/en-us/ebook" target="_blank" rel="noopener noreferrer" class="item-link">Download the e-book <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: E-book -->
            </div>
        </div>
    </section>
    <!-- end: Destaques -->

    <!-- Associated Resorts -->
    <section>
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-10">
                    <h4>Associated Resorts</h4>
                </div>
                <CarrosselAssociados />
            </div>
        </div>
    </section>
    <!-- end: Associated Resorts -->

    <!-- Maintainers and Partners -->
    <section id="maintainers-partners">
        <div class="container">
            <div class="row">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Maintainers:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={mantenedores} colunas={5} />
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Partners:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={parceiros} colunas={5} />
                </div>
            </div>
        </div>
    </section>
    <!-- end: Maintainers and Partners -->
</BaseLayout>
