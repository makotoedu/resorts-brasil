---
import GradeLogos from '../../components/GradeLogos.astro';
import { mantenedores, parceiros } from '../../data/parceiros';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  route="resortsBrasil"
>
    <!-- Title -->
    <section id="title" class="p-b-0">
        <div class="container">
            <div class="row m-b-30">
                <div class="col-lg-8 center text-center">
                    <h1 class="text-md h2">Resorts Brasil</h1>
                    <h3>We work together with associates for the resort segment and the tourism sector.</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Title -->

    <!-- Resorts Brasil -->
    <section id="resorts-brasil" class="p-t-0">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center rounded m-b-30"
                    style="background-image:url('https://images.unsplash.com/photo-1596436889106-be35e843f974?ixlib=rb-1.2.1&ixid=MnwxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8&auto=format&fit=crop&w=1170&q=80'); height: 400px;">
                </div>
                <div class="col-lg-10 center text-center">
                    <h4 class="text-muted">To better organize our strategies, we act in three fronts:</h4>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Resorts Brasil -->

    <!-- Boxes -->
    <section class="box-fancy section-fullwidth text-light p-t-0">
        <div class="row">
            <div class="col-lg-4 text-center" style="background-color: #EFB72C;">
                <h2 class="text-lg">RE</h2>
                <h4>REPRESENT AND ENGAGE</h4>
                <p>This front is focused on representing the sector and we dialogue with the Government, to work on
                    the main demands of the segment.</p>
                <p>We also seek to represent the resorts at the main market events, engaging partners and associates
                    in strengthening the resorts.</p>
            </div>
            <div class="col-lg-4 text-center" style="background-color: #15184B;">
                <h2 class="text-lg">SO</h2>
                <h4>SENSITIZE THE LOOK</h4>
                <p>Front focused on information with the development of research and relevant publications that can
                    generate value for the member and that can strengthen the segment, showing the importance of
                    resorts for national tourism.</p>
            </div>
            <div class="col-lg-4 text-center" style="background-color: #28B055;">
                <h2 class="text-lg">RT</h2>
                <h4>REFLECT TO TRANSFORM</h4>
                <p>Focused on collective actions of associates, this front seeks to identify themes of common
                    interest in the resort segment for joint action.</p>
                <p>We work hard with promotions, in addition to meetings in committees and working groups to share
                    challenges and think about solutions for the sector.</p>
            </div>
        </div>
    </section>
    <!-- end: Boxes -->

    <!-- Video -->
    <section class="p-b-0">
        <div class="container">
            <div class="row">
                <div class="col-lg-6 m-b-20">
                    <div class="call-to-action background-grey rounded">
                        <h2>The association exists to contribute to the strengthening and development of tourism, as
                            well as the locations where the resorts are present.</h2>
                        <p>We believe resorts drive the socioeconomic development that transform the lives of many
                            people. Therefore, we seek to connect professionals, inspire good practices and advocate
                            for Brazilian resorts.</p>
                    </div>
                </div>
                <div class="col-lg-6">
                    <iframe width="560" height="420" src="https://www.youtube.com/embed/LJ_9oUeE4e8" title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Video -->

    <!-- Maintainers and Partners -->
    <section id="parceiros">
        <div class="container">
            <div class="row m-b-30">
                <div class="heading-text heading-line text-center">
                    <h4>Meet a few of the companies that support tourism through Resorts Brasil</h4>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Maintainers:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={mantenedores} colunas={5} />
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Partners:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={parceiros} colunas={5} />
                </div>
            </div>
            <hr class="space">
            <div class="text-center">
                <h5 class="text-muted">#SupportBrazilianTourism❤️</h5>
            </div>
        </div>
    </section>
    <!-- end: Maintainers and Partners -->

    <!-- CTA -->
    <section id="cta">
        <div class="container">
            <div style="background-image:url('/images/hero/pexels-161212.jpg')"
                class="call-to-action p-t-100 p-b-100 background-image rounded mb-0">
                <div class="bg-overlay" data-style="2"></div>
                <div class="container">
                    <div class="row">
                        <div class="col-lg-10">
                            <h3 class="text-light">Do you want to be part of a select group of Brazilian resorts?
                            </h3>
                            <p class="text-light">Take part and help transform the sector. 😍</p>
                        </div>
                        <div class="col-lg-2">
                            <a href="/en-us/join-us" class="btn btn-light btn-outline">Become member</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
