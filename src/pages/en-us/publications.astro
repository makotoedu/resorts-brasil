---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  route="publications"
>
    <!-- Title -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Publications</h1>
                    <h3>One of our missions is to generate relevant information for the market. Check out our latest
                        publications below:</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Title -->

    <!-- Publications -->
    <section id="publications" class="no-padding">
        <div class="container">
            <div class="grid-layout post-5-columns m-b-30" data-item="post-item" data-margin="30">
                <!-- ESG Booklet -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank" rel="noopener noreferrer">
                                <img alt="capa" src="/images/publicacoes/cartilha-esg-resorts-brasil.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>ESG Resorts Brasil Booklet</h2>
                            <p>Guidelines for implementing good practices in the industry</p>
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank" rel="noopener noreferrer" class="item-link">Read now <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: ESG Booklet -->
                <!-- Ebook -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank" rel="noopener noreferrer">
                                <img alt="capa" src="/images/publicacoes/a-gestao-da-jornada-do-viajante.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Managing the Traveller's Journey</h2>
                            <p>New context, business transformations and digital solutions...</p>
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank" rel="noopener noreferrer" class="item-link">Read now <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Ebook-->
                <!-- Memories -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank" rel="noopener noreferrer">
                                <img alt="capa"
                                    src="/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg">
                            </a>
                            <span class="post-meta-category">2021</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Memories, sustainability and a look to the future</h2>
                            <p>Twenty years ago, a movement of unity began...</p>
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank" rel="noopener noreferrer" class="item-link">Read now <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Memories -->
                <!-- Responsible traveler guide -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank" rel="noopener noreferrer">
                                <img alt="capa" src="/images/publicacoes/guia-do-viajante-responsavel.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Responsible traveler guide</h2>
                            <p>Safe travel depends on all of us. Supera Turismo Brasil Movement.</p>
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank" rel="noopener noreferrer" class="item-link">Read now <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Responsible traveler guide -->
                <!-- Protocols -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank" rel="noopener noreferrer">
                                <img alt="capa"
                                    src="/images/publicacoes/protocolos-de-higiene-e-seguranca-meios-de-hospedagem.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Hygiene and safety protocols in lodging facilities</h2>
                            <p>The premises presented below were...</p>
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank" rel="noopener noreferrer" class="item-link">Read now <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Protocols -->
            </div>
        </div>
    </section>
    <!-- end: Publications -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">Do you want to be part of a select group of Brazilian resorts?</h3>
                <p>Take part and help transform the sector. 😍</p>
                <div>
                    <a href="/en-us/join-us" class="btn">Become a member</a>
                    <a href="/en-us/associates" class="btn btn-outline">Meet the associates</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
