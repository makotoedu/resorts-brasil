---
import ListaPublicacoes from '../../components/ListaPublicacoes.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  route="publications"
>
    <!-- Title -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Publications</h1>
                    <h3>One of our missions is to generate relevant information for the market. Check out our latest
                        publications below:</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Title -->

    <!-- Publications -->
    <section id="publications" class="no-padding">
        <div class="container">
            <div class="grid-layout post-5-columns m-b-30" data-item="post-item" data-margin="30">
                <ListaPublicacoes lang="en-us" />
            </div>
        </div>
    </section>
    <!-- end: Publications -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">Do you want to be part of a select group of Brazilian resorts?</h3>
                <p>Take part and help transform the sector. 😍</p>
                <div>
                    <a href="/en-us/join-us" class="btn">Become a member</a>
                    <a href="/en-us/associates" class="btn btn-outline">Meet the associates</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
