---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="en-us"
  title={'Associates - Resorts Brasil'}
  description={'Brazilian Association of Resorts'}
  route="associates"
>
    <!-- Title -->
    <section id="title">
        <div class="container">
            <div class="row m-b-30">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md">Associated Resorts</h1>
                    <h3>We represent the country's major resorts, which undergo a careful affiliation and analysis
                        process according to the association's classification matrix.</h3>
                </div>
            </div>
            <!-- Stats -->
            <div class="row justify-content-md-center">
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-refresh-interval="50" data-to="80" data-from="1"></span>
                        </div>
                        <p>Resorts Associados</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-suffix=" mil" data-speed="500" data-refresh-interval="50" data-to="21"
                                data-from="1"></span>
                        </div>
                        <p>Quartos</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-suffix=" mil" data-speed="500" data-refresh-interval="50" data-to="20"
                                data-from="1"></span>
                        </div>
                        <p>Empregos Diretos</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-refresh-interval="50" data-to="16" data-from="1"></span>
                        </div>
                        <p>Estados</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-to="5" data-from="1"></span>
                        </div>
                        <p>Regiões do Brasil</p>
                    </div>
                </div>
            </div>
            <!-- end: Stats -->
        </div>
    </section>
    <!-- end: Title -->

    <!-- Map -->
    <section id="mapa" class="no-padding">
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-40">
                    <h4>Meet our associates:</h4>
                </div>
                <div class="col-lg-10 center text-center">
                    <img class="img-fluid" src="/images/ilustracao/mapa.png" alt="mapa">
                </div>
            </div>
        </div>
    </section>
    <!-- end: Map -->

    <!-- Associates -->
