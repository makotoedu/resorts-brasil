            <div class="row">
                <div class="tabs">
                    <!-- Navigation -->
                    <ul class="nav nav-tabs nav-justified" id="resorts" role="tablist">
                        <li class="nav-item">
                            <a class="nav-link active" id="sudeste-tab" data-bs-toggle="tab" href="#sudeste"
                                role="tab" aria-controls="sudeste" aria-selected="true">SOUTHEAST</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="sul-tab" data-bs-toggle="tab" href="#sul" role="tab"
