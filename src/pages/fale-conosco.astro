---
import { contato } from '../data/contato';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  route="contact"
>
    <!-- Fale conosco -->
    <section id="fale-conosco">
        <div class="container">
            <div class="row">
                <div class="text-center">
                    <h1 class="text-md h2">Como você prefere falar<br>com a gente?</h1>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Fale conosco -->

    <!-- Contato -->
    <section id="contato" class="p-t-0">
        <div class="container">
            <div class="call-to-action p-t-100 background-grey rounded">
                <div class="row">
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href={`mailto:${contato.email}`}><i class="icon-mail"></i></a>
                            </div>
                            <h3>E-mail</h3>
                            <p>Tem alguma dúvida? Podemos te ajudar pelo nosso canal de e-mail.<br>
                                <b>{contato.email}</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href={contato.endereco.mapa}><i class="icon-map-pin"></i></a>
                            </div>
                            <h3>Endereço</h3>
                            <p>Nosso endereço para correspondências é:<br>
                                <b>{contato.endereco.linha}</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href={`mailto:${contato.imprensa.email}`}><i class="icon-message-square"></i></a>
                            </div>
                            <h3>Imprensa</h3>
                            <p>Anagrama Comunicação e Eventos.<br><b>{contato.imprensa.email}</b><br><b>+55 11
                                    95038-7232</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href={contato.whatsapp.link} target="_blank" rel="noopener noreferrer"><i
                                        class="fab fa-whatsapp"></i></a>
                            </div>
                            <h3>WhatsApp</h3>
                            <p>Converse com nossa equipe via WhatsApp.<br><b>+55 11 95058-0313</b></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Contato -->
</BaseLayout>
