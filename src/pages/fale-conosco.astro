---
import LayoutSistema from '../layouts/LayoutSistema.astro';
import PaginaContato from '../components/PaginaContato.astro';

/*
 * O corpo vive uma vez so no <PaginaContato>: as tres versoes de idioma eram
 * identicas fora o `lang`, e uma delas ja tinha divergido (o telefone do
 * WhatsApp, so em ingles). Ver a nota daquele arquivo, e docs/decisoes.md,
 * "Fale conosco por assunto".
 */
---

<LayoutSistema lang="pt-br" route="contact">
  <PaginaContato lang="pt-br" />
</LayoutSistema>
