---
import GradeLogos from '../components/GradeLogos.astro';
import { mantenedores, parceiros } from '../data/parceiros';
import CarrosselAssociados from '../components/CarrosselAssociados.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  route="home"
>
    <!-- Slider -->
    <section class="p-t-10 p-b-30">
        <div class="container">
            <div id="slider" class="inspiro-slider slider-halfscreen dots-creative rounded">
                <!-- Slide 1 -->
                <div class="slide kenburns rounded"
                    style="background-image:url('/images/hero/pexels-775687.jpg');">
                    <div class="container">
                        <div class="slide-captions text-center text-light">
                            <!-- Captions -->
                            <span class="strong">EM TODO O BRASIL</span>
                            <h2 class="m-b-30">Viva a experiência de um Resort</h2>
                            <a class="btn btn-warning btn-lg" href="/associados">Conheça os resorts</a>
                            <!-- end: Captions -->
                        </div>
                    </div>
                </div>
                <!-- end: Slide 1 -->
            </div>
        </div>
    </section>
    <!-- end: Slider -->

    <!-- Associação -->
    <section id="associacao" class="p-t-40 p-b-0">
        <div class="container">
            <div class="call-to-action background-grey rounded">
                <div class="container">
                    <div class="row">
                        <div class="col-lg-6 m-b-30">
                            <h1 class="text-md h2">Ajudando a transformar o segmento de resorts e o turismo nacional
                            </h1>
                            <a href="/resorts-brasil" class="item-link">Conheça a associação &gt;</a>
                        </div>
                        <div class="col-lg-6">
                            <img src="/images/hero/pexels-57021.jpg"
                                alt="Periquito por Claire Thibault" class="img-fluid rounded center">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Associação -->

    <!-- Destaques -->
    <section class="p-t-0">
        <div class="container">
            <div class="row">
                <!-- Apoie o Turismo -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-1072842.jpg'); height: 360px;">
                        <div class="bg-overlay"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Apoie o Turismo</h3>
                                <a href="/apoie" class="item-link">Saiba mais <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Apoie o Turismo -->
                <!-- Associe-se -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-1437264.jpg'); height: 360px;">
                        <div class="bg-overlay"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Seja um associado</h3>
                                <a href="/associe-se" class="item-link">Associe-se <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Associe-se -->
                <!-- Turistech -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-450062.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style=""></div>
                        <div class="container">
                            <div class="row">
                                <h3>Turistech Hub</h3>
                                <a href="https://www.turistechhub.com.br/" target="_blank" rel="noopener noreferrer" class="item-link">Saiba
                                    mais <i class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Turistech -->
                <!-- Cartilha ESG -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-2246950.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style="0"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Cartilha ESG Resorts Brasil</h3>
                                <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                    target="_blank" rel="noopener noreferrer" class="item-link">Acesse a cartilha <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Cartilha ESG -->
                <!-- Guia do Viajante -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/hero/pexels-161212.jpg'); height: 360px;">
                        <div class="bg-overlay" data-style="10"></div>
                        <div class="container">
                            <div class="row">
                                <h3>Guia do Viajante Responsável</h3>
                                <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                    target="_blank" rel="noopener noreferrer" class="item-link">Acesse o guia <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: Guia do Viajante -->
                <!-- E-book -->
                <div class="col-lg-4 m-b-20">
                    <div class="call-to-action background-image rounded text-center text-bottom text-light"
                        style="background-image:url('/images/destaques/ebook.png'); height: 360px;">
                        <div class="bg-overlay" data-style="10"></div>
                        <div class="container">
                            <div class="row">
                                <h3>A Gestão da Jornada do Viajante</h3>
                                <a href="/ebook" target="_blank" rel="noopener noreferrer" class="item-link">Baixe o e-book <i
                                        class="icon-chevron-right"></i></a>
                            </div>
                        </div>
                    </div>
                </div>
                <!-- end: E-book -->
            </div>
        </div>
    </section>
    <!-- end: Destaques -->

    <!-- Resorts Associados -->
    <section id="resorts-associados">
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-10">
                    <h4>Resorts Associados</h4>
                </div>
                <CarrosselAssociados />
            </div>
        </div>
    </section>
    <!-- end: Resorts Associados -->

    <!-- Parceiros -->
    <section id="mantenedores-parceiros">
        <div class="container">
            <div class="row m-b-30">
                <div class="col-lg-8 center">
                    <div class="heading-text heading-line text-center">
                        <h4>Conheça algumas empresas que apoiam o turismo através da Resorts Brasil</h4>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Mantenedores:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={mantenedores} colunas={5} />
                </div>
            </div>
            <div class="row p-t-30">
                <div class="col-lg-3 text-bottom">
                    <h4 class="text-center" style="letter-spacing: 1px;">Parceiros:</h4>
                </div>
                <div class="col-lg-9">
                    <GradeLogos itens={parceiros} colunas={5} />
                </div>
            </div>
            <hr class="space">
            <div class="text-center">
                <h5 class="text-muted">#ApoieOTurismoBrasileiro❤️</h5>
            </div>
        </div>
    </section>
    <!-- end: Parceiros -->
</BaseLayout>
