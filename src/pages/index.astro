---
import LayoutSistema from '../layouts/LayoutSistema.astro';
import Secao from '../components/layout/Secao.astro';
import Container from '../components/layout/Container.astro';
import Grade from '../components/layout/Grade.astro';
import Titulo from '../components/primitivos/Titulo.astro';
import Botao from '../components/primitivos/Botao.astro';
import Imagem from '../components/primitivos/Imagem.astro';
import Hero from '../components/padroes/Hero.astro';
import ChamadaAcao from '../components/padroes/ChamadaAcao.astro';
import LinkAcao from '../components/padroes/LinkAcao.astro';
import DestaquesHome from '../components/DestaquesHome.astro';
import FaixaAssociados from '../components/FaixaAssociados.astro';
import FaixaParceiros from '../components/FaixaParceiros.astro';
import { ui, routes, type Locale } from '../i18n/ui';

/*
 * A home. E a pagina de maior visibilidade do site e a ultima antes do ebook.
 *
 * O ACHADO DA ETAPA, e ele nao estava previsto: O CARROSSEL DE LOGOS DAS TRES
 * HOMES ESTAVA INVISIVEL EM PRODUCAO. `.carousel` tem `opacity: 0` e
 * `visibility: hidden`, e so `.carousel.carousel-loaded` devolve as duas — classe
 * que o init do flickity punha e que saiu com o jQuery. As tres paginas baixavam
 * 70 logotipos em tamanho original para nao mostrar nenhum, e nenhum dos quatro
 * portoes viu. A analise completa esta no <CarrosselLogos>.
 *
 * CINCO CORRECOES DELIBERADAS, nos tres idiomas:
 *
 *   1. HIERARQUIA. O `<h2>` do hero vinha ANTES do `<h1 class="text-md h2">` da
 *      associacao — h1 nao era o primeiro heading da pagina —, e depois vinham
 *      seis `<h3>` e tres `<h4>`, todos escolhidos pelo tamanho. Agora o hero e
 *      o h1 e as secoes sao h2, com os rotulos da faixa de parceiros em h3.
 *   2. O TITULO DA FAIXA DE PARCEIROS SO EXISTIA EM PORTUGUES. "Conheca algumas
 *      empresas que apoiam o turismo atraves da Resorts Brasil" estava na home
 *      brasileira e nao nas outras duas, que abriam a faixa direto no rotulo
 *      "Maintainers:". Vem da <FaixaParceiros>, e agora esta nas tres.
 *   3. O HASHTAG TAMBEM SO EXISTIA EM PORTUGUES, e traduzido ele ja existia no
 *      `ui.ts` desde a Etapa 8 (#SupportBrazilianTourism, #ApoyeElTurismoBrasileño).
 *   4. O `id` DA SECAO DE ASSOCIADOS so estava na home portuguesa; o rotulo
 *      espanhol de parceiros era "Socios / Partners:", o unico dos nove com duas
 *      linguas na mesma linha.
 *   5. O ALT DA FOTO DA ASSOCIACAO estava em portugues nas tres — "Periquito por
 *      Claire Thibault" tambem em /en-us/home. Alt e texto lido em voz alta.
 *
 * E DOIS `style=` INLINE POR IDIOMA SOMEM COM O MARKUP: o `height: 360px` dos
 * seis cartoes (que fazia o cartao do celular ficar mais alto que largo) e o
 * `letter-spacing: 1px` dos rotulos da faixa de parceiros.
 */
const lang: Locale = 'pt-br';
const t = ui[lang];

/* A foto ocupa metade do bloco no desktop e a largura toda abaixo de 48rem. */
const tamanhosFoto = '(min-width: 64rem) 46vw, 92vw';
---

<LayoutSistema lang={lang} route="home">
  <Secao id="hero" espacoTopo="nenhum" espacoBase="sm">
    <Container>
      {/*
        O hero da home e a PRIMEIRA imagem visivel da pagina: `prioridade` fica
        no padrao (`true`), entao ela carrega sem lazy e com `fetchpriority`.
      */}
      <Hero
        imagem="/images/hero/pexels-775687.jpg"
        alt=""
        sobretitulo={t.homeHeroKicker}
        titulo={t.homeHeroTitle}
        nivel={1}
      >
        <Botao href={routes.associates[lang]} variante="destaque" tamanho="lg">
          {t.homeHeroAction}
        </Botao>
      </Hero>
    </Container>
  </Secao>

  <Secao id="associacao" espacoTopo="nenhum" espacoBase="sm">
    <Container>
      <ChamadaAcao fundo="clara">
        <Grade colunas={2} piso={1} espaco="md" alinhamento="centro">
          {/*
            O <div> e daqui, e nao uma `class` passada a <Grade>: classe escopada
            entregue pela prop `class` de um componente chega ao HTML sem o
            atributo de escopo, e a regra fica inerte sem erro nenhum. Ver
            docs/decisoes.md, "Etapa 8".
          */}
          <div class="texto">
            <Titulo nivel={2} papel="secao" peso="medio">{t.homeAssociationTitle}</Titulo>
            <LinkAcao href={routes.resortsBrasil[lang]}>{t.homeAssociationAction}</LinkAcao>
          </div>

          <Imagem
            src="/images/hero/pexels-57021.jpg"
            alt={t.homeAssociationPhotoAlt}
            escala="largura-total"
            tamanhos={tamanhosFoto}
            arredondada
          />
        </Grade>
      </ChamadaAcao>
    </Container>
  </Secao>

  <DestaquesHome lang={lang} />

  <FaixaAssociados lang={lang} />

  <FaixaParceiros lang={lang} comHashtag colunas={5} />
</LayoutSistema>

<style>
  /* MEDIDO: 16px entre o titulo e o link, dentro do bloco da associacao. */
  .texto :global(h2) {
    margin-bottom: 1rem;
  }
</style>
