---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  title={'Estatísticas e Estudos - Resorts Brasil'}
  description={'Associação Brasileira de Resorts'}
  route="statistics"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-9 center text-center">
                    <h1 class="text-md h2">Estatísticas e Estudos</h1>
                    <h3>Confira abaixo os últimos estudos do setor de resorts, elaborados pela Resorts Brasil
                        ou por parceiros.</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Estatisticas e Estudos -->
    <section id="estatisticas-e-estudos" class="no-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 center">
                    <div class="grid-layout post-4-columns m-b-30" data-item="post-item">
                        <!-- Cartilha Executiva Reforma Tributaria -->
                        <div class="post-item border">
                            <div class="post-item-wrap rounded">
                                <div class="post-image">
                                    <a href="https://drive.google.com/file/d/1rfKxFznjwbnodOxtYlys0Qg74AJ02Hku/view?usp=sharing"
                                        target="_blank"><img
                                            src="/images/estatisticas-e-estudos/cartilha-executiva-reforma-tributaria-resorts-brasil-2026.png"
                                            alt="Capa da Cartilha Executiva Reforma Tributaria"></a>
                                </div>
                                <div class="post-item-description">
                                    <h2>Cartilha Executiva Reforma Tributaria</h2>
                                    <a href="https://drive.google.com/file/d/1rfKxFznjwbnodOxtYlys0Qg74AJ02Hku/view?usp=sharing"
                                        target="_blank" class="item-link">Leia agora <i
                                            class="icon-chevron-right"></i></a>
                                </div>
                            </div>
                        </div>
                        <!-- end: Cartilha Executiva Reforma Tributaria -->
                        <!-- Pesquisa Canais de Distribuição -->
                        <div class="post-item border">
                            <div class="post-item-wrap rounded">
                                <div class="post-image">
                                    <a href="https://drive.google.com/file/d/1lhSPpB84LxfSYUEp_wpMFcBqquS0_wz6/view?usp=sharing"
                                        target="_blank"><img
                                            src="/images/estatisticas-e-estudos/pesquisa-canais-de-distribuicao.jpg"
                                            alt="Capa da Pesquisa Canais de Distribuição Resorts Brasil"></a>
                                </div>
                                <div class="post-item-description">
                                    <h2>Pesquisa Canais de Distribuição</h2>
                                    <a href="https://drive.google.com/file/d/1lhSPpB84LxfSYUEp_wpMFcBqquS0_wz6/view?usp=sharing"
                                        target="_blank" class="item-link">Leia agora <i
                                            class="icon-chevron-right"></i></a>
                                </div>
                            </div>
                        </div>
                        <!-- end: Pesquisa Canais de Distribuição -->
                        <!-- Radar Resorts Brasil -->
                        <div class="post-item border">
                            <div class="post-item-wrap rounded">
                                <div class="post-image">
                                    <a href="https://drive.google.com/file/d/12oUWoUkp56U8zrqGJgQYfqhI9w8FaDQK/view?usp=sharing"
                                        target="_blank"><img
                                            src="/images/estatisticas-e-estudos/radar-resorts-brasil.jpg"
                                            alt="Capa do Radar Resorts Brasil"></a>
                                </div>
                                <div class="post-item-description">
                                    <h2>Radar Resorts Brasil Jul/25</h2>
                                    <a href="https://drive.google.com/file/d/12oUWoUkp56U8zrqGJgQYfqhI9w8FaDQK/view?usp=sharing"
                                        target="_blank" class="item-link">Leia agora <i
                                            class="icon-chevron-right"></i></a>
                                </div>
                            </div>
                        </div>
                        <!-- end: Radar Resorts Brasil -->
                        <!-- Hotelaria em Números -->
                        <div class="post-item border">
                            <div class="post-item-wrap rounded">
                                <div class="post-image">
                                    <a href="https://drive.google.com/file/d/18qStZLOeHsfQet0Ie2bfqseliKuI5PDa/view?usp=sharing"
                                        target="_blank"><img
                                            src="/images/estatisticas-e-estudos/hotelaria-em-numeros.jpg"
                                            alt="Capa de Hotelaria em Números"></a>
                                </div>
                                <div class="post-item-description">
                                    <h2>Hotelaria em Números</h2>
                                    <a href="https://drive.google.com/file/d/18qStZLOeHsfQet0Ie2bfqseliKuI5PDa/view?usp=sharing"
                                        target="_blank" class="item-link">Leia agora <i
                                            class="icon-chevron-right"></i></a>
                                </div>
                            </div>
                        </div>
                        <!-- end: Hotelaria em Números -->
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Estatisticas e Estudos -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">Quer fazer parte de um grupo seleto de resorts brasileiros?</h3>
                <p>Faça parte e ajude a transformar o setor. 😍</p>
                <div>
                    <a href="/associe-se" class="btn">Associe-se</a>
                    <a href="/associados" class="btn btn-outline">Conheça os associados</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
