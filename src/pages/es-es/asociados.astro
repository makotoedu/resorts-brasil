---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Grade from '../../components/layout/Grade.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Texto from '../../components/primitivos/Texto.astro';
import Imagem from '../../components/primitivos/Imagem.astro';
import Contador from '../../components/padroes/Contador.astro';
import TituloSecao from '../../components/padroes/TituloSecao.astro';
import AssociadosTabs from '../../components/AssociadosTabs.astro';
import ConviteAssociese from '../../components/ConviteAssociese.astro';
import { indicadoresAssociados } from '../../data/associados';
import { ui, type Locale } from '../../i18n/ui';

/* As correcoes desta pagina estao anotadas em src/pages/associados.astro, que e
   a versao de referencia. Duas delas nasceram aqui: os numeros diziam 80 onde o
   portugues dizia 83, e os cinco rotulos estavam em portugues. */
const lang: Locale = 'es-es';
const t = ui[lang];

const tamanhosMapa = '(min-width: 60rem) 60rem, 92vw';
---

<LayoutSistema lang={lang} route="associates">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="media">
      <Titulo nivel={1} papel="pagina" peso="medio" alinhamento="centro">{t.associatesTitle}</Titulo>
      <Texto tamanho="lg" alinhamento="centro">{t.associatesLead}</Texto>
    </Container>
  </Secao>

  <Secao id="indicadores">
    <Container>
      <Grade colunas={5} piso={2} espaco="md">
        {
          indicadoresAssociados.map((i) => (
            <Contador
              ate={i.ate}
              de={1}
              sufixo={i.sufixo ? t.associatesStatsSuffix : ''}
              rotulo={t.associatesStats[i.id]}
            />
          ))
        }
      </Grade>
    </Container>
  </Secao>

  <Secao id="mapa" espacoTopo="nenhum">
    <Container largura="media">
      <TituloSecao nivel={2}>{t.associatesMapTitle}</TituloSecao>
      <Imagem
        src="/images/ilustracao/mapa.png"
        alt={t.associatesMapAlt}
        escala="largura-total"
        tamanhos={tamanhosMapa}
      />
    </Container>
  </Secao>

  <Secao id="asociados" espacoTopo="nenhum">
    <Container>
      <AssociadosTabs lang={lang} />
    </Container>
  </Secao>

  <ConviteAssociese lang={lang} secundario={false} />
</LayoutSistema>
