---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es-es"
  title={'Historia - Resorts Brasil'}
  description={'Asociación Brasileña de Resorts'}
  route="history"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Historia</h1>
                    <h3>La idea de la creación de una entidad que representase los intereses del sector empezó en el
                        año 2000 y fue tomando forma durante el Festival de Turismo de Gramado.</h3>
                    <p>En diciembre de 2001, oficialmente, Resorts Brasil fue fundada, fruto de la iniciativa de 12
                        empresas del sector.</h4>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Fundadores -->
    <section id="fundadores" class="p-t-0">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 center">
                    <div class="row">
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Accor Sofitel</li>
                                <li>Blue Tree Park Angra dos Reis</li>
                                <li>Blue Tree Cabo de Santo Agostinho</li>
                                <li>Costão do Santinho Resort</li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Hotel do Frade</li>
                                <li>Mabu Hotéis & Resorts</li>
                                <li>Porto Bello</li>
                                <li>Pousada do Rio Quente</li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Club Hotel Salinas do Maragogi</li>
                                <li>Summerville Hotel</li>
                                <li>Superclubs</li>
                                <li>Tropical Manaus</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Fundadores -->

    <!-- Publicacoes -->
    <section id="publicacoes" class="box-fancy section-fullwidth text-light no-padding">
        <div class="row">
            <div class="col-lg-8 text-center" style="background-color: #242F9B;">
                <p class="text-bold">20 AÑOS</p>
                <h2 class="text-lg">Memorias, sustentabilidad y una mirada hacia el futuro</h2>
                <a class="btn btn-light btn-outline"
                    href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                    target="_blank">Lea ahora</a>
            </div>
            <div class="col-lg-4 text-center" style="background-color: #FAC213;">
                <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view" target="_blank">
                    <img class="img-fluid rounded"
                        src="/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg"
                        alt="capa">
                </a>
            </div>
        </div>
    </section>
    <!-- end: Publicacoes -->
</BaseLayout>
