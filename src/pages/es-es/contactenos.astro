---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es-es"
  title={'Contáctenos - Resorts Brasil'}
  description={'Asociación Brasileña de Resorts'}
  route="contact"
>
    <!-- Fale conosco -->
    <section id="fale-conosco">
        <div class="container">
            <div class="row">
                <div class="text-center">
                    <h1 class="text-md h2">¿Cómo prefieres hablar <br>con nosotros?</h1>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Fale conosco -->

    <!-- Contato -->
    <section id="contato" class="p-t-0">
        <div class="container">
            <div class="call-to-action p-t-100 background-grey rounded">
                <div class="row">
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="mailto:contato@resortsbrasil.com.br"><i class="icon-mail"></i></a>
                            </div>
                            <h3>E-mail</h3>
                            <p>¿Tienes alguna duda? Podemos ayudarte a través de nuestro canal de correo
                                electrónico.<br>
                                <b>contato@resortsbrasil.com.br</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="https://goo.gl/maps/osRdE2bZhqc1hCk78"><i class="icon-map-pin"></i></a>
                            </div>
                            <h3>Dirección</h3>
                            <p>Nuestra dirección de correo es:<br>
                                <b>R. Prof. Carlos de Carvalho, 28, sl. 82 - Itaim Bibi, São Paulo - SP</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="mailto:cristiane@hatsur.com"><i class="icon-message-square"></i></a>
                            </div>
                            <h3>Prensa</h3>
                            <p>Anagrama Comunicação e Eventos.<br><b>reila@anagrama.com.br</b><br><b>+55 11
                                    95038-7232</b>
                            </p>
                        </div>
                    </div>
                    <div class="col-lg-3">
                        <div class="icon-box small clean">
                            <div class="icon">
                                <a href="https://wa.me/5511950580313" target="_blank"><i
                                        class="fab fa-whatsapp"></i></a>
                            </div>
                            <h3>WhatsApp</h3>
                            <p>Contacta con nuestro equipo por WhatsApp.<br><b>+55 11 95058-0313</b></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Contato -->
</BaseLayout>
