---
import GradeMembros from '../../components/GradeMembros.astro';
import { diretoria, conselhoConsultivo } from '../../data/diretoria';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es-es"
  route="board"
>
    <!-- Directorio -->
    <section id="directorio" class="p-b-0">
        <div class="container">
            <div class="row text-center">
                <h1 class="m-b-10 h2">Directorio de Resorts Brasil</h1>
                <h4 class="text-muted">Bienio 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={diretoria} lang="es-es" />
        </div>
    </section>
    <!-- end: Directorio -->

    <!-- Consejo Consultivo -->
    <section id="consejo-consultivo">
        <div class="container">
            <div class="row text-center">
                <h2 class="m-b-10">Consejo Consultivo</h2>
                <h4 class="text-muted">Bienio 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={conselhoConsultivo} lang="es-es" />
        </div>
    </section>
    <!-- end: Consejo Consultivo -->
</BaseLayout>
