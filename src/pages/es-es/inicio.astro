---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Grade from '../../components/layout/Grade.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Botao from '../../components/primitivos/Botao.astro';
import Imagem from '../../components/primitivos/Imagem.astro';
import Hero from '../../components/padroes/Hero.astro';
import ChamadaAcao from '../../components/padroes/ChamadaAcao.astro';
import LinkAcao from '../../components/padroes/LinkAcao.astro';
import DestaquesHome from '../../components/DestaquesHome.astro';
import FaixaAssociados from '../../components/FaixaAssociados.astro';
import FaixaParceiros from '../../components/FaixaParceiros.astro';
import { ui, routes, type Locale } from '../../i18n/ui';

/* As correcoes desta pagina estao anotadas em src/pages/index.astro, que e a
   versao de referencia. DUAS delas nasceram aqui: o rotulo de parceiros era
   "Socios / Partners:", o unico dos nove com duas linguas na mesma linha, e os
   dois rotulos vizinhos dos destaques tratavam o leitor por usted num cartao
   ("Acceda a la cartilla") e por tu no seguinte ("Accede a la guia"). */
const lang: Locale = 'es-es';
const t = ui[lang];

const tamanhosFoto = '(min-width: 64rem) 46vw, 92vw';
---

<LayoutSistema lang={lang} route="home">
  <Secao id="hero" espacoTopo="nenhum" espacoBase="sm">
    <Container>
      <Hero
        imagem="/images/hero/pexels-775687.jpg"
        alt=""
        sobretitulo={t.homeHeroKicker}
        titulo={t.homeHeroTitle}
        nivel={1}
      >
        <Botao href={routes.associates[lang]} variante="destaque" tamanho="lg">
          {t.homeHeroAction}
        </Botao>
      </Hero>
    </Container>
  </Secao>

  <Secao id="associacao" espacoTopo="nenhum" espacoBase="sm">
    <Container>
      <ChamadaAcao fundo="clara">
        <Grade colunas={2} piso={1} espaco="md" alinhamento="centro">
          <div class="texto">
            <Titulo nivel={2} papel="secao" peso="medio">{t.homeAssociationTitle}</Titulo>
            <LinkAcao href={routes.resortsBrasil[lang]}>{t.homeAssociationAction}</LinkAcao>
          </div>

          <Imagem
            src="/images/hero/pexels-57021.jpg"
            alt={t.homeAssociationPhotoAlt}
            escala="largura-total"
            tamanhos={tamanhosFoto}
            arredondada
          />
        </Grade>
      </ChamadaAcao>
    </Container>
  </Secao>

  <DestaquesHome lang={lang} />

  <FaixaAssociados lang={lang} />

  <FaixaParceiros lang={lang} comHashtag colunas={5} />
</LayoutSistema>

<style>
  /* MEDIDO: 16px entre o titulo e o link, dentro do bloco da associacao. */
  .texto :global(h2) {
    margin-bottom: 1rem;
  }
</style>
