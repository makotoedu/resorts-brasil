---
import ListaEstudos from '../../components/ListaEstudos.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es-es"
  route="statistics"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-9 center text-center">
                    <h1 class="text-md h2">Estadísticas y Estudios</h1>
                    <h3>Confiera abajo los últimos estudios del sector de resorts, elaborados por Resorts Brasil o
                        por colaboradores.</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Estatisticas e Estudos -->
    <section id="estatisticas-e-estudos" class="no-padding">
        <div class="container">
            <div class="row">
                <div class="col-lg-12 center">
                    <div class="grid-layout post-4-columns m-b-30" data-item="post-item">
                        <ListaEstudos lang="es-es" />
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Estatisticas e Estudos -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">¿Quiere formar parte de un grupo selecto de resorts brasileños?</h3>
                <p>Forme parte y ayude a transformar el sector. 😍</p>
                <div>
                    <a href="/es-es/asociese" class="btn">Asóciese</a>
                    <a href="/es-es/asociados" class="btn btn-outline">Conozca los asociados</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
