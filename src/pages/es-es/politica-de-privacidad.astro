---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Texto from '../../components/primitivos/Texto.astro';
import Prosa from '../../components/padroes/Prosa.astro';
import ListaIcones from '../../components/padroes/ListaIcones.astro';
import SecaoCookies from '../../components/SecaoCookies.astro';
import { juridico, dataEm } from '../../data/juridico';
import { contato } from '../../data/contato';
import { ui, type Locale } from '../../i18n/ui';

/* As correcoes estao anotadas em src/pages/politica-de-privacidade.astro, que e
   a versao de referencia. */
const lang: Locale = 'es-es';
const t = ui[lang];

const atualizacao = `${t.legalUpdated} ${dataEm(juridico.privacidade.atualizadoEm, lang)}`;

const fontesDeColeta = [
  'Cuando usted se asocia a Resorts. En este caso vamos a colectar los datos personales (Nombre, función, e-mail, celular/WhatsApp) de las personas físicas responsables por cada una de las redes hoteleras asociadas, bien como del contacto responsable por el área de actuación.',
  'Por el área de asociado localizada en nuestra página web (nombre de la página web). Por esta área, que se accede con seña y contraseñas propias y específicas, podemos colectar los siguientes datos (¿qué datos son colectados?).',
  'Cuando usted entra en contacto con nosotros activamente por medio de nuestros servicios de atendimiento, sea por teléfono, e-mail, nuestra página / sitio o presencialmente con interés de recibir las informaciones estratégicas del sector de turismo y/o tener interés en asociarse.',
  'De forma automática o por medio de cookies algunos datos relativos a su navegación y al dispositivo que usted usa para iniciar la sesión en nuestra página web.',
  'Al comunicarnos con usted a través de e-mail u otros mensajes instantáneos.',
  'Para captar nuevos negocios y/o asociados al Resorts.',
  'Por medio de informaciones para publicaciones de algún material y/o contenido relacionado al Turismo, desarrollado por usted o que sea para de la autoría o entrevistas realizadas, para difusión en canales de comunicación, como nuestra página web o redes sociales (Facebook, Instagram y LinkedIn).',
  'Cuando se torne uno de nuestros colaboradores o cuando esté participando de nuestro proceso de selección y reclutamiento.',
  'Cuando usted actúa como proveedor, colaborador Institucional y/o Educacional o conferenciante y asociado, para poder ejecutar el contrato y gestionar el relacionamiento con el proveedor.',
  'Cuando usted tenga interés en realizar algún Evento, presencial u online con nosotros. Los datos se recogen mediante un formulario que usted mismo rellena para inscribirse en el evento.',
  'Cuando participe en cualquier Evento, feria, congreso, taller o cualquier otra acción promocional, institucional o comercial en la que Resorts también participe u organice, en la que exista interacción entre usted y Resorts.',
];

const dadosColetados = [
  'Informaciones personales de contacto: Cualquier información que usted proporcione a Resorts y que sea posible contactarlo, como por ejemplo, su nombre completo, función, e-mail y teléfono (WhatsApp).',
  'Informaciones personales para fin de interés en tornarse un asociado o participar de un evento: Cualquier información que usted proporcione a Resorts para fin de negociaciones para tornarse un asociado y/o ejecución de un contrato, tales como (i) nombre completo; (ii)función; (iii) e-mail; (iv) documento de identidad (v) CI, (vi) dirección, (vii) teléfono/celular.',
  'Informaciones técnicas sobre el ordenador / la computadora /dispositivo móvil: Cualquier información sobre sistema del ordenador / la computadora u otro dispositivo que usted utilice para el acceso a nuestro sitio, como la dirección de IP, el tipo de sistema operacional y el tipo y versión del navegador de la web. Si accede al sitio usando un dispositivo móvil, como un Smartphone, las informaciones colectadas también incluirán, siempre que permitido, el ID del dispositivo exclusivo de su teléfono, el ID de publicidad, la localización geográfica y otros datos similares del dispositivo móvil.',
  'Informaciones de utilización de sitios/comunicación: A medida que navega e interactúa en nuestro sitio podemos utilizar tecnologías de colecta automática de datos para recoger determinadas informaciones sobre sus acciones. Eso incluye informaciones, como, en qué links usted pincha, cuáles páginas o contenidos usted visualiza y por cuánto tiempo y otras informaciones y estadísticas semejante sobre interacciones, como por ejemplo, tiempo de respuesta a contenido, errores de descarga y duración de las visitas a determinadas páginas. Esas informaciones son capturadas por medio de tecnologías automatizadas, como Cookies.',
  'Datos Personales Sensibles: Resorts siempre busca tratar lo mínimo posible de Datos Personales Sensibles. Cuando sea necesario tratar sus Datos Personales Sensibles, le informaremos la finalidad pretendida e iremos a obtener su previo y expreso consentimiento, si la legislación específica así expresamente lo determina.',
];

const finalidades = [
  'Atendimiento a los posibles Asociados y/o Proveedores: Usamos sus Datos Personales para realizar los análisis y negociaciones iniciales de los posibles asociados y/o proveedores y para ejecutar un contrato que firmamos con usted o con su empresa.',
  `Comunicaciones direccionadas: Resorts utiliza sus Datos Personales para proporcionar informaciones sobre los servicios (comunicaciones de marketing, informaciones estratégicas sobre turismo, negociaciones colectivas, programas de pasantía, benchmarking, workshops, Ferias y/o Eventos). Eso se puede hacer a través de e-mail marketing encaminado directamente por nosotros por medio de las redes sociales (Facebook, Instagram y LinkedIn) en la medida en que permitidas por la ley aplicable. El uso de sus Datos Personales no es obligatorio, o sea, usted puede oponerse a cualquier momento siguiendo las instrucciones contenidas en los respectivos mensajes o entrando en contacto con nosotros escribiendo para ${contato.email} y, así, interrumpiremos el tratamiento de sus datos para estas finalidades.`,
  'Ejecución de contrato - Resorts utiliza sus datos personales para fines de ejecución de algún contrato que usted o su empresa formalice con nosotros.',
];

const compartilhamento = [
  '(i) Proveedores, colaboradores y prestadores de servicios. Contamos con la ayuda a de proveedores que pueden tratar datos personales que colectamos, tales como con empresas prestadoras de servicios, empresas de procesamiento de datos, bufetes de abogados y contabilidad, organizadores de eventos, entre otros prestadores que, en nuestro nombre nos ayude a lanzar y/u ofrecer nuestros servicios y/o nos ayuden a ejecutar alguna obligación legal a nuestro favor. Esas empresas pueden precisar de informaciones a su respecto para poder desempeñar sus funciones y no tiene autorización para usar los Datos Personales que compartimos con ellas para cualquier otro propósito sino aquellos definidos por nosotros y específicamente en esa Política.',
  '(ii) Los datos personales por usted proporcionados también podrán ser compartidos por Resorts con sus asociados, siempre que dicha compartición sea necesaria para posibilitar la prestación de servicios, ofrecer productos, promociones o beneficios, para mejorar su experiencia.',
  '(iiI) También divulgaremos sus Datos Personales a terceros: (i) Cuando requerido por la ley aplicable; (ii) en respuesta a procedimientos legales; (iii) en respuesta a un pedido de la autoridad legal competente; (iv) para proteger nuestros derechos, privacidad, seguridad o propiedad o (v) para hacer cumplir los términos de cualquier acuerdo o los términos de nuestro sitio.',
  '(iv) Además de eso, sus Datos Personales podrán ser utilizados para atender obligaciones dispuesta en la ley, reglamentaciones de órganos gubernamentales, autoridades fiscales, Poder Judicial, como sentencias y acuerdos y/o cualquier otra autoridad competente. Este tratamiento podrá incluir sus datos de identificación y documentos personales.',
  '(v) Para otros fines, cuando exigido por las leyes y reglamentos aplicables.',
];
---

<LayoutSistema lang={lang} route="privacy">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="estreita">
      <Titulo nivel={1} tamanho="3xl" peso="medio" alinhamento="centro">{t.privacyTitle}</Titulo>
      <Texto tamanho="xs" alinhamento="centro">{atualizacao}</Texto>
    </Container>
  </Secao>

  <Secao id="politica-de-privacidad">
    <Container largura="estreita">
      <Prosa>
        <Texto tamanho="lg" cor="padrao">
          Nosotros de la ASOCIACIÓN BRASILEÑA DE RESORTS (“RESORTS BRASIL” o “Resorts”) creamos esa
          Política de Privacidad y Protección de Datos Personales (“Política”) para reafirmar el
          compromiso que tenemos con nuestros asociados y todos aquellos que interactúan con
          nosotros, a fin de dar mayor transparencia sobre como realizamos el tratamiento de datos
          personales.
        </Texto>
        <p>
          Esta Política describe como colectamos, almacenamos y utilizamos sus Datos Personales, de
          conformidad con las leyes aplicables, en especial la Ley n.º 13.709/2018 (“Ley General de
          Protección de Datos Personales”), así como detallamos, como usted podrá acceder y
          actualizar sus datos personales bien como ejercer sus derechos.
        </p>
        <p>
          Recomendamos que esta Política sea leída con atención, especialmente antes de iniciar su
          relacionamiento con nosotros. Caso tenga alguna duda sobre el contenido de esta Política,
          contáctenos a través del e-mail: <a href={`mailto:${contato.email}`}>{contato.email}</a>
        </p>

        <Titulo nivel={2} tamanho="lg">
          Informaciones que usted precisa saber antes de leer esta Política
        </Titulo>
        <p>
          <strong>Anonimato:</strong> proceso en que retira la personalización del dato y la
          vinculación entre usted y la información dada.
        </p>
        <p>
          <strong>Autoridad Nacional de Protección de Datos:</strong> órgano de Gobierno responsable
          por velar y fiscalizar el cumplimiento de la Ley General de Protección de Datos Personales
          (LGPD).
        </p>
        <p>
          <strong>Bases legales:</strong> son las hipótesis legales que nos autorizan a tratar sus
          datos personales. Puede ser su consentimiento, la necesidad de cumplir un contrato que
          tenemos con usted, o el cumplimiento de una obligación legal, por ejemplo.
        </p>
        <p>
          <strong>Cookies:</strong> archivos enviados por nuestro servidor para el ordenador o
          computadora, celular, Tablet o cualquier otro dispositivo utilizado por Usted y
          responsables por colectar los datos de acceso a Nuestros Ambientes, personalizando su
          navegación.
        </p>
        <p>
          <strong>Datos Personales:</strong> son todas las informaciones que permiten su
          identificación. Ejemplo: nombre completo, dirección, e-mail, teléfono, documentos de
          identidad.
        </p>
        <p>
          <strong>Datos Personales Sensibles:</strong> son datos personales relacionados al origen
          racial o étnico, convicción religiosa, opinión política, afiliación a sindicato o a
          organización de carácter religioso, filosófico o político, dato referente a la salud o vida
          sexual, dato genético o biométrico, cuando vinculados al individuo.
        </p>
        <p>
          <strong>Tratamiento de Datos Personales:</strong> significa cualquier actividad, como
          colecta, almacenamiento, procesamiento, recepción, acceso, transmisión, distribución,
          reproducción, archivamiento, utilización, modificación, comunicación, transferencia,
          compartición realizada con sus datos personales.
        </p>
        <p>
          <strong>Titular de los datos:</strong> Es usted, la persona física, a quien los datos
          personales se refieren. Sea en la condición de asociado, colaborador, colaboradores,
          proveedores o conferenciante, bien como cualquier tercero persona física que interactúe con
          nosotros.
        </p>

        <Titulo nivel={2} tamanho="lg">¿Cómo colectamos sus datos personales?</Titulo>
        <p>
          Con el intuito de establecer una relación de confianza y transparencia, usted debe conocer
          las fuentes a través de las cuales colectamos informaciones. La manera que usted interactúa
          con nosotros (online, offline o por cualquier otra forma), va a interferir en la colecta de
          sus datos. Podemos colectar sus datos personales por intermedio de las siguientes fuentes,
          a saber:
        </p>
        <ListaIcones marcador="seta" cor="paragrafo" itens={fontesDeColeta} />

        <Titulo nivel={2} tamanho="lg">¿Cómo y cuáles datos personales colectamos?</Titulo>
        <ListaIcones marcador="seta" cor="paragrafo" itens={dadosColetados} />

        <Titulo nivel={2} tamanho="lg">¿Para cuáles finalidades utilizamos sus datos personales?</Titulo>
        <p>
          Resorts trata sus Datos Personales principalmente, para viabilizar nuestra relación
          institucional, cumplir algunas obligaciones contractuales y legales. Además de eso, podemos
          utilizar sus datos personales para las siguientes finalidades:
        </p>
        <ListaIcones marcador="seta" cor="paragrafo" itens={finalidades} />

        <Titulo nivel={2} tamanho="lg">
          Para tratar sus datos nosotros utilizamos las siguientes bases legales:
        </Titulo>
        <p>
          <strong>Ejecución de Contrato</strong><br />Podemos utilizar la ejecución de contrato
          cuando precisemos celebrar cualquier contrato de prestación de servicios, colaboración, de
          asociación entre otros, o para tomar medidas preliminares antes de celebrarlo. Caso Usted
          no quiera proporcionar sus datos, visto que proporcionar los datos personales solicitados
          es opcional, no seremos capaces de gerenciar nuestra relación contractual con usted.
        </p>
        <p>
          <strong>Obligación Legal</strong><br />Existen algunos casos que somos obligados a colectar
          sus datos personales, por ejemplo: para cumplimento de obligaciones contables, fiscales,
          financieras y regulatorias.
        </p>
        <p>
          <strong>Intereses Legítimos</strong><br />Podemos colectar sus datos personales pues
          tenemos intereses legítimos en hacerlo y cuando esos intereses no hieran los principios de
          ley y, también, caso no invaliden sus derechos respecto a privacidad y protección de datos.
          Los intereses legítimos pueden ser para mejorar nuestros servicios con el objetivo
          principal de aumentar la satisfacción de nuestros asociados o, aún, para adecuar nuestros
          servicios a sus preferencias y necesidades específicas.<br />Caso Usted ya sea nuestro
          asociado, podemos enviarle material de marketing digital sobre servicios relacionados y
          confiamos en nuestro legítimo interés en hacerlo. Si Usted no quiere recibir nuestros
          materiales, le damos la posibilidad de darse de baja, siguiendo las instrucciones de
          cancelación de inscripción definidas en el mensaje de marketing recibido.<br />También
          procesamos sus datos con base en nuestros intereses legítimos en procesar su solicitación,
          cuando usted entra en contacto con Resorts, cuando usted rellena uno de nuestros
          formularios físicos o digitales y para la inscripción de Eventos presenciales, virtuales o
          Híbridos que sean realizados/organizados por Resorts.
        </p>

        <SecaoCookies lang={lang} />

        <Titulo nivel={2} tamanho="lg">¿Cómo compartimos sus datos personales?</Titulo>
        <p>
          No vendemos ni comercializamos informaciones que identifiquen a los individuos que
          interactúan con nosotros. Tampoco compartimos o transferimos de cualquier forma sus
          informaciones personales para terceros, excepto conforme indicado abajo:
        </p>
        <ListaIcones marcador="seta" cor="paragrafo" itens={compartilhamento} />
        <p>
          Si apropiado, antes de compartir los Datos Personales con un tercero, Resorts irá a exigir
          contractualmente que el tercero adopte las precauciones necesarias para proteger esos Datos
          Personales contra el uso no autorizado o que se compartan.
        </p>

        <Titulo nivel={2} tamanho="lg">
          ¿Sus Datos Personales pueden ser transferidos internacionalmente?
        </Titulo>
        <p>
          Sí. Sus Datos Personales pueden ser transferidos con el objetivo de atender las finalidades
          previstas en esta Política, visto que algunos de nuestros proveedores de servicios de
          almacenamientos de datos en una nube pueden estar localizados fuera de Brasil.
        </p>
        <p>
          Es importante destacar que se aplican las leyes brasileñas relacionadas a la protección de
          Datos Personales, una vez que Resorts tiene sede en Brasil y nuestros servicios son
          destinados a personas localizadas en Brasil.
        </p>
        <p>
          La transferencia de datos personales envuelve apenas empresas que demuestren estar de
          acuerdo con las leyes aplicables, y mantengan un nivel de compliance semejante o inclusive
          más riguroso que el previsto en legislación brasileña aplicable.
        </p>

        <Titulo nivel={2} tamanho="lg">
          ¿Durante cuánto tiempo sus datos personales son almacenados?
        </Titulo>
        <p>
          Guardamos sus datos personales durante el periodo necesario o cuando, por motivos legales,
          seamos obligados. Caso contrario, iremos excluirlos de nuestras bases o tornarlos anónimos
          para que con el tratamiento de ellos no sea más posible identificarlo a usted.
        </p>

        <Titulo nivel={2} tamanho="lg">¿Cómo garantizamos la seguridad de sus datos personales?</Titulo>
        <p>
          La seguridad de sus datos personales es una de nuestras principales preocupaciones. Para
          protegerlos, utilizamos medidas técnicas y organizacionales de seguridad de la información
          visando la confidencialidad y la protección de todos los datos colectados o generados en
          Nuestros Ambientes. Entretanto, estas protecciones no se aplican a informaciones que usted
          haya elegido compartir en áreas públicas, como redes sociales de terceros.
        </p>
        <p>
          La transmisión de información por internet, infelizmente, no es completamente segura y, a
          pesar de hacer lo mejor para proteger sus Datos Personales, no podemos garantizar la
          seguridad de datos durante transmisión por nuestro sitio, especialmente contra-ataques
          perpetrados por personas mal-intencionadas, que pueden ser altamente sofisticados e
          innovadores, con técnicas y métodos desconocidos inclusive por las mejores herramientas de
          seguridad de la información.
        </p>
        <p>
          La seguridad de sus datos también depende de adoptar por usted medidas razonables en el uso
          de sus dispositivos y de softwares. Caso usted identifique o sepa algo que pueda comprometer
          la seguridad de sus datos personales, o de alguna posible vulnerabilidad en nuestro sitio o
          sistemas, por favor, contáctenos de inmediato.
        </p>

        <Titulo nivel={2} tamanho="lg">¿Cuáles son sus derechos?</Titulo>
        <p>
          La Ley General de Protección de Datos Personales concede a Usted determinados derechos en
          lo que se refiere al tratamiento de sus datos personales. Son ellos:
        </p>
        <p>
          <strong>Acceso:</strong> El derecho de ser informado y tener acceso a sus datos personales
          bajo nuestro tratamiento;
        </p>
        <p>
          <strong>Corrección:</strong> Derecho de solicitar la actualización o alteración de sus
          datos personales desactualizados, incompletos o incorrectos;
        </p>
        <p>
          <strong>Portabilidad:</strong> Derecho de solicitar que datos personales bajo nuestro
          tratamiento sean transferidos a otro prestador de servicio indicado por usted;
        </p>
        <p>
          <strong>Eliminación:</strong> Derecho de tener sus datos personales eliminados de nuestras
          bases de datos, sujetas a las hipótesis jurídicas de almacenamiento;
        </p>
        <p>
          <strong>Anonimato o bloqueo:</strong> Derecho de solicitar que los datos personales
          excesivos al tratamiento sean sometidos al anonimato o que este tratamiento excesivo sea
          suspendido por nosotros;
        </p>
        <p>
          <strong>Revocación:</strong> Derecho de revocar su consentimiento para las finalidades de
          tratamiento de los datos personales a él vinculados;
        </p>
        <p>
          <strong>Información sobre las consecuencias de revocación:</strong> Derecho de ser
          informado sobre los desdoblamientos da la relación con nosotros y ejecución de determinada
          finalidad de tratamiento caso usted desee revocar su consentimiento;
        </p>
        <p>
          <strong>Oposición:</strong> Derecho de que usted se oponga al tratamiento de datos
          personales que estén desalineados a las determinaciones de la Ley General de Protección de
          Datos Personales.
        </p>
        <p>
          Existen circunstancias que pueden restringir el ejercicio de algunos derechos previstos en
          ley, como por ejemplo, cuando se dan informaciones que puedan revelar algún secreto de
          negocio o en razón de cumplimiento de alguna obligación legal/regulatoria o para permitir
          nuestra defensa en algún proceso judicial o administrativo. Usted podrá ejercer tales
          derechos contactándonos a través del e-mail
          <a href={`mailto:${contato.email}`}>{contato.email}</a>
        </p>
        <p>
          Atenderemos sus solicitaciones dentro de un plazo razonable, de acuerdo con la legislación
          aplicable, recordando que solamente podremos responder algunas solicitaciones después que
          recibamos las confirmaciones prevista arriba.
        </p>

        <Titulo nivel={2} tamanho="lg">Página Web de terceros</Titulo>
        <p>
          Nuestra página web puede poner a disposición links para páginas web de terceros, pero que
          tienen sus propias políticas de privacidad, que pueden no ser compatibles con esta
          Política. Recomendamos que usted consulte las respectivas políticas de privacidad de esos
          terceros para informarse sobre las prácticas de protección de datos personales adoptadas
          por ellos.
        </p>
        <p>
          Resorts Brasil no se responsabiliza por la regularidad de las prácticas de protección de
          datos de las páginas web de terceros, ni por su contenido, que no es de cualquier forma
          validado, ratificado o subscrito por nosotros.
        </p>

        <Titulo nivel={2} tamanho="lg">Alteraciones de esta política</Titulo>
        <p>
          Estamos siempre buscando ofrecerles servicios con la mayor eficiencia posible,
          actualizándonos constantemente para esto. Por ese motivo, esta Política podrá sufrir
          ajustes a cualquier momento, cabiéndole a Usted verificarla siempre que sea posible a
          través de esta dirección electrónica.
        </p>

        <Titulo nivel={2} tamanho="lg">Ley aplicable y jurisdicción</Titulo>
        <p>
          En caso de cualquier controversia o diligencia relacionada a la interpretación, validad,
          celebración o conformidad de esta Política ella será resuelta teniendo en consideración la
          legislación brasileña y la jurisdicción del lugar de la sede de la empresa.
        </p>

        <Titulo nivel={2} tamanho="lg">¿Cómo usted puede contactarnos?</Titulo>
        <p>
          En caso de cualquier duda con relación a esta Política o solicitaciones para el
          cumplimiento de sus derechos. Usted o su representante legal podrá contactarnos
          directamente a través de nuestro canal oficial de comunicación con el titular de datos por
          e-mail <a href={`mailto:${contato.email}`}>{contato.email}</a>
        </p>
      </Prosa>
    </Container>
  </Secao>
</LayoutSistema>
