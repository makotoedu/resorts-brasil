---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="es-es"
  title={'Publicaciones - Resorts Brasil'}
  description={'Asociación Brasileña de Resorts'}
  route="publications"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Publicaciones</h1>
                    <h3>Una de nuestras misiones es generar información relevante para el mercado.<br>
                        Confiera abajo nuestras últimas publicaciones:</h3>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Publicacoes -->
    <section id="publicacoes" class="no-padding">
        <div class="container">
            <div class="grid-layout post-5-columns m-b-30" data-item="post-item" data-margin="30">
                <!-- Cartilha ESG -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/cartilha-esg-resorts-brasil.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Cartilla ESG Resorts Brasil</h2>
                            <p>Direccionamientos para implementación de buenas prácticas en el sector</p>
                            <a href="https://drive.google.com/file/d/1DGEOHuJVlPhR7b4iSVQCZDqpviZSeu3c/view"
                                target="_blank" class="item-link">Lea ahora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Cartilha ESG -->
                <!-- Ebook -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/a-gestao-da-jornada-do-viajante.jpg">
                            </a>
                            <span class="post-meta-category">2022</span>
                        </div>
                        <div class="post-item-description">
                            <h2>La Gestión de la Jornada del Viajero</h2>
                            <p>Nuevo contexto, transformaciones en los negocios y soluciones digitales...
                            </p>
                            <a href="https://drive.google.com/file/d/1xrhzqxzn4P5vkLH-q1PKkk9ljiDS-Tjc/view"
                                target="_blank" class="item-link">Lea ahora
                                <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Ebook-->
                <!-- Memórias -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank">
                                <img alt="capa"
                                    src="/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg">
                            </a>
                            <span class="post-meta-category">2021</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Memorias, sustentabilidad Y una marida hacia el futuro</h2>
                            <p>Veinte años atrás, se inició un movimiento de unión...</p>
                            <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                                target="_blank" class="item-link">Lea ahora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Memórias -->
                <!-- Guia do viajante -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank">
                                <img alt="capa" src="/images/publicacoes/guia-do-viajante-responsavel.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Guía del viajero responsable</h2>
                            <p>El viaje seguro depende de todos nosotros. Movimiento Supera Turismo Brasil.
                            </p>
                            <a href="https://drive.google.com/file/d/1ypL8zoFP8NExwSGdi8tz77XGgYyZy00b/view"
                                target="_blank" class="item-link">Lea ahora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Guia do viajante -->
                <!-- Protocolos -->
                <div class="post-item border">
                    <div class="post-item-wrap rounded">
                        <div class="post-image">
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank">
                                <img alt="capa"
                                    src="/images/publicacoes/protocolos-de-higiene-e-seguranca-meios-de-hospedagem.jpg">
                            </a>
                            <span class="post-meta-category">2020</span>
                        </div>
                        <div class="post-item-description">
                            <h2>Protocolos de higiene y seguridad en medios de hospedaje</h2>
                            <p>Las premisas abajo presentadas fueron...</p>
                            <a href="https://drive.google.com/file/d/1yX9MSMxMl9PHU74Pqg5qzIfyVFzB7BIv/view"
                                target="_blank" class="item-link">Lea ahora <i class="icon-chevron-right"></i></a>
                        </div>
                    </div>
                </div>
                <!-- end: Protocolos -->
            </div>
        </div>
    </section>
    <!-- end: Publicacoes -->

    <!-- CTA -->
    <section id="cta" class="p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">¿Quiere formar parte de un grupo selecto de resorts brasileños?</h3>
                <p>Forme parte y ayude a transformar el sector. 😍</p>
                <div>
                    <a href="/es-es/asociese" class="btn">Asóciese</a>
                    <a href="/es-es/asociados" class="btn btn-outline">Conozca los asociados</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
