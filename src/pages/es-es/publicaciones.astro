---
import LayoutSistema from '../../layouts/LayoutSistema.astro';
import Secao from '../../components/layout/Secao.astro';
import Container from '../../components/layout/Container.astro';
import Grade from '../../components/layout/Grade.astro';
import Titulo from '../../components/primitivos/Titulo.astro';
import Texto from '../../components/primitivos/Texto.astro';
import CartaoPublicacao from '../../components/padroes/CartaoPublicacao.astro';
import ConviteAssociese from '../../components/ConviteAssociese.astro';
import { publicacoesEm } from '../../conteudo';
import { ui, type Locale } from '../../i18n/ui';

/* As correcoes desta pagina estao anotadas em src/pages/publicacoes.astro, que
   e a versao de referencia. */
const lang: Locale = 'es-es';
const t = ui[lang];
const publicacoes = await publicacoesEm(lang);

const tamanhosCapa = '(min-width: 64rem) 18rem, (min-width: 30rem) 32vw, 92vw';
---

<LayoutSistema lang={lang} route="publications">
  <Secao id="titulo" espacoBase="nenhum">
    <Container largura="media">
      <Titulo nivel={1} tamanho="3xl" peso="medio" alinhamento="centro">{t.publicationsTitle}</Titulo>
      <Texto tamanho="lg" alinhamento="centro">{t.publicationsLead}</Texto>
    </Container>
  </Secao>

  <Secao id="publicaciones">
    <Container>
      <Grade colunas={5} piso={1} espaco="md">
        {
          publicacoes.map((p) => (
            <CartaoPublicacao
              titulo={p.titulo}
              resumo={p.resumo}
              capa={p.capa}
              etiqueta={String(p.ano)}
              href={p.url}
              rotuloLink={t.leiaAgora}
              nivel={2}
              tamanhos={tamanhosCapa}
            />
          ))
        }
      </Grade>
    </Container>
  </Secao>

  <ConviteAssociese lang={lang} />
</LayoutSistema>
