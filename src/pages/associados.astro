---
import AssociadosTabs from '../components/AssociadosTabs.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  route="associates"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row m-b-30">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">Resorts Associados</h1>
                    <h3>Representamos os grandes resorts do país, que passam por um criterioso processo de afiliação
                        e análise conforme a matriz de classificação da associação.</h3>
                </div>
            </div>
            <!-- Stats -->
            <div class="row justify-content-md-center">
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-refresh-interval="50" data-to="83" data-from="1"></span>
                        </div>
                        <p>Resorts Associados</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-suffix=" mil" data-speed="500" data-refresh-interval="50" data-to="21"
                                data-from="1"></span>
                        </div>
                        <p>Quartos</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-suffix=" mil" data-speed="500" data-refresh-interval="50" data-to="20"
                                data-from="1"></span>
                        </div>
                        <p>Empregos Diretos</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-refresh-interval="50" data-to="16" data-from="1"></span>
                        </div>
                        <p>Estados</p>
                    </div>
                </div>
                <div class="col-md-2 m-b-20">
                    <div class="text-center">
                        <div class="counter display-4 d-block text-dark mb-0">
                            <span data-speed="500" data-to="5" data-from="1"></span>
                        </div>
                        <p>Regiões do Brasil</p>
                    </div>
                </div>
            </div>
            <!-- end: Stats -->
        </div>
    </section>
    <!-- end: Título -->

    <!-- Mapa -->
    <section id="mapa" class="no-padding">
        <div class="container">
            <div class="row">
                <div class="heading-text heading-line text-center m-b-40">
                    <h4>Conheça nossos associados:</h4>
                </div>
                <div class="col-lg-10 center text-center">
                    <img class="img-fluid" src="/images/ilustracao/mapa.png" alt="mapa">
                </div>
            </div>
        </div>
    </section>
    <!-- end: Mapa -->

    <!-- Associados -->
    <section id="associados">
        <div class="container">
            <div class="row">
                <div class="tabs">
                    <AssociadosTabs lang="pt-br" />
                </div>
            </div>
    </section>
    <!-- end: Associados -->

    <!-- CTA -->
    <section id="cta" class="p-t-150 p-b-150">
        <div class="container">
            <div class="row text-center">
                <h3 class="m-b-0">Quer fazer parte de um grupo seleto de resorts brasileiros?</h3>
                <p>Faça parte e ajude a transformar o setor. 😍</p>
                <div>
                    <a href="/associe-se" class="btn btn-lg">Associe-se</a>
                </div>
            </div>
        </div>
    </section>
    <!-- end: CTA -->
</BaseLayout>
