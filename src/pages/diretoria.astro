---
import GradeMembros from '../components/GradeMembros.astro';
import { diretoria, conselhoConsultivo } from '../data/diretoria';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  route="board"
>
    <!-- Diretoria -->
    <section id="diretoria" class="p-b-0">
        <div class="container">
            <div class="row text-center">
                <h1 class="m-b-10 h2">Diretoria da Resorts Brasil</h1>
                <h4 class="text-muted">Biênio 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={diretoria} lang="pt-br" />
        </div>
    </section>
    <!-- end: Diretoria -->

    <!-- Conselho Consultivo -->
    <section id="conselho-consultivo">
        <div class="container">
            <div class="row text-center">
                <h2 class="m-b-10">Conselho Consultivo</h2>
                <h4 class="text-muted">Biênio 2026-2027</h4>
            </div>
            <div class="space"></div>
            <GradeMembros membros={conselhoConsultivo} lang="pt-br" />
        </div>
    </section>
    <!-- end: Conselho Consultivo -->
</BaseLayout>
