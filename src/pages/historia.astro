---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  lang="pt-br"
  title={'História - Resorts Brasil'}
  description={'Associação Brasileira de Resorts'}
  route="history"
>
    <!-- Título -->
    <section id="title">
        <div class="container">
            <div class="row">
                <div class="col-lg-10 center text-center">
                    <h1 class="text-md h2">História</h1>
                    <h3>A ideia da criação de uma entidade que representasse os interesses do setor começou no ano
                        de 2000 e tomou forma durante o Festival de Turismo de Gramado.</h3>
                    <p>Em dezembro de 2001, oficialmente, a Resorts Brasil foi fundada, fruto da
                        iniciativa de 12 empresas do setor.</h4>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Título -->

    <!-- Fundadores -->
    <section id="fundadores" class="p-t-0">
        <div class="container">
            <div class="row">
                <div class="col-lg-8 center">
                    <div class="row">
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Accor Sofitel</li>
                                <li>Blue Tree Park Angra dos Reis</li>
                                <li>Blue Tree Cabo de Santo Agostinho</li>
                                <li>Costão do Santinho Resort</li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Hotel do Frade</li>
                                <li>Mabu Hotéis & Resorts</li>
                                <li>Porto Bello</li>
                                <li>Pousada do Rio Quente</li>
                            </ul>
                        </div>
                        <div class="col-lg-4">
                            <ul class="list-icon list-icon-circle list-icon-colored">
                                <li>Club Hotel Salinas do Maragogi</li>
                                <li>Summerville Hotel</li>
                                <li>Superclubs</li>
                                <li>Tropical Manaus</li>
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <!-- end: Fundadores -->

    <!-- Publicacoes -->
    <section id="publicacoes" class="box-fancy section-fullwidth text-light no-padding">
        <div class="row">
            <div class="col-lg-8 text-center" style="background-color: #242F9B;">
                <p class="text-bold">20 ANOS</p>
                <h2 class="text-lg">Memórias, sustentabilidade e um olhar para o futuro</h2>
                <a class="btn btn-light btn-outline"
                    href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view"
                    target="_blank">Leia agora</a>
            </div>
            <div class="col-lg-4 text-center" style="background-color: #FAC213;">
                <a href="https://drive.google.com/file/d/1wbxXZPjaewuA0fq6Fsh79_Ztv8dbjhWe/view" target="_blank">
                    <img class="img-fluid rounded"
                        src="/images/publicacoes/memorias-sustentabilidade-e-um-olhar-para-o-futuro.jpg" alt="capa">
                </a>
            </div>
        </div>
    </section>
    <!-- end: Publicacoes -->
</BaseLayout>
